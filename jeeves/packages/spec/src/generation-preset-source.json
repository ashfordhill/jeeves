    "system": {
      "name": "YouTube",
      "description": "Creators upload videos that are transcoded for streaming; viewers find them by search, watch them at a bitrate that suits their connection and see how many times each was viewed."
    },
    "nodes": [],
    "relationships": []
  },
  "elements": [
    {
      "id": "watch",
      "name": "Watch API",
      "classification": {
        "kind": "Application"
      },
      "description": "Gives the player a video's details, playlist and view count, and records each view."
    },
    {
      "id": "metadata-cache",
      "name": "Metadata cache",
      "classification": {
        "kind": "Data store"
      },
      "description": "Videos' details by video ID, filled by the Watch API on a miss and kept an hour."
    },
    {
      "id": "metadata-db",
      "name": "Metadata database",
      "classification": {
        "kind": "Data store"
      },
      "description": "Private Video lifecycle, uploads, processing inbox and job/publication outbox. Watch reads only the ready-public view; runtime writer roles are explicit and owners are migration-only."
    },
    {
      "id": "view-counts",
      "name": "View counts",
      "classification": {
        "kind": "Data store"
      },
      "description": "Private receipt deduplication and immediate asynchronous transactional increments. Watch reads only public totals."
    },
    {
      "id": "view-events",
      "name": "View events",
      "classification": {
        "kind": "Data store"
      },
      "description": "Views, from the Watch API to the View counter, keyed by video."
    },
    {
      "id": "view-counter",
      "name": "View counter",
      "classification": {
        "kind": "Application"
      },
      "description": "Deduplicates each accepted played event and increments its video total in one transaction, without buffering."
    },
    {
      "id": "search",
      "name": "Search API",
      "classification": {
        "kind": "Application"
      },
      "description": "Finds videos by title, description and channel."
    },
    {
      "id": "search-index",
      "name": "Search index",
      "classification": {
        "kind": "Data store"
      },
      "description": "Playable videos by title, description and channel."
    },
    {
      "id": "video-cdn",
      "name": "Local video edge",
      "classification": {
        "kind": "External system"
      },
      "description": "Local reverse proxy/cache serving video segments, playlists and full-size thumbnails from Transcoded videos. This local substitute is not a globally distributed CDN; thumbnail resizing is disabled."
    },
    {
      "id": "transcoded",
      "name": "Transcoded videos",
      "classification": {
        "kind": "Data store"
      },
      "description": "Each video's segments at every resolution, its HLS playlists and its thumbnails."
    },
    {
      "id": "identity",
      "name": "Identity",
      "classification": {
        "kind": "Application"
      },
      "description": "Signs creators and viewers in and issues the tokens the services verify."
    },
    {
      "id": "upload",
      "name": "Upload API",
      "classification": {
        "kind": "Application"
      },
      "description": "Creator-authorized resumable uploads and private status. Video authority allocates lifecycle state and commits pending plus one processing-job outbox intent after verified object completion."
    },
    {
      "id": "originals",
      "name": "Original videos",
      "classification": {
        "kind": "Data store"
      },
      "description": "Each video as the creator uploaded it, kept to transcode again."
    },
    {
      "id": "upload-queue",
      "name": "Upload jobs",
      "classification": {
        "kind": "Data store"
      },
      "description": "Stable video/job/logical-attempt identities and private original fingerprint, committed with pending state through Upload outbox; no user text is trusted from worker results."
    },
    {
      "id": "transcoder",
      "name": "Transcoder",
      "classification": {
        "kind": "Application"
      },
      "description": "Media worker with no SQL credential. Checks the original fingerprint, runs a fixed CPU 360p/720p HLS ladder and thumbnail, then confirms started/succeeded/failed processing events."
    },
    {
      "id": "completion-events",
      "name": "Processing events",
      "classification": {
        "kind": "Data store"
      },
      "description": "Started, succeeded or failed results from Transcoder to Video lifecycle only; runtime processing-events. Results do not authorize search publication."
    },
    {
      "id": "completion-handler",
      "name": "Video lifecycle worker",
      "classification": {
        "kind": "Application"
      },
      "description": "Video authority consumes processing events, conditionally records lifecycle state and commits ready plus publication outbox together. Fixed deadlines fail overdue jobs; terminal states never reopen."
    },
    {
      "id": "search-indexer",
      "name": "Search indexer",
      "classification": {
        "kind": "Application"
      },
      "description": "Discovery projection consumes committed VideoPublished events and indexes ready-public videos with monotonic publication versions."
    },
    {
      "id": "publication-events",
      "name": "Publication events",
      "classification": {
        "kind": "Data store"
      },
      "description": "Committed ready-public VideoPublished projection, sent by lifecycle outbox after the owner transaction; runtime publication-events feeds only Search indexer."
    }
  ],
