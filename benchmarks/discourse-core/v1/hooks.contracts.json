          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "currentLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "replies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "approvals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "windowStart": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "windowEnd": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "override": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scopeId",
        "principalId",
        "policyVersion",
        "currentLevel",
        "reads",
        "replies",
        "approvals",
        "windowStart",
        "windowEnd",
        "override"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reasons": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["qualified", "inactive", "override"]
          }
        }
      },
      "required": ["level", "reasons"],
      "additionalProperties": false
    }
  },
