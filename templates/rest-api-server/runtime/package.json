{
  "name": "@jeeves/rest-server",
  "version": "0.1.0",
  "description": "Contract-first REST APIs for Jeeves http-service elements: routes from an OpenAPI 3.1 file, request and response validation, and /openapi.json.",
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@jeeves/service-runtime": "0.1.0",
    "fastify": "5.12.7"
  },
  "peerDependenciesMeta": {
    "@jeeves/service-runtime": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jeeves/service-runtime": "workspace:*",
    "fastify": "5.12.7"
  }
}
