{
  "name": "@jeeves/web-runtime",
  "version": "0.1.0",
  "description": "App shell for Jeeves web-app elements: runtime config injected at container start, an error boundary, a provider for generated API clients, and a status page.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts"
  },
  "files": [
    "dist",
    "nginx"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./vite": "./dist/vite.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  }
}
