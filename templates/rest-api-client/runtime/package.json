{
  "name": "@jeeves/rest-client",
  "version": "0.1.0",
  "description": "Typed REST clients for Jeeves elements: openapi-fetch with timeouts, retries, and request-ID propagation, plus types generated from the target's OpenAPI contract.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service.ts",
    "./codegen": "./src/codegen.ts"
  },
  "bin": {
    "jeeves-rest-client-types": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./service": "./dist/service.js",
      "./codegen": "./dist/codegen.js"
    },
    "bin": {
      "jeeves-rest-client-types": "./dist/cli.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "fastify": "5.12.7"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jeeves/service-runtime": "workspace:*",
    "fastify": "5.12.7"
  }
}
