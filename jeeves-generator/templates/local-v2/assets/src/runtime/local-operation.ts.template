/** Generated local replay boundary. Product definitions are registered before connections. */
import { createHash } from "node:crypto";
import { jsonBody, normalizedJsonDto } from "./hook-boundary.ts";
import {
  currentOperation,
  currentWorkload,
  assertOperation,
  withLocalPolicy,
  withEffect,
} from "./operation.ts";
import { transaction, type TransactionPool } from "./transaction.ts";
import { requestHash, checkIdempotencyKey } from "./idempotency.ts";
import type { SealingKeys } from "./keys.ts";
import { productMutation } from "./product-mutation.ts";
type ReplayRouteRequest = Readonly<{
  method: string;
  rawPath: string;
  headers: Readonly<Record<string, string | readonly string[] | undefined>>;
  body: unknown;
}>;

export interface LocalCommands {
  call(
    name: string,
    parameters: readonly unknown[],
  ): Promise<Readonly<{ rows: readonly unknown[]; rowCount: number }>>;
}
export interface LocalResult {
  readonly status: number;
  readonly body: unknown;
}
export interface LocalOperation<Input, Dependencies> {
  call(
    dependencies: Dependencies,
    request: Readonly<{ key: string; input: unknown }>,
  ): Promise<LocalResult>;
  route(
    dependencies: Dependencies,
    request: ReplayRouteRequest,
  ): Promise<LocalResult & { headers: Record<string, string> }>;
}
interface Definition<Input, Dependencies> {
  readonly database: keyof Dependencies & string;
  readonly id: string;
  readonly version: number;
  readonly retentionSeconds: number;
  readonly secret: boolean;
  validate(input: unknown, caller: Readonly<{ subject: string }>): Input;
  admit(
    input: Readonly<Input>,
    dependencies: Dependencies,
    caller: Readonly<{ subject: string }>,
  ): Promise<void>;
  mutate(
    input: Readonly<Input>,
    commands: LocalCommands,
    caller: Readonly<{ subject: string }>,
  ): Promise<LocalResult>;
}
const definitions = new WeakMap<
  object,
  Definition<unknown, Record<string, unknown>> & { workload: boolean }
>();
const bindings = new WeakMap<
  object,
  {
    operation: object;
    invoke(
      dependencies: unknown,
      request: { key: string; input: unknown },
      ticket?: string,
    ): Promise<LocalResult>;
    prepare(request: { key: string; input: unknown }): Promise<string>;
  }
>();
// Error fields have fixed value-free messages, shared by HTTP and callable paths.
export class LocalOperationError extends Error {
  readonly statusCode: number;
  readonly code: string;
  constructor(status: number, code: string) {
    super(code);
    this.name = "LocalOperationError";
    this.statusCode = status;
    this.code = code;
  }
}
function fail(status: number, code: string): never {
  throw new LocalOperationError(status, code);
}
export function defineLocalOperation<Input, Dependencies extends object>(
  definition: Definition<Input, Dependencies>,
): LocalOperation<Input, Dependencies> {
  return defineOperation(definition, false);
}
declare const workloadOperationBrand: unique symbol;
/** Opaque opt-in consumed by generated wiring only; no public invocation/ticket controls. */
export interface WorkloadOperation<Input, Dependencies> {
  readonly [workloadOperationBrand]: (input: Input, dependencies: Dependencies) => void;
}
export interface WorkloadCaller {
  readonly processId: string;
}
export function defineWorkloadOperation<Input, Dependencies extends object>(
  definition: Omit<Definition<Input, Dependencies>, "validate" | "admit" | "mutate"> & {
    validate(input: unknown, caller: WorkloadCaller): Input;
    admit(
      input: Readonly<Input>,
      dependencies: Dependencies,
      caller: WorkloadCaller,
    ): Promise<void>;
    mutate(
      input: Readonly<Input>,
      commands: LocalCommands,
      caller: WorkloadCaller,
    ): Promise<LocalResult>;
  },
): WorkloadOperation<Input, Dependencies> {
  if (
    !definition ||
    Object.getOwnPropertyNames(definition).some(
      (name) => !("value" in (Object.getOwnPropertyDescriptor(definition, name) ?? {})),
    )
  )
    throw new Error("Invalid workload operation declaration");
  const snapshot = Object.freeze({ ...definition });
  return defineOperation(
    {
      ...snapshot,
      validate: (input, caller) =>
        snapshot.validate(input, Object.freeze({ processId: caller.subject })),
      admit: (input, dependencies, caller) =>
        snapshot.admit(input, dependencies, Object.freeze({ processId: caller.subject })),
      mutate: (input, commands, caller) =>
        snapshot.mutate(input, commands, Object.freeze({ processId: caller.subject })),
    },
    true,
  );
}
function defineOperation<Input, Dependencies extends object>(
  definition: Definition<Input, Dependencies>,
  workload: false,
): LocalOperation<Input, Dependencies>;
function defineOperation<Input, Dependencies extends object>(
  definition: Definition<Input, Dependencies>,
  workload: true,
): WorkloadOperation<Input, Dependencies>;
function defineOperation<Input, Dependencies extends object>(
  definition: Definition<Input, Dependencies>,
  workload: boolean,
): LocalOperation<Input, Dependencies> | WorkloadOperation<Input, Dependencies> {
  if (
    !definition ||
    Object.keys(definition).sort().join() !==
      "admit,database,id,mutate,retentionSeconds,secret,validate,version" ||
    !/^[a-z][a-z0-9-]{0,63}$/.test(definition.id) ||
    typeof definition.database !== "string" ||
    !definition.database ||
    !Number.isSafeInteger(definition.version) ||
    definition.version < 1 ||
    definition.version > 1000000 ||
    !Number.isSafeInteger(definition.retentionSeconds) ||
    definition.retentionSeconds < 60 ||
    definition.retentionSeconds > 604800 ||
    typeof definition.secret !== "boolean" ||
    ![definition.validate, definition.admit, definition.mutate].every(
      (value) => typeof value === "function",
    )
  )
    throw new Error("Invalid local operation declaration");
  if (workload) {
    const descriptor = Object.freeze({}) as WorkloadOperation<Input, Dependencies>;
    definitions.set(
      descriptor,
      Object.freeze({ ...definition, workload: true }) as Definition<
        unknown,
        Record<string, unknown>
      > & { workload: boolean },
    );
    return descriptor;
  }
  const call = async (dependencies: Dependencies, request: { key: string; input: unknown }) => {
    assertOperation();
    const handle = Object.getOwnPropertyDescriptor(dependencies, definition.database)?.value;
    const bound = handle && bindings.get(handle);
    if (!bound || bound.operation !== operation) throw new Error("Unconfigured local operation");
    return bound.invoke(dependencies, request);
  };
  const operation = Object.freeze({
    call,
    async route(dependencies: Dependencies, request: ReplayRouteRequest) {
      if (request.rawPath !== "/") fail(404, "LOCAL_OPERATION_PATH");
      if (request.method !== "POST") fail(405, "LOCAL_OPERATION_METHOD");
      const key = request.headers["idempotency-key"];
      if (typeof key !== "string") fail(400, "IDEMPOTENCY_KEY_REQUIRED");
      return {
        ...(await call(dependencies, { key, input: request.body })),
        headers: { "Cache-Control": "no-store" },
      };
    },
  });
  definitions.set(
    operation,
    Object.freeze({ ...definition, workload }) as Definition<unknown, Record<string, unknown>> & {
      workload: boolean;
    },
  );
  return operation;
}
/** Private preconnection check; descriptors cannot be fabricated by structural typing. */
export function localOperationDefinition(operation: unknown, property: string, writable: boolean) {
  if (operation === undefined) return undefined;
  const definition =
    operation && typeof operation === "object" ? definitions.get(operation) : undefined;
  if (!definition) throw new Error("Invalid local operation declaration");
  if (definition.database !== property) return undefined;
  if (!writable) throw new Error("Local operation requires one writable database");
  return { operation: operation as object, definition };
}
const hash = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex");
/** The only bridge to SQL is a prepared RG07 command factory, on this reserved connection. */
export function bindLocalOperation(
  handle: object,
  prepared: NonNullable<ReturnType<typeof localOperationDefinition>>,
  options: {
    tile: string;
    module: string;
    productRole: string;
    pool: TransactionPool;
    keys?: SealingKeys;
    commands: (
      execute: (
        sql: string,
        values: unknown[],
        readOnly: boolean,
      ) => Promise<{ rows: unknown[]; rowCount: number | null }>,
    ) => LocalCommands;
  },
) {
  const { definition, operation } = prepared;
  if (definition.secret && !options.keys) throw new Error("Missing private replay keys");
  const namespace = JSON.stringify([options.tile, options.module, definition.id]);
  bindings.set(handle, {
    operation,
    async prepare(request) {
      const subject = currentWorkload();
      if (!definition.workload || !subject) fail(403, "WORKLOAD_OPERATION_REQUIRED");
      if (!request || typeof request.key !== "string" || !/^[\x21-\x7e]{1,255}$/.test(request.key))
        fail(400, "LOCAL_OPERATION_INPUT");
      const inputHash = hash({
        input: normalizedJsonDto(request.input) ?? null,
        present: request.input !== undefined,
      });
      return transaction(options.pool, async (tx) => {
        const values = [namespace, subject, request.key];
        await tx.query(
          "INSERT INTO jeeves.work_tickets(namespace,caller,work_key,input_hash,version,ticket,expires_at) VALUES($1,$2,$3,$4,$5,gen_random_uuid()::text,clock_timestamp()+$6::int*interval '1 second') ON CONFLICT DO NOTHING",
          [...values, inputHash, definition.version, definition.retentionSeconds],
        );
        const { rows } = await tx.query(
          "SELECT ticket,input_hash,version FROM jeeves.work_tickets WHERE namespace=$1 AND caller=$2 AND work_key=$3",
          values,
        );
        const row = rows[0];
        if (!row || row.input_hash !== inputHash || row.version !== definition.version)
          fail(409, "IDEMPOTENCY_CONFLICT");
        return row.ticket as string;
      });
    },
    async invoke(dependencies, request, ticket) {
      assertOperation();
      const subject = definition.workload ? currentWorkload() : currentOperation()?.caller.subject;
      if (!subject) fail(401, "SIGN_IN_REQUIRED");
      if (
        subject.includes("\u0000") ||
        [...subject].length > 255 ||
        Buffer.from(subject, "utf8").toString("utf8") !== subject
      )
        fail(400, "LOCAL_OPERATION_INPUT");
      if (
        !request ||
        Object.keys(request).sort().join() !== "input,key" ||
        !["input", "key"].every(
          (key) => "value" in (Object.getOwnPropertyDescriptor(request, key) ?? {}),
        )
      )
        fail(400, "LOCAL_OPERATION_INPUT");
      const caller = Object.freeze({ subject });
      let input: unknown;
      try {
        const rawInput = normalizedJsonDto(request.input);
        input = withLocalPolicy(() => {
          const checked = definition.validate(rawInput, caller);
          // Observe rejected async policies before refusing them, within the denied policy scope.
          if (
            checked instanceof Promise ||
            (checked !== null &&
              typeof checked === "object" &&
              typeof Object.getOwnPropertyDescriptor(checked, "then")?.value === "function")
          ) {
            void Promise.resolve(checked).catch(() => {});
            throw new Error("Local input policy must be synchronous");
          }
          return normalizedJsonDto(checked);
        });
      } catch {
        fail(400, "LOCAL_OPERATION_INPUT");
      }
      const identity = {
        tile: namespace,
        scope: { kind: definition.workload ? "workload" : "account", id: subject },
        key: request.key,
        hash: requestHash({
          method: "POST",
          route: `${namespace}@${definition.version}`,
          body: { present: input !== undefined, value: input ?? null },
        }),
      };
      try {
        checkIdempotencyKey(identity);
      } catch {
        fail(400, "LOCAL_OPERATION_INPUT");
      }
      // Check declared mutation authority without restricting the subsequent new-work read phase.
      withEffect("local-atomic-mutation", () => undefined);
      const values = [namespace, identity.scope.kind, subject, request.key];
      const binding = {
        scope: hash([identity.scope.kind, subject]),
        context: hash([...values, identity.hash]),
      };
      return transaction(options.pool, async (tx) => {
        const where = "tile = $1 AND scope_kind = $2 AND scope_id = $3 AND idem_key = $4";
        const recover = async (): Promise<LocalResult | undefined> => {
          const { rows } = await tx.query(
            `SELECT encode(request_hash, 'hex') AS hash, status, response, metadata, expires_at > clock_timestamp() AS valid FROM jeeves.idempotency_records WHERE ${where}`,
            values,
          );
          const row = rows[0];
          if (!row) return undefined;
          if (row.hash !== identity.hash) fail(409, "IDEMPOTENCY_CONFLICT");
          if (row.status === 0) fail(409, "IDEMPOTENCY_IN_PROGRESS");
          if (!row.valid) fail(410, "IDEMPOTENCY_EXPIRED");
          const metadata = row.metadata;
          if (
            !metadata ||
            metadata.codec !== 1 ||
            metadata.version !== definition.version ||
            metadata.secret !== definition.secret ||
            metadata.retentionSeconds !== definition.retentionSeconds ||
            row.status < 200 ||
            row.status > 299
          )
            fail(503, "REPLAY_UNAVAILABLE");
          let result: LocalResult;
          try {
            if (definition.secret) {
              const plain = options.keys!.open(row.response.sealed, binding);
              if (plain === undefined) fail(503, "REPLAY_UNAVAILABLE");
              result = JSON.parse(plain);
            } else result = { status: row.status, body: row.response };
            if (result.status !== row.status) fail(503, "REPLAY_UNAVAILABLE");
            const json = jsonBody(result.body ?? null)!;
            if (Buffer.byteLength(json) > 12288) fail(503, "REPLAY_UNAVAILABLE");
          } catch {
            fail(503, "REPLAY_UNAVAILABLE");
          }
          return normalizedJsonDto(result) as LocalResult;
        };
        const recovered = await recover();
        if (recovered) return recovered;
        const lock = await tx.query(
          "SELECT pg_try_advisory_xact_lock(hashtextextended($1, 0)) AS locked",
          [JSON.stringify(values)],
        );
        if (lock.rows[0]?.locked !== true) fail(409, "IDEMPOTENCY_IN_PROGRESS");
        const raced = await recover();
        if (raced) return raced;
        const requireTicket = async () => {
          if (definition.workload) {
            const valid = await tx.query(
              "SELECT ticket FROM jeeves.work_tickets WHERE namespace=$1 AND caller=$2 AND work_key=$3 AND ticket=$4 AND input_hash=$5 AND version=$6 AND expires_at>clock_timestamp() FOR UPDATE",
              [
                namespace,
                subject,
                request.key,
                ticket ?? "",
                hash({
                  input: normalizedJsonDto(request.input) ?? null,
                  present: request.input !== undefined,
                }),
                definition.version,
              ],
            );
            if (!valid.rows.length) fail(410, "WORK_TICKET_EXPIRED");
          }
        };
        await requireTicket();
        // New-work admission is deliberately after BOTH committed-replay checks.
        await withEffect("read", () =>
          definition.admit(
            input as Readonly<unknown>,
            dependencies as Record<string, unknown>,
            caller,
          ),
        );
        await tx.query(
          `INSERT INTO jeeves.idempotency_records (tile, scope_kind, scope_id, idem_key, request_hash, status, response, created_at, expires_at) VALUES ($1,$2,$3,$4,decode($5,'hex'),0,'{}',now(),now() + $6 * interval '1 second')`,
          [...values, identity.hash, definition.retentionSeconds],
        );
        await requireTicket(); // Admission may have awaited dependencies past the callee-owned deadline.
        const result = await productMutation(
          tx,
          options.productRole,
          options.commands,
          async (commands) => {
            const value = await definition.mutate(input as Readonly<unknown>, commands, caller);
            jsonBody(value);
            if (!value || Object.keys(value).sort().join() !== "body,status")
              throw new Error("Invalid local operation result");
            const json = jsonBody(value.body ?? null)!;
            if (
              !Number.isInteger(value.status) ||
              value.status < 200 ||
              value.status > 299 ||
              ([204, 205].includes(value.status) && json !== "null") ||
              Buffer.byteLength(json) > 12288
            )
              throw new Error("Invalid local operation result");
            return normalizedJsonDto({
              status: value.status,
              body: JSON.parse(json),
            }) as LocalResult;
          },
        );
        const response = definition.secret
          ? { sealed: options.keys!.seal(JSON.stringify(result), binding) }
          : result.body;
        await tx.query(
          `UPDATE jeeves.idempotency_records SET status = $5, response = $6::jsonb, metadata = $7::jsonb, expires_at = clock_timestamp() + $8 * interval '1 second' WHERE ${where}`,
          [
            ...values,
            result.status,
            JSON.stringify(response),
            JSON.stringify({
              codec: 1,
              version: definition.version,
              secret: definition.secret,
              retentionSeconds: definition.retentionSeconds,
            }),
            definition.retentionSeconds,
          ],
        );
        return result;
      });
    },
  });
}

export function validateLocalOperationBinding(
  operation: unknown,
  properties: readonly string[],
  authority: { workload: boolean; requiredUser: boolean } = {
    workload: false,
    requiredUser: false,
  },
): void {
  if (operation === undefined) return;
  const definition =
    operation && typeof operation === "object" ? definitions.get(operation) : undefined;
  if (!definition || !properties.includes(definition.database))
    throw new Error("Local operation requires one declared writable database on a route module");
  if (definition.workload && (!authority.workload || authority.requiredUser))
    throw new Error(
      "Workload operation requires an authenticated service caller and cannot bypass a Required user Auth guard",
    );
}

/** Generated same-process wiring uses the identical registered core, rather than a forged HTTP request. */
export function invokeLocalModule(
  operation: unknown,
  dependencies: unknown,
  request: unknown,
  legacy: () => Promise<unknown>,
): Promise<unknown> {
  if (operation === undefined) return legacy();
  if (!operation || typeof operation !== "object" || !definitions.has(operation))
    throw new Error("Invalid local operation declaration");
  if (definitions.get(operation)?.workload) fail(403, "WORKLOAD_OPERATION_REQUIRED");
  return (operation as LocalOperation<unknown, object>).call(
    dependencies as object,
    request as { key: string; input: unknown },
  );
}

/** Private generated route, independent of the product stub handler. No user impersonation. */
export async function invokeWorkProtocol(
  operation: unknown,
  dependencies: object,
  request: ReplayRouteRequest,
): Promise<LocalResult> {
  const definition =
    operation && typeof operation === "object" ? definitions.get(operation) : undefined;
  if (!definition?.workload || !currentWorkload()) fail(403, "WORKLOAD_OPERATION_REQUIRED");
  if (request.method !== "POST" || request.rawPath !== "/") fail(405, "LOCAL_OPERATION_METHOD");
  const body = normalizedJsonDto(request.body) as {
    phase?: unknown;
    key?: unknown;
    input?: unknown;
    ticket?: unknown;
    protocol?: unknown;
    version?: unknown;
  };
  if (
    !body ||
    typeof body.key !== "string" ||
    !["prepare", "execute"].includes(String(body.phase)) ||
    Object.keys(body).sort().join() !==
      (body.phase === "prepare" ? "input,key,phase" : "input,key,phase,protocol,ticket,version")
  )
    fail(400, "LOCAL_OPERATION_INPUT");
  const handle = Object.getOwnPropertyDescriptor(dependencies, definition.database)?.value;
  const bound = handle && bindings.get(handle);
  if (!bound || bound.operation !== operation) throw new Error("Unconfigured workload operation");
  if (body.phase === "prepare") {
    // The descriptor is framework-owned; product responses cannot assert checkpoint safety.
    // RG15 has no sealed durable-work result checkpoint. Refuse before allocating/executing work.
    if (definition.secret) fail(422, "WORK_SECRET_CHECKPOINT_UNSUPPORTED");
    return {
      status: 200,
      body: {
        protocol: 1,
        version: definition.version,
        secret: false,
        ticket: await bound.prepare({ key: body.key, input: body.input }),
      },
    };
  }
  if (definition.secret) fail(422, "WORK_SECRET_CHECKPOINT_UNSUPPORTED");
  if (body.protocol !== 1 || body.version !== definition.version)
    fail(409, "WORK_PROTOCOL_CONFLICT");
  if (typeof body.ticket !== "string") fail(400, "LOCAL_OPERATION_INPUT");
  // Always send protocol JSON, including operation 204/205 whose HTTP bodies are suppressed.
  return {
    status: 200,
    body: {
      protocol: 1,
      version: definition.version,
      secret: false,
      result: await bound.invoke(dependencies, { key: body.key, input: body.input }, body.ticket),
    },
  };
}
/** Expired tickets authorize nothing. The caller must never replace a durably selected ticket. */
export function sweepWorkTickets(pool: TransactionPool) {
  return transaction(
    pool,
    async (tx) =>
      (
        await tx.query(
          "DELETE FROM jeeves.work_tickets WHERE ticket IN (SELECT ticket FROM jeeves.work_tickets WHERE expires_at<=clock_timestamp() ORDER BY expires_at LIMIT 1000 FOR UPDATE SKIP LOCKED)",
        )
      ).rowCount ?? 0,
  );
}
