import { operation, withOperation, assertOperation } from "./operation.ts";
import type { OperationContext } from "./operation.ts";
import { immutable } from "./hook-boundary.ts";
import type { FastifyRequest } from "fastify";
import { HttpError } from "./admission.ts";
import type { HttpRoutes } from "./http.ts";
import { isNotImplemented, type NotImplementedLog } from "./tile-process.ts";
import type { Caller, ModuleRequest, ModuleResponse } from "../modules/entry.ts";

/** A module's routes: "Not implemented" answers 501 with one rate-limited log line. Any other
 * error keeps the HTTP service's own mapping (an HttpError its status, anything else 503). */
export function notImplementedRoutes(
  routes: HttpRoutes,
  log: NotImplementedLog,
  module: string,
): HttpRoutes {
  return {
    route({ handler, ...route }) {
      routes.route({
        ...route,
        async handler(request, reply) {
          try {
            return await handler.call(this, request, reply);
          } catch (error) {
            if (!isNotImplemented(error)) throw error;
            log({
              module,
              what: "handler",
              route: `${request.method} ${route.url}`,
              action: "answered 501",
            });
            throw new HttpError(501, "NOT_IMPLEMENTED", "Not implemented.");
          }
        },
      });
    },
  };
}

const anyMethod = ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"] as const;
const anonymous = async (): Promise<Caller> => ({ signedIn: false });
/** The path below /modules/<module> as it was sent: Fastify gives `*` decoded. The router takes
 * the path before any `?` or `#` (from the first `/` after an absolute target's host) and matches
 * `/modules/<module>` before it decodes, so the first three `/`-separated parts are that prefix. */
function rawPathOf(url: string): string {
  let target = url;
  for (const mark of ["?", "#"]) {
    const at = target.indexOf(mark);
    if (at !== -1) target = target.slice(0, at);
  }
  if (!target.startsWith("/")) {
    const at = target.indexOf("/", target.indexOf("://") + 3);
    target = at === -1 ? "/" : target.slice(at);
  }
  return `/${target.split("/").slice(3).join("/")}`;
}
async function moduleRequest(
  request: FastifyRequest,
  caller: (request: FastifyRequest) => Promise<Caller>,
  context: OperationContext,
): Promise<ModuleRequest> {
  const rest = (request.params as { "*"?: string })["*"];
  return Object.freeze({
    ...immutable({
      method: request.method,
      path: `/${rest ?? ""}`,
      rawPath: rawPathOf(request.url),
      query: request.query as ModuleRequest["query"],
      headers: Object.fromEntries(
        Object.entries(request.headers).filter(([name]) =>
          [
            "accept",
            "content-type",
            "if-none-match",
            "if-modified-since",
            "idempotency-key",
          ].includes(name.toLowerCase()),
        ),
      ),
      body: request.body,
      rawBody: request.rawBody,
      caller: await caller(request),
    }),
    signal: context.signal,
    context,
  });
}
/** A route stub answers any method on /modules/<module> and every path below it. `caller` is the
 * tile's Auth guard's, or anonymous. Its request's `signal` is aborted with `Error("DEADLINE")`
 * `deadlineMs` after the handler starts (the tile's Request timeout, when the admission answers
 * 503 `DEADLINE`), or with `Error("CLIENT_CLOSED")` when the client goes before the answer is
 * written; once the stub has answered it is never aborted. */
export function stubRoutes(
  routes: HttpRoutes,
  log: NotImplementedLog,
  module: string,
  entry: (request: ModuleRequest) => Promise<ModuleResponse>,
  limits: { deadlineMs: number; stopping?: AbortSignal },
  caller: (request: FastifyRequest) => Promise<Caller> = anonymous,
): void {
  const mounted = notImplementedRoutes(routes, log, module);
  for (const url of [`/modules/${module}`, `/modules/${module}/*`])
    mounted.route({
      method: [...anyMethod],
      url,
      bodyLimit: 65536,
      rawBody: false,
      async handler(request, reply) {
        const callerFacts = await caller(request);
        const parent = request.operationContext;
        const running = operation({
          maximumMs: limits.deadlineMs,
          remainingMs: parent?.remainingMs(),
          correlationId: parent?.correlationId,
          caller: callerFacts.signedIn ? { subject: callerFacts.principal.subject } : {},
          signals: [parent?.signal, limits.stopping],
        });
        try {
          const response = await withOperation(running.context, async () =>
            entry(await moduleRequest(request, async () => callerFacts, running.context)),
          );
          // A child budget may expire just before its parent timer; never let a late
          // empty/success response win the outer admission deadline race.
          assertOperation(running.context);
          reply.code(response.status ?? 200);
          for (const [name, value] of Object.entries(response.headers ?? {}))
            reply.header(name, Array.isArray(value) ? [...value] : value);
          return response.body;
        } finally {
          running.close();
        }
      },
    });
}
