    typeof definition.database !== "string" ||
    !definition.database ||
    !/^[a-z][a-z0-9-]{0,63}$/.test(definition.id) ||
    !Number.isSafeInteger(definition.version) ||
    definition.version < 1 ||
    definition.version > 1000000 ||
    !Number.isSafeInteger(definition.retentionSeconds) ||
    definition.retentionSeconds < 60 ||
    definition.retentionSeconds > 604800 ||
