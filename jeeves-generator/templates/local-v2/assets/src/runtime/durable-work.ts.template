          ).rowCount ?? 0,
      );
    },
    async runBatch(log: (event: string, fields: WorkLogFields) => void): Promise<void> {
      const emit = (event: string, claim: WorkClaim) =>
        log(event, {
          operation: definition.id,
          correlationId: currentOperation()?.correlationId,
          work: claim.identity,
        });
      for (let i = 0; i < workPolicy.batch && !active.size; i++) {
        assertOperation();
        const [claim] = await store.claim(1);
        if (!claim) break;
        try {
          if (await store.dispatch(claim)) await store.complete(claim);
        } catch (error) {
          if (error instanceof WorkError && error.code === "WORK_LEASE_LOST") {
            emit("work lease lost", claim);
            continue;
          }
          if (error instanceof WorkError && error.code === "WORK_SECRET_CHECKPOINT_UNSUPPORTED") {
            await store.refuseSecret(claim);
            emit("work integration refused", claim);
            continue;
          }
          // Local unknown COMMIT is recovered from the atomic state; never infer rollback from timeout.
          if (error instanceof OperationError && error.outcome === "unknown") {
            emit("work outcome unknown", claim);
            // An expired execution cannot open more SQL. Its persisted running/dispatched row
            // remains reclaimable; keep the actual transport/transaction slot until settlement.
            const context = currentOperation();
            if (
              definition.integration &&
              !context?.signal.aborted &&
              (context?.remainingMs() ?? 1) > 0
            ) {
              try {
                await store.deferUnknown(claim);
              } catch (error) {
                if (
                  !(
                    error instanceof OperationError &&
                    ["CONTEXT_EXPIRED", "PROCESS_STOPPING"].includes(error.code)
                  )
                )
                  throw error;
              }
            }
            break;
          }
          if (error && typeof error === "object" && storageFailures.has(error)) {
            failureWork.set(error, { work: claim.identity });
            throw error;
          }
          if (await store.fail(claim)) emit("work handler failed", claim);
        }
      }
    },
    async deferUnknown(claim: WorkClaim) {
      // Retain the selected ticket. Reclaims may execute only that ticket, never prepare another.
      await storage(pool, async (tx) =>
        tx.query(
          `UPDATE jeeves.work_records SET state=CASE WHEN attempts>=max_attempts THEN 'unknown' ELSE 'retry' END,error='WORK_OUTCOME_UNKNOWN',next_attempt_at=clock_timestamp()+interval '1 second',holder=NULL,lease_until=NULL WHERE ${where}`,
          held(claim),
        ),
      );
    },
  };
  return store;
}
export function bindDurableWork(
  handle: object,
  prepared: NonNullable<ReturnType<typeof durableWorkDefinition>>,
  options: {
    namespace: string;
    process?: string;
    pool: TransactionPool;
    productRole: string;
    commands: CommandFactory;
  },
) {
  const store = createWorkStore({
    ...options,
    definition: prepared.definition,
  });
  bindings.set(handle, { work: prepared.work, store });
  return store;
}
/** Generated process code alone activates the work drain. No public tick, claim or completion method. */
export function startDurableWork(
  work: unknown,
  dependencies: object,
  scope: ProcessScope,
  log: (event: string, fields: WorkLogFields) => void,
  intervalSeconds?: number,
) {
  if (work === undefined) return;
  const definition = definitions.get(work as object);
  const handle =
    definition && Object.getOwnPropertyDescriptor(dependencies, definition.database)?.value;
  const binding = handle && bindings.get(handle);
  if (!binding || binding.work !== work) throw new Error("Unconfigured durable work");
  if (definition!.integration)
    binding.store.configureTarget(
      Object.getOwnPropertyDescriptor(dependencies, definition!.integration.target)?.value,
    );
  periodic(
    scope,
    async () => {
      const execution = operation({
        maximumMs: 30000,
        signals: [scope.signal],
      });
      try {
        await withOperation(execution.context, async () => {
          if (intervalSeconds !== undefined) {
            const halted = await binding.store.schedule(intervalSeconds);
            if (halted)
              log(`scheduled task halted ${halted}`, {
                operation: definition!.id,
                correlationId: execution.context.correlationId,
              });
          }
          await binding.store.runBatch(log);
          if (
            !execution.context.signal.aborted &&
            (intervalSeconds === undefined || binding.store.idle)
          )
            await binding.store.sweep();
        });
      } catch (error) {
        if (
          scope.signal.aborted ||
          (error instanceof OperationError &&
            ["CONTEXT_EXPIRED", "PROCESS_STOPPING"].includes(error.code))
        )
          return;
        if (
          intervalSeconds !== undefined &&
          error instanceof WorkError &&
          error.code === "WORK_SCHEDULE_MIGRATION_REQUIRED"
        ) {
          log("scheduled task migration required", {
            operation: definition!.id,
            correlationId: execution.context.correlationId,
          });
          return;
        }
        log("work storage unavailable", {
          operation: definition!.id,
          correlationId: execution.context.correlationId,
          ...(error && typeof error === "object" ? failureWork.get(error) : {}),
        });
      } finally {
        execution.close();
      }
    },
    workPolicy.pollMs,
  );
}

function validateInterval(intervalSeconds: number) {
  if (!Number.isSafeInteger(intervalSeconds) || intervalSeconds < 1 || intervalSeconds > 604800)
    throw new Error("Scheduled interval must be 1..604800 seconds");
}
/** Private generated validation: no timer methods or lease controls enter the extension API. */
export function validateScheduledTaskBinding(work: unknown, properties: readonly string[]) {
  validateDurableWorkBinding(work, properties);
  const definition = work && typeof work === "object" ? definitions.get(work) : undefined;
  if (!definition || definition.retentionSeconds !== 604800)
    throw new Error(
      "Scheduled task requires a durableWork declaration with fixed seven-day retention; migrate the handler explicitly",
    );
}
/** Same process lifecycle and engine as accepted work, independent of HTTP or deliveries. */
export async function startScheduledTask(
  work: unknown,
  dependencies: object,
  scope: ProcessScope,
  log: (event: string, fields: WorkLogFields) => void,
  intervalSeconds: number,
) {
  validateInterval(intervalSeconds);
  const definition = definitions.get(work as object);
  validateScheduledTaskBinding(work, definition ? [definition.database] : []);
  const handle = Object.getOwnPropertyDescriptor(dependencies, definition!.database)?.value;
  const binding = handle && bindings.get(handle);
  if (!binding || binding.work !== work) throw new Error("Unconfigured scheduled task");
  const execution = operation({ maximumMs: 30000, signals: [scope.signal] });
  try {
    await withOperation(execution.context, () => binding.store.checkSchedule());
  } finally {
    execution.close();
  }
  startDurableWork(work, dependencies, scope, log, intervalSeconds);
}
