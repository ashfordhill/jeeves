/** Private receipt binding; public extensions declare mapping and scoped commands only. */
import { randomUUID } from "node:crypto";
import { normalizedJsonDto } from "./hook-boundary.ts";
import { withLocalPolicy, operation, withOperation, withProcess } from "./operation.ts";
import { productMutation, type ScopedCommands, type CommandFactory } from "./product-mutation.ts";
import { createReceipts, ReceiptConflict, validateReceiptRetention, type ReceiptRetention } from "./receipts.ts";
