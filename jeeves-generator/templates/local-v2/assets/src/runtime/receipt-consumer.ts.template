}
function engine(value: unknown, dependencies: object) {
  const definition = value && typeof value === "object" ? definitions.get(value) : undefined;
  if (!definition) throw Error("Invalid receipt consumer declaration");
  const handle = (dependencies as Record<string, object>)[definition.database];
  const bound = handle && bindings.get(handle);
  if (!bound || bound.definition !== definition) throw Error("Receipt consumer binding unavailable");
  return bound;
}
export function invokeReceiptConsumer(value: unknown, dependencies: object, message: { body: Uint8Array; messageId?: string }, legacy: () => Promise<void>) {
  return value === undefined ? legacy() : engine(value, dependencies).run(message);
}
export function startReceiptConsumer(value: unknown, dependencies: object, scope: ProcessScope) {
  if (value !== undefined) engine(value, dependencies).start(scope);
}
