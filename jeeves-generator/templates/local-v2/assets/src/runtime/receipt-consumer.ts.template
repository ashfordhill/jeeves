export interface ReceiptEvent { readonly id: string; readonly payload: unknown; }
declare const receiptBrand: unique symbol;
export interface ReceiptConsumer<Dependencies> { readonly [receiptBrand]: Dependencies; }
type Definition = {
  database: string;
