  let actual: Promise<T> | undefined;
  try { return await transaction(pool, effect, { observe: pending => { actual = pending; } }); }
  finally { await actual?.catch(() => {}); }
}
export function bindReceiptConsumer(handle: object, declared: NonNullable<ReturnType<typeof receiptConsumerDefinition>>, options: {
  namespace: string; consumerId: string; pool: TransactionPool; productRole: string; commands: CommandFactory;
