import { operation, withOperation, OperationError, withProcess, currentProcess } from "./operation.ts";
import { AsyncLocalStorage } from "node:async_hooks";
import { createConsumer, type BrokerBinding, type BrokerState } from "./amqp.ts";
import {
  NonRetryable,
  UNREACHABLE_WAIT_MS,
  unreachable,
  type ConsumerHooks,
  type Delivery,
  type MessageHandler,
} from "./delivery.ts";
import type { ProcessScope } from "./process.ts";
import {
  createNotImplementedLog,
  createProcessLog,
  isNotImplemented,
  notImplementedWhat,
  type NotImplementedLog,
} from "./tile-process.ts";
import type { ModuleMessage } from "../modules/entry.ts";

/** One loop: the module it calls, the queue it consumes, that queue's .failed and its bounds. */
export type ModuleLoop = {
  module: string;
  queue: string;
  failedQueue: string;
  retryLimit: number;
  concurrency: number;
};

/** What a loop's consumer opens with: its queue (for a Pub/Sub loop, its subscription), that
 * queue's .failed, its bounds, the handler each message is given and its state hook. */
export type LoopConsumerOptions = {
  queue: string;
  failedQueue: string;
  concurrency: number;
  retryLimit: number;
  handle: MessageHandler;
  onState?: BrokerState;
  onProgress?: ConsumerHooks["onProgress"];
  durableCompletion?: boolean;
};
/** An open consumer: `close` stops taking messages and lets those in hand settle before it closes;
 * `closed` resolves only after `close()`. */
export type LoopConsumer = { close(): Promise<void>; closed: Promise<{ fatal: boolean }> };
/**
 * How a loop consumes, the interface both transports implement: RabbitMQ's consumer on a broker
 * binding (`amqpLoop`) and a Pub/Sub subscription's (`pubsubLoop` in module-clients.ts). `retries`
 * says what spaces a retry: the handler's `retryDelay` wait (RabbitMQ), or the transport itself
 * (a Pub/Sub subscription's retry policy).
 */
export type LoopTransport = {
  retries: "handler" | "transport";
  open(options: LoopConsumerOptions): Promise<LoopConsumer>;
};
/** RabbitMQ: `createConsumer` on the broker's binding, which the process reads from its
 * environment (`brokerBinding`); no endpoint is compiled in. */
export function amqpLoop(broker: BrokerBinding): LoopTransport {
  return { retries: "handler", open: (options) => createConsumer(broker, options) };
}

/** A process's loop log: "Not implemented" lines, and one line per other failed message. Each is
 * at most once a second per module and hook (or queue), the next line counting what it held back. */
export type LoopLog = {
  notImplemented: NotImplementedLog;
  failed(entry: {
    module: string;
    queue: string;
    messageId?: string;
    attempt: number;
    error: string;
    action: string;
  }): void;
};
export function createLoopLog(tile: string): LoopLog {
  const failed = createProcessLog(tile, "error", "loop-error");
  return {
    notImplemented: createNotImplementedLog(tile),
    failed: (entry) => failed(`${entry.module}\u0000${entry.queue}`, entry),
  };
}

/** The wait before retry `attempt` (1 for the first retry): 250 ms doubling, at most 10 s. */
export function retryDelay(attempt: number): number {
  return Math.min(250 * 2 ** Math.max(0, attempt - 1), 10000);
}
/** Resolves after `ms`, or at once when `signal` aborts. */
function wait(ms: number, signal: AbortSignal): Promise<void> {
  if (signal.aborted) return Promise.resolve();
  return new Promise((resolve) => {
    const done = () => {
      clearTimeout(timer);
      signal.removeEventListener("abort", done);
      resolve();
    };
    const timer = setTimeout(done, ms);
    signal.addEventListener("abort", done, { once: true });
  });
}
const describe = (error: unknown) =>
  error instanceof NonRetryable ? error.code : error instanceof OperationError ?
    error.outcome === "unknown" ? "OUTCOME_UNKNOWN" : error.outcome === "refused" ? "OPERATION_REFUSED" : "PROCESSING_FAILED" :
    unreachable(error) ? "DEPENDENCY_UNAVAILABLE" : "PROCESSING_FAILED";
const messageId = (delivery: Delivery) =>
  delivery.messageId === undefined ? {} : { messageId: delivery.messageId };
/** The delivery runner waits out an unreachable store itself and keeps the attempt. */
const storeUnreachable = (error: unknown) => unreachable(error) && !(error instanceof NonRetryable);
/**
 * What a failed message's runner does next, by the delivery runner's rule, which a Pub/Sub loop's
 * runner keeps too: an unreachable store (not a `NonRetryable`) waits and keeps the attempt; a
 * `NonRetryable` ends in .failed with its code, and so does a failure on attempt retry limit + 1
 * (`RETRY_EXHAUSTED`); anything else is retried.
 */
export function failureStep(
  error: unknown,
  attempt: number,
  retryLimit: number,
): { step: "wait" } | { step: "terminal"; code: string } | { step: "retry" } {
  if (error instanceof OperationError && error.outcome === "unknown") return { step: "terminal", code: "OUTCOME_UNKNOWN" };
  if (storeUnreachable(error)) return { step: "wait" };
  if (error instanceof NonRetryable) return { step: "terminal", code: error.code };
  return attempt > retryLimit ? { step: "terminal", code: "RETRY_EXHAUSTED" } : { step: "retry" };
}
/** What the delivery runner does with a failed message: retry it, or send it to .failed. */
function outcome(loop: Pick<ModuleLoop, "failedQueue" | "retryLimit">, error: unknown, delivery: Delivery) {
  const next = failureStep(error, delivery.deliveryCount, loop.retryLimit);
  if (next.step === "wait")
    return {
      retry: true,
      action: `store unreachable, retry in ${UNREACHABLE_WAIT_MS} ms (attempt not counted)`,
    };
  return next.step === "terminal"
    ? { retry: false, action: `sent to ${loop.failedQueue} (${next.code})` }
    : { retry: true, action: `retry ${delivery.deliveryCount} of ${loop.retryLimit}` };
}

/**
 * A module's handler (tile process contract, section 5): each message calls its entry point.
 * "Not implemented" is terminal at once (NOT_IMPLEMENTED: the message goes to .failed) with one
 * log line. An unreachable store waits no `retryDelay` here: the runner waits 5 s and keeps the
 * attempt. Any other error is retried within the loop's limit after `retryDelay(attempt)`, then
 * ends in .failed as RETRY_EXHAUSTED; `stopping` cuts a wait short. With `retries` "transport"
 * (a Pub/Sub loop), the handler doesn't wait: the subscription's retry policy spaces the retry.
 */
export function moduleHandler(
  log: LoopLog,
  loop: ModuleLoop,
  entry: (message: ModuleMessage) => Promise<void>,
  stopping: AbortSignal,
  retries: LoopTransport["retries"] = "handler",
): MessageHandler {
  return async (body, delivery) => {
    try {
      const execution = operation({ maximumMs: 30000, correlationId: delivery.headers?.correlationId, signals: [stopping] });
      try { await withOperation(execution.context, () => entry({
        context: execution.context,
        body,
        ...messageId(delivery),
        headers: delivery.headers,
        attempt: delivery.deliveryCount,
        source: loop.queue,
      })); } finally { execution.close(); }
    } catch (error) {
      if (isNotImplemented(error)) {
        log.notImplemented({
          module: loop.module,
          what: notImplementedWhat(error),
          queue: loop.queue,
          ...messageId(delivery),
          action: `sent to ${loop.failedQueue} (NOT_IMPLEMENTED)`,
        });
        throw new NonRetryable("NOT_IMPLEMENTED");
      }
      const next = outcome(loop, error, delivery);
      const waits = next.retry && !storeUnreachable(error) && retries === "handler";
      const delay = waits ? retryDelay(delivery.deliveryCount) : 0;
      log.failed({
        module: loop.module,
        queue: loop.queue,
        ...messageId(delivery),
        attempt: delivery.deliveryCount,
        error: describe(error),
        action: waits ? `${next.action} in ${delay} ms` : next.action,
      });
      if (waits) await wait(delay, stopping);
      if (error instanceof OperationError && error.outcome === "unknown") throw new NonRetryable("OUTCOME_UNKNOWN");
      throw error;
    }
  };
}

/**
 * Starts a module's loop on its queue through its transport: a broker binding is RabbitMQ's
 * (`amqpLoop`: manual ack, prefetch equal to its concurrency, bounded retry and `<queue>.failed`),
 * and `pubsubLoop` a Pub/Sub subscription's, with the same contract. Stopping cancels the
 * subscription, cuts a retry wait short and drains the message in hand. After a lost connection
 * the consumer reconnects every 5 s, telling `onState`; nothing here fails the process. The
 * process always passes the transport: no broker endpoint is compiled in.
 */
export async function startModuleLoop(
  scope: ProcessScope,
  log: LoopLog,
  loop: ModuleLoop,
  entry: (message: ModuleMessage) => Promise<void>,
  onState: BrokerState | undefined,
  transport: LoopTransport | BrokerBinding,
) {
  const consumes = "open" in transport ? transport : amqpLoop(transport);
  const stopping = new AbortController();
  const consumer = await consumes.open({
    queue: loop.queue,
    failedQueue: loop.failedQueue,
    concurrency: loop.concurrency,
    retryLimit: loop.retryLimit,
    handle: (body, delivery) => withProcess(scope, () => moduleHandler(log, loop, entry, stopping.signal, consumes.retries)(body, delivery)),
    onState,
  });
  scope.admission?.(() => { stopping.abort(); void consumer.close().catch(() => {}); });
  scope.own(() => {
    stopping.abort();
    return consumer.close();
  });
  scope.transport(consumer);
  return consumer;
}

/**
 * A mounted template's consumer on its loop row: the queue, `.failed`, concurrency and retry limit
 * the process config names, so each consuming module of a tile reads its own subscriber queue,
 * on the broker binding the process passes (`brokerBinding`).
 */
export async function loopConsumer(
  loop: Omit<ModuleLoop, "module">,
  handle: MessageHandler,
  hooks: ConsumerHooks & { onState?: BrokerState },
  broker: BrokerBinding,
) {
  const scope = currentProcess();
  const consumer = await createConsumer(broker, {
    ...hooks,
    queue: loop.queue,
    failedQueue: loop.failedQueue,
    concurrency: loop.concurrency,
    retryLimit: loop.retryLimit,
    handle,
  });
  scope?.admission?.(() => { void consumer.close().catch(() => {}); });
  return consumer;
}

const reached = new AsyncLocalStorage<{ what?: string }>();
/**
 * A mounted template's hooks, unchanged except that a hook throwing "Not implemented" is noted
 * for the message it was reached for (or logged at once outside a message).
 */
export function watchHooks<T extends object>(hooks: T, log: LoopLog, module: string): T {
  const note = (error: unknown): never => {
    if (isNotImplemented(error)) {
      const store = reached.getStore();
      if (store) store.what ??= notImplementedWhat(error);
      else log.notImplemented({ module, what: notImplementedWhat(error), action: "thrown" });
    }
    throw error;
  };
  const wrap = (value: unknown): unknown => {
    if (typeof value === "function")
      return function (this: unknown, ...args: unknown[]) {
        try {
          const result: unknown = value.apply(this, args);
          return result instanceof Promise ? result.catch(note) : result;
        } catch (error) {
          return note(error);
        }
      };
    if (value && typeof value === "object" && Object.getPrototypeOf(value) === Object.prototype)
      return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, wrap(item)]));
    return value;
  };
  return wrap(hooks) as T;
}
/** A template's own terminal code (such as INVALID_MEDIA) is kept; MALFORMED_MESSAGE is the
 * generic answer to any codec or parse failure, including a codec that isn't written. */
const specific = (error: unknown) =>
  error instanceof NonRetryable && error.code !== "MALFORMED_MESSAGE";
/**
 * A mounted template's handler: the template decides what a failure does, with its own retry
 * limit and terminal codes. Each failed message logs one line, naming the hook it reached when
 * that hook is not implemented. A message that reached such a hook goes to .failed at once as
 * NOT_IMPLEMENTED, as a stub's does (a retry can't write it), unless the template gave a code of
 * its own.
 */
export function templateHandler(
  log: LoopLog,
  loop: Pick<ModuleLoop, "module" | "queue" | "failedQueue" | "retryLimit">,
  handle: MessageHandler,
): MessageHandler {
  const scope = currentProcess();
  return async (body, delivery) => {
    const store: { what?: string } = {};
    try {
      const execution = operation({ maximumMs: 30000, correlationId: delivery.headers?.correlationId, signals: [scope?.signal] });
      try { await withProcess(scope, () => withOperation(execution.context, () => reached.run(store, () => handle(body, delivery)))); }
      finally { execution.close(); }
    } catch (error) {
      const next = outcome(loop, error, delivery);
      const unwritten = store.what !== undefined && !specific(error);
      if (store.what)
        log.notImplemented({
          module: loop.module,
          what: store.what,
          queue: loop.queue,
          ...messageId(delivery),
          action: unwritten ? `sent to ${loop.failedQueue} (NOT_IMPLEMENTED)` : next.action,
        });
      else
        log.failed({
          module: loop.module,
          queue: loop.queue,
          ...messageId(delivery),
          attempt: delivery.deliveryCount,
          error: describe(error),
          action: next.action,
        });
      if (error instanceof OperationError && error.outcome === "unknown") throw new NonRetryable("OUTCOME_UNKNOWN");
      throw unwritten ? new NonRetryable("NOT_IMPLEMENTED") : error;
    }
  };
}
