import { dependency, currentProcess } from "./operation.ts";
import { S3Client, UploadPartCommand } from "@aws-sdk/client-s3";
import { getSignedUrl } from "@aws-sdk/s3-request-presigner";
import { readSecret } from "./local.ts";
import { probeDependency } from "./process.ts";

export function createObjects(options: {
  endpoint: string;
  region: string;
  credentialSecret: string;
  credential?: (secret: string) => string;
  /** Installed Garage's private unauthenticated quorum health endpoint, never a product URL. */
  healthEndpoint?: string;
}) {
  const credentials: unknown = JSON.parse(
    (options.credential ?? readSecret)(options.credentialSecret),
  );
  if (
    !credentials ||
    typeof credentials !== "object" ||
    !("accessKeyId" in credentials) ||
    typeof credentials.accessKeyId !== "string" ||
    !credentials.accessKeyId ||
    !("secretAccessKey" in credentials) ||
    typeof credentials.secretAccessKey !== "string" ||
    !credentials.secretAccessKey
  )
    throw new Error("Invalid object credential");
  const operationScope = currentProcess();
  const client = new S3Client({
    endpoint: options.endpoint,
    region: options.region,
    credentials: {
      accessKeyId: credentials.accessKeyId,
      secretAccessKey: credentials.secretAccessKey,
    },
    forcePathStyle: true,
    maxAttempts: 1,
    requestChecksumCalculation: "WHEN_REQUIRED",
    responseChecksumValidation: "WHEN_REQUIRED",
  });
  const healthEndpoint = options.healthEndpoint;
  if (healthEndpoint) probeDependency(operationScope, client, async signal => {
    const response = await fetch(healthEndpoint, { signal, redirect: "manual", credentials: "omit" });
    await response.body?.cancel();
    if (response.status !== 200) throw Error("Object provider unavailable");
  });
  return new Proxy(client, {
    get(target, key) {
      if (key === "send") return (command: Parameters<S3Client["send"]>[0], options: { abortSignal?: AbortSignal } = {}) =>
        dependency({ scope: operationScope, mutation: !/^(Get|Head|List)/.test(command.constructor.name),
          definite: (error) => error instanceof Error && error.name === "NoSuchKey", preserveDefinite: true,
        }, (signal) => target.send(command, { ...options, abortSignal: options.abortSignal ? AbortSignal.any([options.abortSignal, signal]) : signal }));
      const value = Reflect.get(target, key);
      return typeof value === "function" ? value.bind(target) : value;
    },
  });
}
/** Provider primitive only; caller enforces ownership, part identity, bounds and lifecycle.
 * Supply a client with the public signing endpoint separately from the internal control client. */
export function signPart(
  client: S3Client,
  part: {
    bucket: string;
    key: string;
    uploadId: string;
    partNumber: number;
    expiresInSeconds: number;
  },
) {
  return getSignedUrl(
    client,
    new UploadPartCommand({
      Bucket: part.bucket,
      Key: part.key,
      UploadId: part.uploadId,
      PartNumber: part.partNumber,
    }),
    { expiresIn: part.expiresInSeconds },
  );
}
