import { assertDatabaseAllowed, assertOperation, dependency, OperationError } from "./operation.ts";
import type pg from "pg";

const transactionScope: unique symbol = Symbol("SQL transaction");
export interface Tx {
  readonly [transactionScope]: true;
  query<Row extends pg.QueryResultRow = pg.QueryResultRow>(
    sql: string,
    values?: unknown[],
  ): Promise<pg.QueryResult<Row>>;
}
export type TransactionPool = Pick<pg.Pool, "connect">;
const scopes = new WeakMap<Tx, { active: boolean; failure?: { error: unknown } }>();
export function assertTransaction(tx: Tx): void {
  const scope = scopes.get(tx);
  if (!scope?.active) throw new Error("SQL transaction is not active");
  if (scope.failure) throw scope.failure.error;
}
/** A failed atomic hook must not leave a receipt committed if its caller catches the error. */
export function abortTransaction(tx: Tx, error: unknown): never {
  const scope = scopes.get(tx);
  if (scope && !scope.failure) scope.failure = { error };
  throw error;
}
async function executeTransaction<T>(
  pool: TransactionPool,
  effect: (tx: Tx) => Promise<T>,
  options: { readOnly?: boolean },
): Promise<T> {
  const client = await pool.connect().catch((error: unknown) => {
    if (error instanceof Error)
      Object.defineProperty(error, "outcome", { value: "definite-failure", configurable: true });
    throw error;
  });
  const scope = { active: true };
  const tx: Tx = Object.freeze({
    [transactionScope]: true as const,
    query<Row extends pg.QueryResultRow>(sql: string, values?: unknown[]) {
      assertTransaction(tx);
      assertOperation();
      return client.query<Row>(sql, values).catch((error: unknown) => abortTransaction(tx, error));
    },
  });
  scopes.set(tx, scope);
  let began = false,
    discard = false;
  try {
    assertOperation();
    await client.query(options.readOnly ? "BEGIN READ ONLY" : "BEGIN");
    began = true;
    const result = await effect(tx);
    assertTransaction(tx);
    assertOperation();
    try {
      await client.query("COMMIT");
    } catch (error) {
      const code = (error as { code?: string })?.code;
      if (
        typeof code !== "string" ||
        !/^[0-9A-Z]{5}$/.test(code) ||
        /^E[A-Z]+$/.test(code) ||
        code.startsWith("08") ||
        code === "57P01" ||
        code === "57P02"
      ) {
        discard = true;
        const unknown = new OperationError("unknown", "COMMIT_RESPONSE_LOST", { cause: error });
        unknown.name = "TransactionOutcomeUnknown";
        unknown.message = "Transaction outcome unknown";
        throw unknown;
      }
      throw error;
    }
    return result;
  } catch (error) {
    if (began) {
      try {
        await client.query("ROLLBACK");
        if (
          error instanceof Error &&
          !(error instanceof OperationError)
        )
          Object.defineProperty(error, "outcome", {
            value: "definite-failure",
            configurable: true,
          });
      } catch {
        discard = true;
      }
    } else discard = true;
    throw error;
  } finally {
    scope.active = false;
    client.release(discard);
  }
}

/** The underlying transaction retains its connection through final COMMIT/ROLLBACK settlement.
 * A caller timeout never releases the connection or grants permission to retry its mutation. */
export function transaction<T>(pool: TransactionPool, effect: (tx: Tx) => Promise<T>, options: {readOnly?: boolean} = {}): Promise<T> {
  assertDatabaseAllowed();
  return dependency(
    {
      mutation: !options.readOnly,
      preserveDefinite: true,
      definite: (error) => {
        return (error as { outcome?: string })?.outcome === "definite-failure";
      },
    },
    () => executeTransaction(pool, effect, options),
  );
}
