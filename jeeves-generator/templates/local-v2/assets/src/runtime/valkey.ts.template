import { dependency, OperationError, currentProcess, assertNetworkAllowed, assertOperation } from "./operation.ts";
import { readFileSync } from "node:fs";
import { createClient, ErrorReply } from "redis";
import { randomUUID } from "node:crypto";
import { readSecret } from "./local.ts";

/** How a client reaches its cache (QG10). `disable`: plain TCP. `verify-full`: TLS that checks the
 * server's certificate chain against `ca` (PEM; else Node's roots) and its name against the host,
 * or against `servername` when the certificate carries another name (a managed instance reached by
 * a private address). No value turns verification off. */
export type CacheTls =
  | { mode: "disable" }
  | { mode: "verify-full"; ca?: string; servername?: string };
export type ValkeyBinding = { hostname: string; port: number; secret: string; tls: CacheTls };

/** Private runtime primitives. Product hooks receive the separately scoped CacheClient;
 * scripts, clients, sockets and these coordination operations are never injected into hooks. */
export interface WindowDecision {
  readonly admitted: boolean;
  readonly count: number;
  /** Absolute UTC milliseconds on the store clock: oldest admission leaves the window here. */
  readonly resetAt: number;
}
export interface VersionedValue {
  /** Canonical unsigned 64-bit decimal, compared without converting it to a Lua/JS number. */
  readonly version: string;
  readonly value: string;
  /** Absolute UTC milliseconds. Copying or transporting a record never renews this bound. */
  readonly validUntil: number;
}
export interface VersionWrite {
  readonly status: "stored" | "not-newer" | "expired" | "version-conflict";
  readonly validUntil: number;
}
export interface ValkeyCache {
  get(key: string): Promise<string | null>;
  set(key: string, value: string, expiry?: { PXAT: number } | { EX: number }): Promise<unknown>;
  delete(key: string): Promise<unknown>;
  ping(): Promise<unknown>;
  /** One rolling log, at most limit admissions in any windowMs, using store TIME. Use a
   * separate key namespace per fixed policy; denials do not extend expiry. Unavailability throws
   * and NEVER supplies an allowance. 1–10,000 entries; 1 ms–7 days. No automatic retry. */
  admit(key: string, policy: Readonly<{ limit: number; windowMs: number }>): Promise<WindowDecision>;
  getVersioned(key: string): Promise<VersionedValue | null>;
  /** Single-key compare/write with PXAT. Same version can renew only identical contents.
   * Versions are fenced while the key is retained, not across cache eviction/expiry/data loss.
   * A source must supply versions and an absolute validity bound before starting its fill;
   * current UTC clocks must agree for client-side validity checks. At most 7 days remain. */
  setIfNewer(key: string, record: VersionedValue): Promise<VersionWrite>;
  close(): void;
}
const MAX_PENDING = 32;
const MAX_VALUE = 65536;
const MAX_LIFETIME = 604800000;
const MAX_VERSION = "18446744073709551615";
const validVersion = (v: unknown): v is string => typeof v === "string" &&
  /^(0|[1-9][0-9]{0,19})$/.test(v) && (v.length < 20 || v <= MAX_VERSION);
const validUntil = (v: unknown): v is number => Number.isSafeInteger(v) && Number(v) > 0;
const wellFormed = (v: string) => Buffer.from(v, "utf8").toString("utf8") === v;
const validValue = (v: unknown): v is string => typeof v === "string" && Buffer.byteLength(v) <= MAX_VALUE && wellFormed(v);
const validRecord = (v: unknown): v is VersionedValue => {
  if (!v || typeof v !== "object") return false;
  const r = v as VersionedValue;
  return validVersion(r.version) && validValue(r.value) && validUntil(r.validUntil);
};
const failure = (outcome: "refused" | "definite-failure" | "unknown", code: string, message?: string) => {
  const error = new OperationError(outcome, code);
  if (message) error.message = message;
  return error;
};
function keyInput(key: string) {
  if (typeof key !== "string" || !key || Buffer.byteLength(key) > 512 || !wellFormed(key))
    throw failure("refused", "INVALID_CACHE_KEY");
}

// Fixed single-key scripts. Never accept script text, command names or key lists from hooks.
const ADMIT_WINDOW = `
local t = redis.call('TIME')
local now = tonumber(t[1]) * 1000 + math.floor(tonumber(t[2]) / 1000)
local window = tonumber(ARGV[1])
local limit = tonumber(ARGV[2])
redis.call('ZREMRANGEBYSCORE', KEYS[1], '-inf', now - window)
local count = redis.call('ZCARD', KEYS[1])
local admitted = 0
if count < limit then
  redis.call('ZADD', KEYS[1], now, ARGV[3])
  redis.call('PEXPIREAT', KEYS[1], now + window)
  count = count + 1
  admitted = 1
end
local oldest = redis.call('ZRANGE', KEYS[1], 0, 0, 'WITHSCORES')
return {admitted, count, now, tonumber(oldest[2]) + window}
`;
const SET_IF_NEWER = `
local t = redis.call('TIME')
local now = tonumber(t[1]) * 1000 + math.floor(tonumber(t[2]) / 1000)
local untilAt = tonumber(ARGV[3])
if untilAt <= now then return 2 end
if untilAt > now + ${MAX_LIFETIME} then return redis.error_reply('JEEVES_CACHE_EXPIRY') end
local cur = redis.call('GET', KEYS[1])
if cur then
  local ok, e = pcall(cjson.decode, cur)
  if not ok or type(e) ~= 'table' or e.v ~= 1 or type(e.version) ~= 'string'
     or not string.match(e.version, '^%d+$') or #e.version > 20
     or (#e.version > 1 and string.sub(e.version, 1, 1) == '0')
     or (#e.version == 20 and e.version > '${MAX_VERSION}')
     or type(e.value) ~= 'string' or #e.value > ${MAX_VALUE}
     or type(e.validUntil) ~= 'number' or e.validUntil <= 0
     or e.validUntil > 9007199254740991 or e.validUntil ~= math.floor(e.validUntil) then
    return redis.error_reply('JEEVES_CACHE_RECORD')
  end
  local version = ARGV[2]
  if #e.version > #version or (#e.version == #version and e.version > version) then return 0 end
  if e.version == version then
    if e.value ~= ARGV[4] then return 3 end
    if e.validUntil >= untilAt then return 0 end
  end
end
redis.call('SET', KEYS[1], ARGV[1], 'PXAT', ARGV[3])
return 1
`;

/** A host is 1–253 letters, digits, `.` or `-`; a port an integer 1–65535. */
const validHost = (hostname: string) => /^[A-Za-z0-9.-]{1,253}$/.test(hostname);
const validPort = (port: number) => Number.isInteger(port) && port >= 1 && port <= 65535;

/** `JEEVES_REQUIRE_TLS` (QG10): `true` makes startup refuse a plain-text endpoint (`Insecure
 * endpoint <variable>`); absent, nothing is refused; any other value fails naming it. */
function requireTls(): boolean {
  const value = process.env.JEEVES_REQUIRE_TLS;
  if (value === undefined) return false;
  if (value !== "true") throw new Error("Invalid endpoint JEEVES_REQUIRE_TLS");
  // `0` turns off certificate checks for every client that leaves them to Node (`fetch`, the
  // sign-in's key set), so under the switch only unset or `1` passes (QG30).
  const verify = process.env.NODE_TLS_REJECT_UNAUTHORIZED;
  if (verify !== undefined && verify !== "1")
    throw new Error("Insecure endpoint NODE_TLS_REJECT_UNAUTHORIZED");
  return true;
}

/** A CA file's PEM, read when the client is built: one that can't be read fails startup naming
 * its variable (and the error code), never the path. */
function readCa(path: string, variable: string): string {
  try {
    return readFileSync(path, "utf8");
  } catch (error) {
    const code = (error as { code?: unknown } | null)?.code;
    throw new Error(
      `Unreadable CA file ${variable}${typeof code === "string" && /^E[A-Z]+$/.test(code) ? ` (${code})` : ""}`,
    );
  }
}

/** A cache tile's endpoint from the process's environment (`<ID>` the tile ID upper-cased, `-` as
 * `_`), read when its client is built: `JEEVES_CACHE_<ID>_HOST`, `_PORT` and `_TLS` (`disable` or
 * `verify-full`); with `verify-full`, optionally `_CA_FILE` (a PEM file, else Node's roots) and
 * `_TLS_SERVERNAME` (the name the certificate carries when it isn't the host, by the host rule).
 * There is no
 * default: a missing or invalid value fails naming the variable, never the value. With
 * `JEEVES_REQUIRE_TLS=true`, `disable` fails `Insecure endpoint JEEVES_CACHE_<ID>_TLS`. */
export function cacheEndpoint(cache: string): { hostname: string; port: number; tls: CacheTls } {
  const name = (part: string) => `JEEVES_CACHE_${cache.toUpperCase().replace(/-/g, "_")}_${part}`;
  const hostname = process.env[name("HOST")];
  if (hostname === undefined || !validHost(hostname))
    throw new Error(`Invalid endpoint ${name("HOST")}`);
  const port = process.env[name("PORT")];
  if (port === undefined || !/^[1-9][0-9]{0,4}$/.test(port) || !validPort(Number(port)))
    throw new Error(`Invalid endpoint ${name("PORT")}`);
  const strict = requireTls();
  const mode = process.env[name("TLS")];
  if (mode !== "disable" && mode !== "verify-full") throw new Error(`Invalid endpoint ${name("TLS")}`);
  if (mode === "disable") {
    if (strict) throw new Error(`Insecure endpoint ${name("TLS")}`);
    return { hostname, port: Number(port), tls: { mode } };
  }
  const servername = process.env[name("TLS_SERVERNAME")];
  if (servername !== undefined && !validHost(servername))
    throw new Error(`Invalid endpoint ${name("TLS_SERVERNAME")}`);
  const caFile = process.env[name("CA_FILE")];
  return {
    hostname,
    port: Number(port),
    tls: {
      mode,
      ...(caFile !== undefined && { ca: readCa(caFile, name("CA_FILE")) }),
      ...(servername !== undefined && { servername }),
    },
  };
}

/** Optional-cache startup failure does not prevent readiness. Required consumers must fail
 * closed on every rejected decision. No offline queue, driver reconnect or mutation replay.
 * At most 32 actual commands remain unsettled, even after caller timeout; replies are bounded
 * to 150 ms. Lost/stalled connections reconnect after 5 s (connect bound 500 ms), one generation
 * at a time. A stuck actual connect prevents accumulating further attempts. Queue saturation and
 * server error replies leave healthy clients connected. Lifecycle cancellation closes the client. */
export async function createValkeyCache(options: {
  binding: ValkeyBinding;
  credential?: (secret: string) => string;
  onState?: (state: "available" | "unavailable", error?: unknown) => void;
}): Promise<ValkeyCache> {
  assertNetworkAllowed();
  assertOperation();
  const operationScope = currentProcess();
  const { hostname, port, secret, tls } = options.binding;
  if (!validHost(hostname) || !validPort(port)) throw new Error("Invalid cache endpoint");
  const password = (options.credential ?? readSecret)(secret);
  const tcp = { host: hostname, port, connectTimeout: 500, reconnectStrategy: false as const };
  const socket = tls?.mode === "verify-full" ? {
    ...tcp, tls: true as const, rejectUnauthorized: true,
    ...(tls.ca !== undefined && { ca: tls.ca }),
    ...(tls.servername !== undefined && { servername: tls.servername }),
  } : tcp;
  const open = () => createClient({ password, disableOfflineQueue: true, commandsQueueMaxLength: MAX_PENDING, socket });
  type Generation = { client: ReturnType<typeof open>; ready: boolean };
  let current: Generation | undefined;
  let retry: ReturnType<typeof setTimeout> | undefined;
  let closed = false;
  let connecting = false;
  let pending = 0;
  let reported: "available" | "unavailable" | undefined;
  const report = (state: "available" | "unavailable", error?: unknown) => {
    if (state === reported) return;
    reported = state;
    try { options.onState?.(state, error); } catch { /* Reporting cannot change cache behavior. */ }
  };
  const destroy = (generation: Generation) => {
    try { generation.client.destroy(); } catch { /* Already destroyed. */ }
  };
  const close = () => {
    if (closed) return;
    closed = true;
    clearTimeout(retry);
    retry = undefined;
    operationScope?.signal.removeEventListener("abort", close);
    if (current) destroy(current);
    current = undefined;
  };
  const retryLater = () => {
    if (closed || retry) return;
    retry = setTimeout(() => {
      retry = undefined;
      if (connecting) retryLater();
      else if (!closed) connect().catch(retryLater);
    }, 5000);
    retry.unref?.();
  };
  const lose = (generation: Generation, error: unknown) => {
    if (closed || generation !== current) return;
    current = undefined;
    destroy(generation);
    report("unavailable", error);
    retryLater();
  };
  async function connect() {
    if (closed || connecting) return;
    const generation: Generation = { client: open(), ready: false };
    generation.client.on("error", (error: unknown) => lose(generation, error));
    generation.client.on("end", () => lose(generation, failure("definite-failure", "CACHE_DISCONNECTED")));
    current = generation;
    try {
      await dependency({ scope: operationScope, maximumMs: 500, deadlineMessage: "Cache deadline" }, () => {
        connecting = true;
        try { return generation.client.connect().finally(() => { connecting = false; }); }
        catch (error) { connecting = false; throw error; }
      });
    } catch (error) {
      lose(generation, error);
      return;
    }
    if (closed || generation !== current) { destroy(generation); return; }
    generation.ready = true;
    report("available");
  }
  operationScope?.signal.addEventListener("abort", close, { once: true });
  await connect();
  const command = async <T>(
    effect: (client: Generation["client"]) => Promise<unknown>,
    parse: (reply: unknown) => T,
    mutation = false,
    coordination = false,
  ): Promise<T> => {
    // Admission changes only private generated coordination state. Product read-like admission
    // may use it; arbitrary cache writes still require mutation authority. Local/pure scopes deny
    // all network, and mutation=true below still makes lost replies UNKNOWN.
    assertNetworkAllowed(mutation && !coordination);
    assertOperation();
    const generation = current;
    if (closed || !generation?.ready) throw failure("refused", "CACHE_UNAVAILABLE", "Cache unavailable");
    if (pending >= MAX_PENDING) throw failure("refused", "CACHE_SATURATED");
    try {
      return await dependency({ scope: operationScope, maximumMs: 150, mutation, deadlineMessage: "Cache deadline" }, () => {
        pending += 1;
        // Hold the slot AND lifecycle tracking until actual settlement, not the caller's race.
        let work: Promise<unknown>;
        try { work = effect(generation.client); }
        catch (error) { work = Promise.reject(error); }
        return work.catch((error: unknown) => {
          // Pinned node-redis rejects this before adding a command to its wire queue.
          if (!(error instanceof ErrorReply) && error instanceof Error && error.message === "The queue is full")
            throw failure("refused", "CACHE_SATURATED");
          // Lua errors may follow partial script effects; mutation outcome stays unknown.
          if (error instanceof ErrorReply) throw failure(mutation ? "unknown" : "definite-failure", "CACHE_COMMAND_FAILED");
          throw error;
        }).then((reply) => {
          try { return parse(reply); }
          catch { throw failure(mutation ? "unknown" : "definite-failure", "CACHE_REPLY_INVALID"); }
        }).finally(() => { pending -= 1; });
      });
    } catch (error) {
      // Refusals, bad application/server replies and overload are not broken connectivity.
      if (!(error instanceof OperationError) || ["INTERRUPTED", "DEPENDENCY_FAILED", "DISPATCH_FAILED"].includes(error.code))
        lose(generation, error);
      throw error;
    }
  };
  const stringReply = (reply: unknown) => {
    if (reply !== null && !validValue(reply)) throw Error("Invalid cache value");
    return reply as string | null;
  };
  return {
    get: async (key) => { keyInput(key); return command((client) => client.get(key), stringReply); },
    set: async (key, value, expiry) => {
      keyInput(key);
      if (!validValue(value) || (expiry !== undefined && !("PXAT" in expiry ? validUntil(expiry.PXAT) : Number.isSafeInteger(expiry.EX) && expiry.EX > 0 && expiry.EX <= 604800)))
        throw failure("refused", "INVALID_CACHE_VALUE");
      return command((client) => client.set(key, value, expiry), (reply) => {
        if (reply !== "OK") throw Error("Invalid SET reply");
        return reply;
      }, true);
    },
    delete: async (key) => { keyInput(key); return command((client) => client.del(key), (reply) => {
      if (reply !== 0 && reply !== 1) throw Error("Invalid DEL reply");
      return reply;
    }, true); },
    ping: () => command((client) => client.ping(), (reply) => {
      if (reply !== "PONG") throw Error("Invalid PING reply");
      return reply;
    }),
    admit: async (key, policy) => {
      keyInput(key);
      const { limit, windowMs } = policy;
      if (!Number.isSafeInteger(limit) || limit < 1 || limit > 10000 || !Number.isSafeInteger(windowMs) || windowMs < 1 || windowMs > MAX_LIFETIME)
        throw failure("refused", "INVALID_CACHE_WINDOW");
      return command((client) => client.eval(ADMIT_WINDOW, { keys: [key], arguments: [String(windowMs), String(limit), randomUUID()] }), (reply) => {
        if (!Array.isArray(reply) || reply.length !== 4) throw Error("Invalid window reply");
        const [admitted, count, now, resetAt] = reply;
        if ((admitted !== 0 && admitted !== 1) || !Number.isSafeInteger(count) || count < 1 || count > limit || (admitted === 0 && count !== limit) || !validUntil(now) || !validUntil(resetAt) || resetAt <= now || resetAt > now + windowMs)
          throw Error("Invalid window reply");
        return Object.freeze({ admitted: admitted === 1, count, resetAt });
      }, true, true);
    },
    getVersioned: async (key) => {
      keyInput(key);
      const record = await command((client) => client.get(key), (reply) => {
        if (reply === null) return null;
        if (typeof reply !== "string" || Buffer.byteLength(reply) > MAX_VALUE * 6 + 256) throw Error("Invalid cache envelope");
        const r: unknown = JSON.parse(reply);
        if (!validRecord(r) || (r as {v?: unknown}).v !== 1 || r.validUntil > Date.now() + MAX_LIFETIME) throw Error("Invalid cache record");
        return Object.freeze({ version: r.version, value: r.value, validUntil: r.validUntil });
      });
      return record && record.validUntil > Date.now() ? record : null;
    },
    setIfNewer: async (key, input) => {
      keyInput(key);
      if (!validRecord(input)) throw failure("refused", "INVALID_CACHE_RECORD");
      // Snapshot once: later edits to the caller's object cannot change dispatched fields.
      const { version, value, validUntil: until } = input;
      if (until > Date.now() + MAX_LIFETIME) throw failure("refused", "INVALID_CACHE_EXPIRY");
      const encoded = JSON.stringify({ v: 1, version, value, validUntil: until });
      const status = await command((client) => client.eval(SET_IF_NEWER, { keys: [key], arguments: [encoded, version, String(until), value] }), (reply) => {
        if (reply !== 0 && reply !== 1 && reply !== 2 && reply !== 3) throw Error("Invalid compare reply");
        return (["not-newer", "stored", "expired", "version-conflict"] as const)[reply]!;
      }, true);
      return Object.freeze({ status: until <= Date.now() ? "expired" : status, validUntil: until });
    },
    close,
  };
}
