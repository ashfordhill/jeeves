/** Private generated webhook accept/store/process adapter. No product ACK or verifier hook. */
import { createHash } from "node:crypto";
import { defineWebhookInbox, validateDurableWorkBinding, type DurableWork } from "./durable-work.ts";
import type { ScopedCommands } from "./product-mutation.ts";
import { normalizedJsonDto, normalizedStripeWebhookInput } from "./hook-boundary.ts";
import { withLocalPolicy } from "./operation.ts";
import { allowWebhookRedelivery, HttpError } from "./admission.ts";
import type { HttpRoutes, HttpBodyLimit } from "./http.ts";
export interface WebhookEvent {
  readonly id: string;
  readonly type: string;
  readonly payload: unknown;
}
interface StoredEvent extends WebhookEvent { readonly contentHash: string }
declare const webhookHandle: unique symbol;
/** Opaque processing declaration; only the generated authenticated ingress can accept it. */
export interface WebhookWork { readonly [webhookHandle]: true }
type WebhookEngine = DurableWork<unknown, object>;
type SignatureFormat = "jeeves" | "stripe";
const declarations = new WeakMap<object, { jeeves: WebhookEngine; stripe(): WebhookEngine }>();
/** Private compiler bridge. Never exported through the product API. */
export function webhookWorkEngine(value: unknown, format: SignatureFormat = "jeeves") {
  const work = value && typeof value === "object" ? declarations.get(value) : undefined;
  if (!work) throw new Error("Invalid webhook declaration");
