  return handle;
}
export function validateWebhookBinding(work: unknown, properties: readonly string[], targets: readonly string[], format?: SignatureFormat) {
  if (!work || typeof work !== "object" || !declarations.has(work)) throw new Error("Webhook receiver requires defineWebhookWork; migrate explicitly");
