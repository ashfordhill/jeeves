  const { database, id, version, complete } = definition;
  const integration = definition.integration && Object.freeze({ ...definition.integration });
  if (integration && (Object.keys(integration).sort().join() !== "map,operation,target" || typeof integration.map !== "function")) throw new Error("Invalid webhook integration");
