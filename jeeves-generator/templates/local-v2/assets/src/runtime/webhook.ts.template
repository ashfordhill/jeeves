    try {
      let decoded: unknown;
      if (stripeEvent) decoded = normalizedStripeWebhookInput(stripeEvent);
      else {
        const text = bytes.toString("utf8");
        if (!Buffer.from(text, "utf8").equals(bytes)) throw new Error("Invalid UTF-8");
        decoded = normalizedJsonDto(JSON.parse(text));
      }
      mapped = withLocalPolicy(() => {
        const value = options.map(decoded);
        if (value && typeof (value as unknown as { then?: unknown }).then === "function") { void Promise.resolve(value).catch(() => {}); throw new Error("Async mapper"); }
        return event(normalizedJsonDto(value));
      });
      if (stripeEvent && (mapped.id !== stripeEvent.id || mapped.type !== stripeEvent.type))
