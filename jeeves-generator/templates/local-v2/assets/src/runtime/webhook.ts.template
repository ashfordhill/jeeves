}
/** Pure mapping is separate from this scoped product operation. Fixed retry/retention policy. */
export function defineWebhookWork<Dependencies extends object>(definition: {
  readonly database: keyof Dependencies & string;
  readonly id: string;
  readonly version: number;
  readonly integration: null | {
    readonly target: keyof Dependencies & string;
    readonly operation: string;
    map(input: Readonly<WebhookEvent>): unknown;
  };
