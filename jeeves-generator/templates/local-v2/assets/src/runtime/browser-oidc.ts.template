// Private OIDC adapter. Protocol checks belong to maintained openid-client, never product hooks.
import { AsyncLocalStorage } from "node:async_hooks";
import * as oidc from "openid-client";
import { createRemoteJWKSet, jwtVerify, customFetch as joseFetch } from "jose";
import { auth0MachineToken } from "./auth0.ts";
import { HttpError } from "./admission.ts";
import { currentProcess, dependency, OperationError } from "./operation.ts";
import { probeDependency } from "./process.ts";
import { browserSubject, type BrowserConfiguration } from "./browser-session.ts";

export function createBrowserIssuer(settings: BrowserConfiguration) {
  const scope = currentProcess();
  const health = {};
  let config: oidc.Configuration | undefined;
  let pending = 0;
  const transport = new AsyncLocalStorage<AbortSignal>();
  const unavailable = () => { scope?.dependencyReady?.(health, false); return new OperationError("definite-failure", "IDENTITY_UNAVAILABLE"); };
  // A timed-out caller cannot open another slot while the real SDK request is still pending.
  const bounded = <T>(effect: () => Promise<T>, mutation=false) => {
    if (pending >= 32) throw new OperationError("refused", "IDENTITY_SATURATED");
    pending++;
    let dispatched=false;
    return dependency({scope, maximumMs:3000, mutation, definite:()=>!mutation, preserveDefinite:true}, (signal) => {
      dispatched=true;
      let actual: Promise<T>;
      try { actual = transport.run(signal,effect); } catch (error) { actual = Promise.reject(error); }
      return actual.finally(() => { pending--; });
    }).catch(error=>{if(!dispatched)pending--;throw error;});
  };
  const customFetch: oidc.CustomFetch = async (url, options) => {
    const target = new URL(String(url));
    if (target.protocol !== "https:" || target.username || target.password ||
      (settings.provider === "auth0" && target.origin !== new URL(settings.issuer).origin))
      throw unavailable();
    const signal=AbortSignal.any([options?.signal ?? AbortSignal.timeout(3000), ...(transport.getStore() ? [transport.getStore()!] : []), ...(scope ? [scope.signal] : [])]);
    const response=await fetch(url, {...options, body:options.body as BodyInit, redirect:"error", signal});
    const maximum=262144;
    const length=response.headers.get("content-length");
    if(length && (!/^[0-9]+$/.test(length)||Number(length)>maximum)) {void response.body?.cancel().catch(()=>{});throw new Error("Issuer response exceeds bound");}
    const reader=response.body?.getReader();
    const chunks:Uint8Array[]=[];let bytes=0;
    try {
      while(reader){const next=await reader.read();if(next.done)break;bytes+=next.value.byteLength;if(bytes>maximum)throw new Error("Issuer response exceeds bound");chunks.push(next.value);}
      return new Response(Buffer.concat(chunks),{status:response.status,statusText:response.statusText,headers:response.headers});
    } catch(error){void reader?.cancel().catch(()=>{});throw error;} finally {reader?.releaseLock();}
  };
  let userKeys: ReturnType<typeof createRemoteJWKSet> | undefined;
  const discover = async () => {
    const next = await oidc.discovery(new URL(settings.issuer), settings.clientId,
      {client_secret:settings.clientSecret, id_token_signed_response_alg:"RS256"}, undefined,
      {timeout:3, [oidc.customFetch]:customFetch, execute:[oidc.enableNonRepudiationChecks]});
    const metadata=next.serverMetadata(), jwks=metadata.jwks_uri;
    if (settings.provider === "auth0" && (
      metadata.authorization_endpoint !== new URL("authorize", settings.issuer).href ||
      metadata.token_endpoint !== new URL("oauth/token", settings.issuer).href ||
      jwks !== new URL(".well-known/jwks.json", settings.issuer).href
    )) throw unavailable();
    if(jwks && (!userKeys || config?.serverMetadata().jwks_uri!==jwks))
      userKeys=createRemoteJWKSet(new URL(jwks), {timeoutDuration:3000,cacheMaxAge:60000,cooldownDuration:30000,
        [joseFetch]:(url,options)=>customFetch(url,{...options,headers:Object.fromEntries(options.headers),body:undefined})});
    config = next;
    scope?.dependencyReady?.(health,true);
    return next;
  };
  probeDependency(scope, health, async () => { await bounded(discover); });
  const required = () => { if (!config) throw unavailable(); return config; };
  const verifyAccess = async (token:string, audience:string, subject:string) => {
    required();
    if (!userKeys) throw unavailable();
    try {
      if (!token || token.length > 16384) throw new Error("Invalid user");
      const {payload}=await jwtVerify(token,userKeys,{issuer:settings.issuer,audience,algorithms:["RS256"],requiredClaims:["exp","sub"]});
      if(payload.sub!==subject || "jeeves_workload" in payload ||
        (settings.provider === "auth0" && auth0MachineToken(payload)))throw new Error("Invalid user");
    } catch(error) {
      const code=(error as {code?:string})?.code;
      if(error instanceof Error && (error.message==="Invalid user" || ["ERR_JWT_EXPIRED","ERR_JWT_CLAIM_VALIDATION_FAILED","ERR_JWT_INVALID","ERR_JWS_INVALID","ERR_JWS_SIGNATURE_VERIFICATION_FAILED","ERR_JOSE_ALG_NOT_ALLOWED","ERR_JOSE_NOT_SUPPORTED","ERR_JWKS_NO_MATCHING_KEY"].includes(code??"")))
        throw Object.assign(new HttpError(403,"SESSION_IDENTITY_INCOMPATIBLE","User identity cannot reach this recipient."),{outcome:"refused"});
      throw unavailable();
    }
  };
  return {
    async start() { try { await bounded(discover); } catch { throw unavailable(); } },
    /** A forwarded user JWT must match the exact issuer, user audience and stored subject. */
    async verifyAccess(token:string,audience:string,subject:string) {
      await bounded(()=>verifyAccess(token,audience,subject));
    },
    async authorize(input: {state:string;nonce:string;verifier:string}) {
      const parameters: Record<string,string> = {redirect_uri:settings.callback, response_type:"code", scope:settings.offlineAccess ? "openid profile email offline_access" : "openid profile email", state:input.state, nonce:input.nonce,
        code_challenge:await oidc.calculatePKCECodeChallenge(input.verifier), code_challenge_method:"S256"};
      if (settings.audience) parameters.audience = settings.audience;
      return oidc.buildAuthorizationUrl(required(), parameters).href;
    },
    async refresh(refreshToken:string,subject:string) {
      return bounded(async()=>{
        let tokens:Awaited<ReturnType<typeof oidc.refreshTokenGrant>>;
        try {tokens=await oidc.refreshTokenGrant(required(),refreshToken);}
        catch(error){
          // The pinned SDK preserves a nonconforming HTTP status as its Response cause
          // (oauth4webapi parses OAuth error bodies only for4xx). Known429/5xx is outage.
          if(error instanceof oidc.ClientError && error.code==="OAUTH_RESPONSE_IS_NOT_CONFORM" && error.cause instanceof Response &&
            (error.cause.status===429 || (error.cause.status>=500 && error.cause.status<=599))){
            scope?.dependencyReady?.(health,false);
            throw new OperationError("definite-failure","IDENTITY_UNAVAILABLE");
          }
          if(error instanceof oidc.ResponseBodyError){
            if([400,401,403].includes(error.status)&&error.error==="invalid_grant")
              throw Object.assign(new HttpError(401,"SIGN_IN_REQUIRED","Sign in to continue."),{outcome:"refused"});
            // A well-formed OAuth refusal (including429/5xx/invalid_client) did not issue new
            // tokens. Network/malformed/unfamiliar responses may have lost a successful rotation.
            scope?.dependencyReady?.(health,false);
            throw new OperationError("definite-failure","IDENTITY_UNAVAILABLE");
          }
          scope?.dependencyReady?.(health,false);
          throw new OperationError("unknown","SESSION_REFRESH_UNKNOWN");
        }
        const claims=tokens.claims();
        if(claims && (claims.sub!==subject || "jeeves_workload" in claims ||
          (settings.provider === "auth0" && auth0MachineToken(claims))))
          throw Object.assign(new HttpError(401,"SIGN_IN_REQUIRED","Sign in to continue."),{outcome:"refused"});
        const material=(value:unknown)=>typeof value==="string"&&value.length>0&&Buffer.byteLength(value)<=16384;
        if(!material(tokens.access_token) || (tokens.refresh_token!==undefined&&!material(tokens.refresh_token)) ||
          (tokens.id_token!==undefined&&!material(tokens.id_token)) || !Number.isFinite(tokens.expires_in) || tokens.expires_in!<=20 || tokens.expires_in!>604800)
          throw new OperationError("unknown","SESSION_REFRESH_UNKNOWN");
        if (settings.provider === "auth0") {
          // A successful grant may have consumed the old credential even when its result is unsafe.
          if (settings.offlineAccess && (!tokens.refresh_token || tokens.refresh_token === refreshToken))
            throw new OperationError("unknown","SESSION_REFRESH_UNKNOWN");
          try {
            await verifyAccess(tokens.access_token, settings.audience!, subject);
          } catch {
            throw new OperationError("unknown","SESSION_REFRESH_UNKNOWN");
          }
        }
        scope?.dependencyReady?.(health,true);
        return {access:tokens.access_token,refresh:tokens.refresh_token??null,id:tokens.id_token??null,expiresIn:tokens.expires_in!};
      },true);
    },
    async exchange(url: URL, input:{state:string;nonce:string;verifier:string}) {
      try {
        const tokens = await bounded(async () => {
          try {return await oidc.authorizationCodeGrant(required(), url,
            {expectedState:input.state,expectedNonce:input.nonce,pkceCodeVerifier:input.verifier,idTokenExpected:true});}
          catch(error) {
            // Positive, pinned SDK authentication failures only. Invalid provider documents,
            // unfamiliar codes, transport errors,429 and5xx remain dependency/unknown failures.
            const cause=error instanceof Error ? error.cause as {cause?:unknown}|undefined : undefined;
            const detail=cause?.cause as {parameters?:unknown;signature?:unknown;key?:unknown}|undefined;
            const knownInvalid=error instanceof oidc.ClientError && error.code==="OAUTH_INVALID_RESPONSE" &&
              (detail?.parameters instanceof URLSearchParams || (detail?.signature instanceof Uint8Array && detail?.key instanceof CryptoKey));
            if((error instanceof oidc.AuthorizationResponseError && ["access_denied","login_required","interaction_required","consent_required"].includes(error.error)) ||
              (error instanceof oidc.ResponseBodyError && [400,401,403].includes(error.status) && error.error==="invalid_grant") ||
              (error instanceof oidc.ClientError && ["OAUTH_JWT_CLAIM_COMPARISON_FAILED","OAUTH_JWT_TIMESTAMP_CHECK_FAILED"].includes(error.code??"")) || knownInvalid)
              throw Object.assign(new HttpError(401,"SIGN_IN_REQUIRED","Sign in to continue."),{outcome:"refused"});
            throw error;
          }
        }, true);
        const claims = tokens.claims();
        if (!claims || !browserSubject(claims.sub) || "jeeves_workload" in claims ||
          (settings.provider === "auth0" && auth0MachineToken(claims)))
          throw Object.assign(new HttpError(401,"SIGN_IN_REQUIRED","Sign in to continue."),{outcome:"refused"});
        if (settings.provider === "auth0") {
          const subject = claims.sub;
          try {
            await bounded(()=>verifyAccess(tokens.access_token, settings.audience!, subject));
          } catch (error) {
            if (error instanceof HttpError && error.statusCode === 403)
              throw Object.assign(new HttpError(401,"SIGN_IN_REQUIRED","Sign in to continue."),{outcome:"refused"});
            throw error;
          }
          if (settings.offlineAccess && !tokens.refresh_token)
            throw unavailable();
        }
        const profile = (value:unknown) => typeof value === "string" ? value.slice(0,320) : null;
        return {subject:claims.sub, email:profile(claims.email), name:profile(claims.name),
          access:tokens.access_token, refresh:tokens.refresh_token ?? null, id:tokens.id_token ?? null,
          expiresIn:tokens.expires_in ?? null};
      } catch (error) {
        if(error instanceof HttpError)throw error;
        if (error instanceof OperationError) {scope?.dependencyReady?.(health,false);throw error;}
        throw unavailable();
      }
    },
  };
}
export type BrowserIssuer = ReturnType<typeof createBrowserIssuer>;
