import { dependency, currentProcess, assertOperation, OperationError, withProcess } from "./operation.ts";
import { checkServerIdentity, type PeerCertificate } from "node:tls";
import pg from "pg";
import { readSecret, type SqlLogin } from "./local.ts";

/** How a pool reaches its database (QG10). `disable`: plain TCP or a Unix socket, and `pg` gets
 * `ssl: false`, so `PGSSLMODE` can't change it. `verify-full`: TLS that checks the server's
 * certificate chain against `ca` (PEM; else Node's roots) and its name against the host, or
 * against `servername` when the certificate carries another name (a managed instance reached by a
 * private address). No value turns verification off. */
export type DatabaseTls =
  | { mode: "disable" }
  | { mode: "verify-full"; ca?: string; servername?: string };

/** `pg`'s `ssl` for a transport. `pg` sends a host name as the TLS server name and checks it, so a
 * given `servername` is checked by `checkServerIdentity` itself. */
export function postgresSsl(tls: DatabaseTls) {
  if (tls.mode !== "verify-full") return false as const;
  const { ca, servername } = tls;
  return {
    rejectUnauthorized: true,
    ...(ca !== undefined && { ca }),
    ...(servername !== undefined && {
      servername,
      checkServerIdentity: (_host: string, certificate: PeerCertificate) =>
        checkServerIdentity(servername, certificate),
    }),
  };
}

/** Use the exact foundation login, never compose names in a domain adapter. The plan's
 * login.host is the application host; hostname is the explicit database network endpoint. */
export function createPostgres(options: {
  hostname: string;
  port: number;
  tls: DatabaseTls;
  login: Pick<SqlLogin, "database" | "user" | "secret">;
  poolSize: number;
  statementTimeoutMs: number;
  connectionTimeoutMs: number;
  credential?: (secret: string) => string;
}) {
  const operationScope = currentProcess();
  const sqlFailure = (error: unknown) => {
    const code = (error as { code?: unknown })?.code;
    return (
      typeof code === "string" && /^(?!08|57P0)[0-9A-Z]{5}$/.test(code) && !/^E[A-Z]+$/.test(code)
    );
  };
  const pool = new pg.Pool({
    host: options.hostname,
    port: options.port,
    ssl: postgresSsl(options.tls),
    database: options.login.database,
    user: options.login.user,
    password: (options.credential ?? readSecret)(options.login.secret),
    max: options.poolSize,
    statement_timeout: options.statementTimeoutMs,
    // The server enforces statement_timeout (57014); one that stops answering can't. 500 ms later
    // the client rejects "Query read timeout" and the pool discards that connection.
    query_timeout: options.statementTimeoutMs + 500,
    connectionTimeoutMillis: options.connectionTimeoutMs,
  });
  const readiness = {};
  let closed = false, probing = false;
  let retry: ReturnType<typeof setTimeout> | undefined;
  const recovered = () => {
    if (closed) return;
    operationScope?.dependencyReady?.(readiness, true);
    schedule();
  };
  const unavailable = () => {
    if (!operationScope?.dependencyReady || closed || operationScope.signal.aborted) return;
    operationScope.dependencyReady(readiness, false);
    schedule();
  };
  const schedule = () => {
    if (!operationScope?.dependencyReady || closed || operationScope.signal.aborted) return;
    if (retry || probing) return;
    // One fixed safe health probe, including idle processes with no remaining pooled socket.
    // Never retry a business query. The budget is independent of any originating request.
    retry = setTimeout(() => withProcess(operationScope, () => {
      retry = undefined;
      if (closed || operationScope.signal.aborted) return;
      probing = true;
      const probe = { text: "SELECT 1", query_timeout: 2000 };
      const work = pool.query(probe).then(recovered, () => {
        operationScope.dependencyReady?.(readiness, false);
      }).finally(() => { probing = false; schedule(); });
      operationScope.track?.(work);
      void work.catch(() => {});
    }), 5000);
    retry.unref?.();
  };
  operationScope?.admission?.(() => { closed = true; clearTimeout(retry); retry = undefined; });
  // pg-pool observes idle-client errors only. Observe checked-out errors once per physical
  // client too; query rejection/unknown/discard and the pool's idle error handling stay intact.
  pool.on("connect", (client) => { recovered(); client.on("error", unavailable); });
  pool.on("error", unavailable);
  schedule();
  return new Proxy(pool, {
    get(target, key) {
      if (key === "connect") return async () => {
        try { return await target.connect(); }
        catch (error) { unavailable(); throw error; }
      };
      if (key === "query")
        return (sql: string, values?: unknown[]) =>
          dependency(
            {
              scope: operationScope,
              maximumMs: options.statementTimeoutMs,
              mutation: true,
              definite: sqlFailure,
            },
            async () => {
              const client = await target.connect().catch((error: unknown) => {
                unavailable();
                throw new OperationError("definite-failure", "DATABASE_CONNECT_FAILED", {
                  cause: error,
                });
              });
              let sent = false,
                discard = false;
              try {
                assertOperation();
                sent = true;
                return await client.query(sql, values);
              } catch (error) {
                discard = sent && !sqlFailure(error);
                if (discard) unavailable();
                throw error;
              } finally {
                client.release(discard);
              }
            },
          );
      const value = Reflect.get(target, key);
      return typeof value === "function" ? value.bind(target) : value;
    },
  });
}
