// Private generated browser authority. No tokens, cookies, SQL handles or clock seams in hooks.
import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
import type { FastifyReply, FastifyRequest } from "fastify";
import { HttpError } from "./admission.ts";
import type { HttpRoutes } from "./http.ts";
import type { TileGuard, Caller, SignIn } from "./tile-guard.ts";
import type { SigningKeys, SealingKeys } from "./keys.ts";
import { transaction, type TransactionPool } from "./transaction.ts";
import { assertOperation, operation, withOperation } from "./operation.ts";
import { periodic, type ProcessScope } from "./process.ts";
import type { BrowserIssuer } from "./browser-oidc.ts";
import { browserRefresh } from "./browser-refresh.ts";

export interface BrowserConfiguration {
  issuer:string; clientId:string; clientSecret:string; callback:string; origin:string;
  audience?:string; offlineAccess:boolean; signIn:SignIn; idleSeconds:number; absoluteSeconds:number;
  guestContext:boolean; keys:{seal:SealingKeys;sign:SigningKeys};
}
const token = () => randomBytes(32).toString("base64url");
const valid = (v:unknown):v is string => typeof v === "string" && /^[A-Za-z0-9_-]{43}$/.test(v);
const hash = (v:string) => createHash("sha256").update(v).digest("hex");
export const browserSubject = (v:unknown):v is string => typeof v==="string" && v.length>0 && Buffer.byteLength(v)<=255 && !/[\p{Cc}]/u.test(v) && Buffer.from(v).toString("utf8")===v;
const refused = () => new HttpError(401,"SIGN_IN_REQUIRED","Sign in to continue.");
const invalid = () => new HttpError(400,"INVALID_REQUEST","Invalid request.");
export function safeReturnPath(value:unknown):string {
  if (value === undefined) return "/";
  // Forbid URL-normalization tricks, encoded separators/controls and fragments; bound before decode.
  if (typeof value !== "string" || Buffer.byteLength(value)>1024 || !/^\/(?!\/)/.test(value) || /[\\#\s\p{Cc}]/u.test(value) || /%(?:2f|5c|0[0-9a-f]|1[0-9a-f]|7f|25)/i.test(value)) throw invalid();
  let decoded:string;
  try { decoded=decodeURIComponent(value); } catch { throw invalid(); }
  if (/[\\\s\p{Cc}]/u.test(decoded) || decoded.split(/[/?]/).some(p=>p===".." || p===".")) throw invalid();
  const url = new URL(value,"https://return.invalid");
  if (url.origin!=="https://return.invalid" || url.pathname.startsWith("//")) throw invalid();
  return value;
}
function cookie(request:FastifyRequest,name:string):string|undefined {
  const raw=request.headers.cookie;
  if (raw===undefined) return;
  if (typeof raw!=="string" || raw.length>16384) throw refused();
  const values=raw.split(";").map(x=>x.trim()).filter(x=>x.startsWith(name+"="));
  if (values.length>1) throw refused();
  return values[0]?.slice(name.length+1);
}
const equal = (a:string,b:string) => {const x=Buffer.from(a),y=Buffer.from(b);return x.length===y.length && timingSafeEqual(x,y);};
const unsafe = (method:string) => !["GET","HEAD","OPTIONS"].includes(method);
export function createBrowserSession(options:{namespace:string;module:string;scope?:ProcessScope;pool:TransactionPool;settings:BrowserConfiguration;issuer:BrowserIssuer}) {
  const {namespace,settings:s,pool,issuer}=options;
  const scope=options.scope;
  const authority=hash(JSON.stringify([s.issuer,s.clientId]));
  const prefix=`__Host-jeeves-${options.module}`;
  const names={session:`${prefix}-session`,login:`${prefix}-login`,guest:`${prefix}-guest`};
  const base=`/modules/${options.module}`;
  const routes={login:`${base}/login`,callback:`${base}/callback`,logout:`${base}/logout`,session:`${base}/session`};
  const calls=new WeakMap<FastifyRequest,Promise<Caller>>();
  const write=(reply:FastifyReply,name:string,value:string,maxAge:number) => {
    const previous=reply.getHeader("Set-Cookie");
    const list=typeof previous==="string"?[previous]:Array.isArray(previous)?previous.map(String):[];
    reply.header("Set-Cookie",[...list,`${name}=${value}; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=${maxAge}`]);
  };
  const clear=(reply:FastifyReply,name:string)=>write(reply,name,"",0);
  const bind=(context:string)=>({scope:hash(JSON.stringify([namespace,authority])),context});
  const coordinateRefresh=browserRefresh();
  const csrf=(value:string)=>s.keys.sign.sign("csrf",bind(`csrf:${hash(value)}:${s.origin}`));
  const guest=(request:FastifyRequest):string|undefined=>{
    const value=cookie(request,names.guest);
    if (value===undefined) return;
    if (!s.guestContext) throw refused();
    const plain=s.keys.sign.verify(value,bind("guest"));
    if (!plain) throw refused();
    const parts=plain.split(":");
    if (parts.length!==2 || !valid(parts[0]) || !/^[0-9]{13}$/.test(parts[1]!) || Number(parts[1])<=Date.now()) throw refused();
    return value;
  };
  const checkCsrf=(request:FastifyRequest,context:string)=>{
    const header=request.headers["x-csrf-token"];
    if (request.headers.origin!==s.origin || typeof header!=="string" || header.length>24576 ||
      s.keys.sign.verify(header,bind(`csrf:${hash(context)}:${s.origin}`))!=="csrf") throw new HttpError(403,"CSRF_REQUIRED","Request refused.");
  };
  const lookup=async(request:FastifyRequest,reply?:FastifyReply):Promise<Caller>=>{
    if (request.headers.authorization!==undefined) throw refused(); // no mixed bearer/cookie authority
    let supplied:string|undefined;
    try {supplied=cookie(request,names.session);} catch(error) {if(reply)clear(reply,names.session);throw error;}
    if (supplied===undefined) {const value=guest(request);return {signedIn:false,...(value?{guest:Object.freeze({id:hash(value)})}:{})};}
    if (!valid(supplied)) {if(reply)clear(reply,names.session);throw refused();}
    const cookieHash=hash(supplied);
    const result=await transaction(pool,async tx=>{
      const {rows}=await tx.query<{subject:string;email:string|null;name:string|null;access_sealed:string|null}>(`UPDATE jeeves.browser_sessions SET last_seen_at=clock_timestamp()
        WHERE namespace=$1 AND cookie_hash=$2 AND authority=$3 AND revoked_at IS NULL AND absolute_expires_at>clock_timestamp()
        AND last_seen_at + idle_seconds * interval '1 second'>clock_timestamp() RETURNING subject,email,name,access_sealed`,[namespace,cookieHash,authority]);
      if(rows[0]?.access_sealed && s.keys.seal.open(rows[0].access_sealed,bind(`session:${cookieHash}:access`))!==undefined)return rows[0];
      await tx.query(`UPDATE jeeves.browser_sessions SET revoked_at=clock_timestamp(),access_sealed=NULL,refresh_sealed=NULL,id_sealed=NULL WHERE namespace=$1 AND cookie_hash=$2 AND revoked_at IS NULL`,[namespace,cookieHash]);
      return null;
    });
    if (!result) {if(reply)clear(reply,names.session);throw refused();}
    guest(request); // declared guest state must also be valid when supplied alongside a session
    return Object.freeze({signedIn:true,principal:Object.freeze({subject:result.subject,claims:Object.freeze({sub:result.subject,email:result.email,name:result.name})})});
  };
  const resolve=(request:FastifyRequest,reply?:FastifyReply)=>{assertOperation();let call=calls.get(request);if(!call){call=lookup(request,reply).catch(error=>{if(reply && error instanceof HttpError && error.statusCode===401){clear(reply,names.session);clear(reply,names.guest);}throw error;});calls.set(request,call);}return call;};
  const guard:TileGuard={caller:request=>resolve(request),async require(request){const who=await resolve(request);if(!who.signedIn)throw refused();return who.principal;}};
  const protect=async(request:FastifyRequest,reply:FastifyReply,required:boolean)=>{
    const who=await resolve(request,reply);
    if(required && !who.signedIn)throw refused();
    if(unsafe(request.method)) {
      const session=cookie(request,names.session),g=guest(request);
      // Stateful routes never use an unbound guest context. Bootstrap through GET session first.
      if(s.guestContext && !session && !g) throw new HttpError(403,"CSRF_REQUIRED","Request refused.");
      if(session)checkCsrf(request,session);
      else if(g)checkCsrf(request,g); // authenticated routes use only their session identity context
    }
    return who;
  };
  const sweep=()=>transaction(pool,async tx=>{
    await tx.query(`DELETE FROM jeeves.browser_logins WHERE (namespace,state_hash) IN (SELECT namespace,state_hash FROM jeeves.browser_logins WHERE namespace=$1 AND expires_at<=clock_timestamp() ORDER BY expires_at LIMIT 100 FOR UPDATE SKIP LOCKED)`,[namespace]);
    await tx.query(`DELETE FROM jeeves.browser_sessions WHERE (namespace,cookie_hash) IN (SELECT namespace,cookie_hash FROM jeeves.browser_sessions WHERE namespace=$1 AND (absolute_expires_at<=clock_timestamp() OR revoked_at IS NOT NULL) ORDER BY absolute_expires_at LIMIT 100 FOR UPDATE SKIP LOCKED)`,[namespace]);
  });
  return {
    ...guard,
    signIn:s.signIn,
    /** Private generated token-availability boundary. Local identity lookup never needs refresh.
     * No HTTP route or product capability exposes it; forwarding is not implemented here. */
    async refresh(request:FastifyRequest){
      assertOperation();
      if(request.headers.authorization!==undefined)throw refused();
      const value=cookie(request,names.session);
      if(!valid(value))throw refused();
      const cookieHash=hash(value);
      const row=await coordinateRefresh({pool,namespace,authority,cookieHash,settings:s,issuer,binding:field=>bind(`session:${cookieHash}:${field}`)});
      if(!row)throw refused();
      return Object.freeze({signedIn:true,principal:Object.freeze({subject:row.subject,claims:Object.freeze({sub:row.subject,email:row.email,name:row.name})})});
    },
    routes(open:HttpRoutes):HttpRoutes{return {route({handler,...route}){open.route({...route,async handler(request,reply){await protect(request,reply,s.signIn==="required");return handler.call(this,request,reply);}});}};},
    async start(){
      await transaction(pool,async tx=>{
        await tx.query("SELECT namespace,authority,cookie_hash,subject,access_sealed,refresh_sealed,id_sealed,idle_seconds,refresh_generation,refresh_uncertain FROM jeeves.browser_sessions LIMIT 0");
        await tx.query("SELECT namespace,authority,state_hash,binding_hash,sealed,expires_at FROM jeeves.browser_logins LIMIT 0");
        const {rows}=await tx.query<{allowed:boolean}>(`SELECT bool_and(has_table_privilege(current_user,relation,privilege)) AS allowed FROM unnest(ARRAY['jeeves.browser_sessions','jeeves.browser_logins']) AS relation CROSS JOIN unnest(ARRAY['SELECT','INSERT','UPDATE','DELETE']) AS privilege`);
        if(!rows[0]?.allowed)throw new Error("Missing browser session grants");
      });
      await issuer.start();
      if(scope)periodic(scope,async()=>{
        const execution=operation({maximumMs:5000,signals:[scope.signal]});
        try {await withOperation(execution.context,sweep);}
        catch {console.error(JSON.stringify({event:"browser-maintenance-failed",module:options.module,operation:"session-maintenance",requestId:execution.context.requestId,correlationId:execution.context.correlationId}));}
        finally {execution.close();}
      },15000);
    },
    mount(open:HttpRoutes){
      open.route({method:"GET",url:routes.login,handler:async(request,reply)=>{
        // A fresh login replaces its transaction binding, never reuses a supplied session ID.
        const url=new URL(request.url,"https://request.invalid");
        if([...url.searchParams.keys()].some(k=>k!=="returnTo") || url.searchParams.getAll("returnTo").length>1)throw invalid();
        const returnTo=safeReturnPath(url.searchParams.has("returnTo")?url.searchParams.get("returnTo"):undefined);
        const state=token(),nonce=token(),verifier=token(),binding=token();
        const location=await issuer.authorize({state,nonce,verifier});
        const id=hash(state);
        await transaction(pool,tx=>tx.query(`INSERT INTO jeeves.browser_logins(namespace,state_hash,binding_hash,sealed,return_to,expires_at,authority) VALUES($1,$2,$3,$4,$5,clock_timestamp()+interval '10 minutes',$6)`,[namespace,id,hash(binding),s.keys.seal.seal(JSON.stringify({state,nonce,verifier}),bind(`login:${id}`)),returnTo,authority]));
        write(reply,names.login,binding,600);
        return reply.code(302).header("Location",location).send();
      }});
      open.route({method:"GET",url:routes.callback,handler:async(request,reply)=>{
        clear(reply,names.login);
        const url=new URL(request.url,"https://request.invalid");
        const state=url.searchParams.get("state"),binding=cookie(request,names.login);
        if(!valid(state)||!valid(binding)||url.searchParams.getAll("state").length!==1)throw refused();
        const id=hash(state);
        const record=await transaction(pool,async tx=>{
          const {rows}=await tx.query<{sealed:string;return_to:string;token_origin:Date|string}>(`DELETE FROM jeeves.browser_logins WHERE namespace=$1 AND state_hash=$2 AND binding_hash=$3 AND authority=$4 AND expires_at>clock_timestamp() RETURNING sealed,return_to,clock_timestamp() AS token_origin`,[namespace,id,hash(binding),authority]);return rows[0];
        });
        if(!record)throw refused();
        const plain=s.keys.seal.open(record.sealed,bind(`login:${id}`));
        if(!plain)throw refused();
        const input=JSON.parse(plain) as {state:string;nonce:string;verifier:string};
        const callback=new URL(s.callback);callback.search=url.search;
        const identity=await issuer.exchange(callback,input);
        const value=token(),cookieHash=hash(value);
        const sealed=(field:string,material:string|null)=>material===null?null:s.keys.seal.seal(material,bind(`session:${cookieHash}:${field}`));
        const access=sealed("access",identity.access),refresh=sealed("refresh",identity.refresh),idToken=sealed("id",identity.id);
        const previous=cookie(request,names.session);
        await transaction(pool,async tx=>{
          if(previous!==undefined)await tx.query(`UPDATE jeeves.browser_sessions SET revoked_at=clock_timestamp(),access_sealed=NULL,refresh_sealed=NULL,id_sealed=NULL WHERE namespace=$1 AND cookie_hash=$2`,[namespace,hash(previous)]);
          await tx.query(`INSERT INTO jeeves.browser_sessions(namespace,authority,cookie_hash,subject,email,name,idle_seconds,absolute_expires_at,access_sealed,refresh_sealed,id_sealed,access_expires_at) VALUES($1,$12,$2,$3,$4,$5,$6,clock_timestamp()+$7*interval '1 second',$8,$9,$10,CASE WHEN $11::double precision IS NULL THEN NULL ELSE $13::timestamptz+$11*interval '1 second' END)`,[namespace,cookieHash,identity.subject,identity.email,identity.name,s.idleSeconds,s.absoluteSeconds,access,refresh,idToken,identity.expiresIn,authority,record.token_origin]);
        });
        clear(reply,names.guest);write(reply,names.session,value,s.absoluteSeconds);
        return reply.code(302).header("Location",safeReturnPath(record.return_to)).send();
      }});
      open.route({method:"GET",url:routes.session,handler:async(request,reply)=>{
        const who=await resolve(request,reply);
        const value=cookie(request,names.session);
        if(value) {clear(reply,names.guest);return {signedIn:true,subject:who.signedIn?who.principal.subject:null,csrf:csrf(value)};}
        let context=guest(request);
        if(s.guestContext && !context){context=s.keys.sign.sign(`${token()}:${Date.now()+86400000}`,bind("guest"));write(reply,names.guest,context,86400);}
        return {signedIn:false,...(context?{csrf:csrf(context)}:{})};
      }});
      open.route({method:"POST",url:routes.logout,handler:async(request,reply)=>{
        if(cookie(request,names.session)===undefined && cookie(request,names.guest)===undefined)return reply.code(204).send();
        await protect(request,reply,false);
        const value=cookie(request,names.session);
        if(value)await transaction(pool,tx=>tx.query(`UPDATE jeeves.browser_sessions SET revoked_at=clock_timestamp(),access_sealed=NULL,refresh_sealed=NULL,id_sealed=NULL WHERE namespace=$1 AND cookie_hash=$2`,[namespace,hash(value)]));
        clear(reply,names.session);clear(reply,names.guest);clear(reply,names.login);return reply.code(204).send();
      }});
    },
    /** Generated owning-service command only: no account-erasure policy or table authority. */
    async revokeSubject(subject:string){
      if(!browserSubject(subject))throw invalid();
      await transaction(pool,tx=>tx.query(`UPDATE jeeves.browser_sessions SET revoked_at=clock_timestamp(),access_sealed=NULL,refresh_sealed=NULL,id_sealed=NULL WHERE namespace=$1 AND subject=$2 AND revoked_at IS NULL`,[namespace,subject]));
    },
  };
}
