import { randomUUID } from "node:crypto";
import { NonRetryable, unreachable, type MessageHandler } from "./delivery.ts";
import { ReceiptConflict, type createReceipts } from "./receipts.ts";
import { operation, withOperation, currentProcess, withProcess } from "./operation.ts";
import type { CounterEvent } from "./event-counter.ts";
import { transaction, type TransactionPool, type Tx } from "./transaction.ts";

export interface CounterConsumer {
  close(): Promise<void>;
  closed: Promise<{ fatal: boolean }>;
}
/** Factory owns the opened YV2-05 consumer. Caller owns the pool and ends it after close.
 * Bind actual queue/failed queue/concurrency/retry and terminal handling in openConsumer. */
export async function startCounterWorker(options: {
  pool: TransactionPool;
  counter: {
    parse(input: unknown, messageId?: string): CounterEvent;
    record(tx: Tx, event: CounterEvent): Promise<boolean>;
    lifecycle?: Pick<ReturnType<typeof createReceipts>, "sweep" | "heartbeat" | "status">;
  };
  openConsumer(handle: MessageHandler): Promise<CounterConsumer>;
}) {
  const lifecycle = options.counter.lifecycle, workerId = randomUUID(), scope = currentProcess();
  let inFlight = 0;
  let state: "running" | "storage-unavailable" | "unknown" | "stopped" = "running";
  let stopping = false, timer: ReturnType<typeof setTimeout> | undefined;
  let maintenance: Promise<void> = Promise.resolve();
  // A deadline never frees this slot before the actual DB promise/connection settles.
  async function settledTransaction<T>(effect: (tx: Tx) => Promise<T>): Promise<T> {
    let actual: Promise<T> | undefined;
    try { return await transaction(options.pool, effect, { observe: (pending) => { actual = pending; } }); }
    finally { await actual?.catch(() => {}); }
  }
  async function tick(required = false) {
    if (!lifecycle) return;
    const execution = operation({ maximumMs: 5000, signals: [scope?.signal] });
    try {
      await withProcess(scope, () => withOperation(execution.context, () => settledTransaction(async (tx) => {
        await lifecycle.sweep(tx);
        await lifecycle.heartbeat(tx, { workerId, inFlight, progressed: false, state, backlog: null });
      })));
    } catch (error) {
      // Failed observation leaves the last committed heartbeat/backlog intact; it becomes stale.
      if (required) throw error;
    } finally { execution.close(); }
  }
  function schedule() {
    if (stopping || !lifecycle) return;
    timer = setTimeout(() => {
      maintenance = tick().finally(schedule);
    }, 15000);
    timer.unref?.();
  }
  const handle: MessageHandler = async (body, delivery) => {
    let event: CounterEvent;
    try {
      if (!delivery.messageId || body.byteLength > 65536) throw new Error("Invalid envelope");
      event = options.counter.parse(JSON.parse(body.toString("utf8")), delivery.messageId);
    } catch {
      throw new NonRetryable("MALFORMED_MESSAGE");
    }
    inFlight++;
    try {
      await settledTransaction(async (tx) => {
        await options.counter.record(tx, event);
        await lifecycle?.heartbeat(tx, { workerId, inFlight, progressed: true, state: "running", backlog: null });
      });
      state = "running";
    } catch (error) {
      if (error instanceof ReceiptConflict) throw new NonRetryable(error.code);
      state = (error as { outcome?: string })?.outcome === "unknown" ? "unknown" :
        unreachable(error) ? "storage-unavailable" : state;
      throw error;
    } finally { inFlight--; }
  };
  await tick(true);
  const consumer = await options.openConsumer(handle);
  schedule();
  let closing: Promise<void> | undefined;
  let finish!: (result: { fatal: boolean }) => void;
  let fatal = false;
  const closed = new Promise<{ fatal: boolean }>(resolve => { finish = resolve; });
  const worker = {
    closed,
    close(): Promise<void> {
      if (closing) return closing;
      stopping = true;
      clearTimeout(timer);
      return (closing = (async () => {
        try {
          await consumer.close();
          await maintenance;
          state = "stopped";
          await tick();
        } finally { finish({ fatal }); }
      })());
    },
  };
  void consumer.closed.then(result => { fatal ||= result.fatal; void worker.close(); });
  return worker;
}
