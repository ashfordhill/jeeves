/** A dependency that isn't provisioned locally (another provider, an Identity no sign-in binds, a
 * stub's token check, a CDN, a tile that runs no process): calling it, or any of its members,
 * answers "Not implemented: <what>". */
export function unavailable<T extends object>(what: string): T {
  const fail = () => Promise.reject(new NotImplemented(what));
  return new Proxy(fail, {
    get: (_target, property) =>
      typeof property === "string" && property !== "then" ? fail : undefined,
  }) as unknown as T;
}

/** An endpoint's variable, `JEEVES_<KIND>_<ID>_<PART>`: the tile ID upper-cased, `-` as `_`. */
const variable = (kind: string, id: string, part: string) =>
  `JEEVES_${kind}_${id.toUpperCase().replace(/-/g, "_")}_${part}`;
/** One endpoint from the process's environment, read when its client is built and before its
 * probe. There is no default: a missing or invalid value fails startup naming the variable,
 * never the value. */
function endpoint<T>(name: string, parse: (value: string) => T | undefined): T {
  const value = process.env[name];
  const parsed = value === undefined ? undefined : parse(value);
  if (parsed === undefined) throw new Error(`Invalid endpoint ${name}`);
  return parsed;
}
/** A host: 1–253 letters, digits, `.` or `-`; for a database also an absolute path (a Unix
 * socket directory, as `pg` reads it). */
const host =
  (socket = false) =>
  (value: string) =>
    /^[A-Za-z0-9.-]{1,253}$/.test(value) ||
    (socket && value.startsWith("/") && !/[\u0000-\u001f\u007f]/.test(value))
      ? value
      : undefined;
/** A port: an integer 1–65535. */
const port = (value: string) =>
  /^[1-9][0-9]{0,4}$/.test(value) && Number(value) <= 65535 ? Number(value) : undefined;
/** A URL: absolute `http:` or `https:`, with no credentials, query, fragment or whitespace (which
 * `new URL` trims, drops or encodes, so the value checked would not be the one set). */
const url = (value: string) => {
  if (/\s/.test(value)) return undefined;
  let parsed: URL;
  try {
    parsed = new URL(value);
  } catch {
    return undefined;
  }
  return (parsed.protocol === "http:" || parsed.protocol === "https:") &&
    !parsed.username &&
    !parsed.password &&
    !value.includes("?") &&
    !value.includes("#")
    ? value
    : undefined;
};

/** `JEEVES_REQUIRE_TLS` (QG10): `true` makes startup refuse a plain-text or emulator endpoint
 * (`Insecure endpoint <variable>`); absent, nothing is refused; any other value fails naming it. */
function requireTls(): boolean {
  const value = process.env.JEEVES_REQUIRE_TLS;
  if (value === undefined) return false;
  if (value !== "true") throw new Error("Invalid endpoint JEEVES_REQUIRE_TLS");
  // `0` turns off certificate checks for every client that leaves them to Node (`fetch`, the
  // sign-in's key set), so under the switch only unset or `1` passes (QG30).
  const verify = process.env.NODE_TLS_REJECT_UNAUTHORIZED;
  if (verify !== undefined && verify !== "1")
    throw new Error("Insecure endpoint NODE_TLS_REJECT_UNAUTHORIZED");
  return true;
}
/** How a client reaches a database or cache (QG10). `disable`: plain text (for a database also a
 * Unix socket). `verify-full`: TLS that checks the certificate chain against `ca` (PEM; else
 * Node's roots) and the host name, or `servername` when the certificate carries another name. */
type Transport = { mode: "disable" } | { mode: "verify-full"; ca?: string; servername?: string };
/**
 * A database's or cache's transport from the environment, read with its endpoint: `JEEVES_<KIND>_
 * <ID>_TLS`, `disable` or `verify-full`, with no default. With `verify-full`, `_CA_FILE` is an
 * optional PEM file, read now (one that can't be read fails `Unreadable CA file <variable>`), and
 * `_TLS_SERVERNAME` the optional name the certificate carries when it isn't the host (a host
 * name, by the host rule). With
 * `JEEVES_REQUIRE_TLS=true`, `disable` fails `Insecure endpoint <the _TLS variable>`, except on a
 * database's Unix socket directory, which is local transport.
 */
function transport(kind: "DATABASE" | "CACHE", id: string, hostname: string): Transport {
  const strict = requireTls();
  const name = variable(kind, id, "TLS");
  const mode = endpoint(name, (value) =>
    value === "disable" || value === "verify-full" ? value : undefined,
  );
  if (mode === "disable") {
    if (strict && !hostname.startsWith("/")) throw new Error(`Insecure endpoint ${name}`);
    return { mode };
  }
  const named = variable(kind, id, "TLS_SERVERNAME");
  const certified =
    process.env[named] === undefined ? undefined : endpoint(named, host());
  const caFile = variable(kind, id, "CA_FILE");
  const path = process.env[caFile];
  let ca: string | undefined;
  if (path !== undefined)
    try {
      ca = readFileSync(path, "utf8");
    } catch (error) {
      const code = (error as { code?: unknown } | null)?.code;
      throw new Error(
        `Unreadable CA file ${caFile}${typeof code === "string" && /^E[A-Z]+$/.test(code) ? ` (${code})` : ""}`,
      );
    }
  return {
    mode,
    ...(ca !== undefined && { ca }),
    ...(certified !== undefined && { servername: certified }),
  };
}
/** Runs every check before any client is built or probed (QG31): each reads and checks its
 * variables as its client will. One failing check fails startup with its own error; several with
 * `Invalid configuration: <message>; <message>`, in the order given, each message once. A message
 * names a variable, never its value. */
export function checkConfiguration(checks: readonly (() => unknown)[]): void {
  const failures: unknown[] = [];
  const messages: string[] = [];
  for (const check of checks)
    try {
      check();
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      if (!messages.includes(message)) {
        messages.push(message);
        failures.push(error);
      }
    }
  if (failures.length === 1) throw failures[0];
  if (failures.length) throw new Error(`Invalid configuration: ${messages.join("; ")}`);
}

/** The probe log; it names its tile, for a client's own lines after startup. */
export type ProbeLog = ((entry: Record<string, unknown>) => void) & { readonly tile: string };
/** One JSON line per client probe: `ok` once it passes, `unavailable` for a cache that is down,
 * or the error before startup fails. */
export function createProbeLog(tile: string): ProbeLog {
  return Object.assign(
    (entry: Record<string, unknown>) =>
      console.log(JSON.stringify({ event: "probe", tile, ...entry })),
    { tile },
  );
}
const describe = (error: unknown) =>
  (error instanceof Error ? `${error.name}: ${error.message}` : String(error)).slice(0, 300);
/** Runs one bounded startup check (5 s); a failure is logged and fails startup. */
async function probed(
  log: ProbeLog,
  client: { client: string; kind: string; check: string },
  check: () => Promise<unknown>,
  signal?: AbortSignal,
) {
  let timer: ReturnType<typeof setTimeout> | undefined;
  let abort: (() => void) | undefined;
  try {
    signal?.throwIfAborted();
    await Promise.race([
      check(),
      new Promise<never>((_resolve, reject) => {
        if (!signal) return;
        abort = () => reject(signal.reason);
        signal.addEventListener("abort", abort, { once: true });
      }),
      new Promise<never>((_, reject) => {
        timer = setTimeout(() => reject(new Error("Probe deadline (5 s)")), 5000);
      }),
    ]);
  } catch (error) {
    log({ level: "error", ...client, result: "failed", error: describe(error) });
    throw new Error(`Startup probe failed: ${client.kind} ${client.client}`);
  } finally {
    clearTimeout(timer);
    if (abort) signal?.removeEventListener("abort", abort);
  }
  log({ level: "info", ...client, result: "ok" });
}

// @database-start
/** A database's endpoint, `JEEVES_DATABASE_<ID>_HOST` (a host or a Unix socket directory) and
 * `_PORT`, and its transport `_TLS` (`transport`), read in that order: the configuration pass
 * checks it, and `databaseClient` reads it again as it builds its pool. */
export function databaseEndpoint(resource: string) {
  const hostname = endpoint(variable("DATABASE", resource, "HOST"), host(true));
  return {
    hostname,
    port: endpoint(variable("DATABASE", resource, "PORT"), port),
    tls: transport("DATABASE", resource, hostname),
  };
}
/** SQL a stub may not send in a transaction: `transaction` sends BEGIN, COMMIT and ROLLBACK. */
const transactionControl =
  /^\s*(?:begin|start\s+transaction|commit|end|rollback|abort|savepoint|release|prepare\s+transaction)\b/i;
/** An error's SQLSTATE: five digits or capital letters, never a Node error code such as `EPIPE`. */
function sqlState(error: unknown): string | undefined {
  const code = (error as { code?: unknown } | null)?.code;
  return typeof code === "string" && /^[0-9A-Z]{5}$/.test(code) && !/^E[A-Z]+$/.test(code)
    ? code
    : undefined;
}
/**
 * A stub's transaction (QL03): `fn` on one connection reserved from the pool, between BEGIN and
 * COMMIT (`transaction.ts`, which rolls back when `fn` throws or a statement fails). Its `Tx`
 * refuses SQL that starts with transaction control, before sending it; a `Tx` used after its
 * transaction ended rejects. A statement `fn` didn't await settles before COMMIT. A serialization
 * failure or deadlock (40001, 40P01) reruns `fn` on a new transaction 20 ms later, then 40 ms; the
 * third is rethrown. When `fn` resolved and the COMMIT then failed on the connection (SQLSTATE
 * class 08, 57P01, 57P02 or none), whether it committed is unknown: it rejects
 * `TransactionOutcomeUnknown` (`Transaction outcome unknown`, with the COMMIT's error as its
 * `cause`), never the result.
 */
async function scopedTransaction<T>(pool: TransactionPool, fn: (tx: Tx) => Promise<T>): Promise<T> {
  for (let attempt = 1; ; attempt += 1) {
    let committing = false;
    try {
      return await transaction(pool, async (scope) => {
        const sent = new Set<Promise<unknown>>();
        const send = <R>(
          sql: string,
          values: readonly unknown[] | undefined,
          answer: (result: { rows: unknown[]; rowCount: number | null }) => R,
        ): Promise<R> => {
          if (transactionControl.test(sql))
            return Promise.reject(new Error("Transaction control is owned by transaction()"));
          const result = (async () =>
            answer(await scope.query(sql, values ? [...values] : undefined)))();
          sent.add(result);
          // Its failure fails the transaction (`transaction.ts`), whether or not `fn` awaits it.
          result.catch(() => {});
          return result;
        };
        const value = await fn({
          query: <Row = Record<string, unknown>>(sql: string, values?: readonly unknown[]) =>
            send(sql, values, (result) => result.rows as Row[]),
          execute: (sql, values) =>
            send(sql, values, (result) => ({ rowCount: result.rowCount ?? 0 })),
        });
        await Promise.allSettled(sent);
        assertTransaction(scope);
        committing = true;
        return value;
      });
    } catch (error) {
      if (error instanceof OperationError) throw error;
      const state = sqlState(error);
      if (
        committing &&
        (state === undefined || state.startsWith("08") || state === "57P01" || state === "57P02")
      ) {
        const unknown = new Error("Transaction outcome unknown", { cause: error });
        unknown.name = "TransactionOutcomeUnknown";
        throw unknown;
      }
      if ((state === "40001" || state === "40P01") && attempt < 3) {
        await new Promise((resolve) => setTimeout(resolve, 20 * attempt));
        continue;
      }
      throw error;
    }
  }
}
/**
 * A stub's idempotent call (QL04), in one `scopedTransaction`: the key is checked before BEGIN
 * (`checkIdempotencyKey`), then `takeKey` takes it or finds its record. A stored answer is
 * returned `replayed` without running `fn`; a different hash rejects `IdempotencyConflict` after
 * ROLLBACK. `fn`'s 200–299 answer is stored (`storeResult`) and committed with its writes; any
 * other status rolls the transaction back and is returned, not stored.
 */
async function idempotentCall<Body>(
  pool: TransactionPool,
  record: IdempotencyRecord,
  fn: (tx: Tx) => Promise<{ status: number; body: Body }>,
): Promise<IdempotentResult<Body>> {
  // An answer that isn't stored leaves the transaction by this error, so it rolls back.
  const unstored = new Error("Idempotent answer not stored");
  const held: { answer?: { status: number; body: Body } } = {};
  try {
    return await scopedTransaction(pool, async (tx) => {
      held.answer = undefined;
      const taken = await takeKey(tx, record);
      if (!taken.taken) return { status: taken.status, body: taken.body as Body, replayed: true };
      const result = await fn(tx);
      if (!storedStatus(result.status)) {
        held.answer = result;
        throw unstored;
      }
      await storeResult(tx, record, result);
      return { status: result.status, body: result.body, replayed: false };
    });
  } catch (error) {
    const answer = held.answer;
    if (error === unstored && answer)
      return { status: answer.status, body: answer.body, replayed: false };
    throw error;
  }
}
/** Public product SQL uses separate credentials, retaining credential scope in the RG02 key. */
export function prepareProductDatabase(binding: {tile: string; resource: string; module: string; property?: string; writable?: boolean; operation?: unknown; work?: unknown; receipt?: unknown; receiptPolicy?: ReceiptRetention; owner?: string}) {
  const maximum = productDatabases.find((row) => row.resource === binding.resource);
  const login = productLogins.find((row) => row.resource === binding.resource && row.host === binding.tile);
  if (!maximum || !login) throw new Error("No scoped product SQL binding");
  const configuration = { ...databaseEndpoint(binding.resource), login, poolSize: 10, statementTimeoutMs: 2000, connectionTimeoutMs: 2000 };
  readSecret(login.secret);
  const operations = prepareProductOperations(maximum, binding);
  const local = localOperationDefinition(binding.operation, binding.property ?? "", binding.writable ?? false);
  const work = durableWorkDefinition(binding.work, binding.property ?? "", binding.writable ?? false);
  const receipt = receiptConsumerDefinition(binding.receipt, binding.property ?? "", binding.writable ?? false, binding.receiptPolicy);
  const namespace = work && durableWorkNamespace(binding.resource, binding.owner ?? binding.tile, work.work, binding.module);
  const keys = local?.definition.secret ? privateReplayKeys() : undefined;
  const runtimeLogin = localLogins.find((row) => row.resource === binding.resource && row.host === binding.tile);
  if ((local || work || receipt) && !runtimeLogin) throw new Error("Missing private replay/work database binding");
  if ((local || work || receipt) && runtimeLogin) readSecret(runtimeLogin.secret);
  return {configuration, operations, binding, local, work, receipt, namespace, keys, runtimeLogin};
}
export async function productDatabaseClient(
  scope: ProcessScope, log: ProbeLog, prepared: ReturnType<typeof prepareProductDatabase>,
) {
  const {configuration, operations, binding} = prepared;
  const pool = processClient(scope, "postgres", configuration, () => {
    const pool = ownResource(scope, createPostgres(configuration), "end");
    pool.on("error", () => {});
    return pool;
  });
  await probed(log, {client: binding.resource, kind: "database", check: "SELECT 1"}, () => pool.query("SELECT 1"), scope.signal);
  const handle = operations((sql, values, readOnly) => transaction(pool, (tx) => tx.query(sql, values), {readOnly}));
  if ((prepared.local || prepared.work || prepared.receipt) && prepared.runtimeLogin) {
    const runtimeConfiguration = {...configuration, login: prepared.runtimeLogin};
    const replayPool = processClient(scope, "postgres", runtimeConfiguration, () => {
      const client = ownResource(scope, createPostgres(runtimeConfiguration), "end");
      client.on("error", () => {});
      return client;
    });
    if (prepared.work) bindDurableWork(handle, prepared.work, {namespace: prepared.namespace!, process: binding.tile, pool: replayPool, productRole: configuration.login.user, commands: operations});
    if (prepared.receipt) await bindReceiptConsumer(handle, prepared.receipt, {
      namespace: JSON.stringify([binding.resource, binding.owner ?? binding.tile, "consumer-v1", binding.module]),
      consumerId: binding.module,
      pool: replayPool, productRole: configuration.login.user, commands: operations,
    }).ready();
    if (prepared.local) bindLocalOperation(handle, prepared.local, {...binding, productRole: configuration.login.user, pool: replayPool, keys: prepared.keys, commands: operations});
    if (prepared.local) processClient(scope, "replay-cleanup", runtimeConfiguration, () => {
      periodic(scope, async () => { await sweepExpired(replayPool); await sweepWorkTickets(replayPool); }, idempotencyPolicy.sweepSeconds * 1000,
        (error) => createFailureLog(binding.tile)("local replay cleanup", error));
      return true;
    });
  }
  return handle;
}
/** A database through the tile's own runtime login: CONNECT and USAGE on public, and SELECT on
 * what another owner publishes when the tile may only read it. A stub's own tables need its
 * product SQL; on a database a stub writes, its login also uses the Jeeves-owned
 * `jeeves.idempotency_records` (QL04). Its endpoint and transport come from `databaseEndpoint`.
 * `query` and `execute` each take a connection from the pool; `transaction`
 * (`scopedTransaction`) and `idempotent` (`idempotentCall`) reserve one for their statements. The
 * first `idempotent` call starts the sweep of expired records (`sweepExpired`): then and every
 * 60 s, owned by `scope`, so it stops at drain; a failed sweep logs an `idempotency sweep <tile>`
 * failure line. Probe: SELECT 1. */
export async function databaseClient(
  scope: ProcessScope,
  log: ProbeLog,
  binding: { tile: string; resource: string },
): Promise<DatabaseReadWriter> {
  return processClient(scope, "database-handle", binding, async () => {
  const login = localLogins.find(
    (item) => item.resource === binding.resource && item.host === binding.tile,
  );
  if (!login) throw new Error(`No runtime login for ${binding.resource}`);
  const configuration = {
    ...databaseEndpoint(binding.resource),
    login,
    poolSize: 10,
    statementTimeoutMs: 2000,
    connectionTimeoutMs: 2000,
  };
  const pool = processClient(scope, "postgres", configuration, () => {
    const pool = ownResource(scope, createPostgres(configuration), "end");
    pool.on("error", () => {});
    return pool;
  });
  let ended = false;
  scope.own(() => {
    ended = true;
    return undefined;
  });
  await probed(log, { client: binding.resource, kind: "database", check: "SELECT 1" }, () =>
    pool.query("SELECT 1"),
    scope.signal,
  );
  const run = (sql: string, values?: readonly unknown[]) =>
    dependency({ scope, mutation: true }, () => pool.query(sql, values ? [...values] : undefined));
  const failure = createFailureLog(binding.tile);
  let sweeping = false;
  const sweep = () => {
    if (sweeping || ended) return;
    sweeping = true;
    periodic(
      scope,
      () => (ended ? Promise.resolve() : sweepExpired(pool)),
      idempotencyPolicy.sweepSeconds * 1000,
      (error) => failure(`idempotency sweep ${binding.tile}`, error),
    );
  };
  return {
    async query<Row = Record<string, unknown>>(sql: string, values?: readonly unknown[]) {
      return (await run(sql, values)).rows as Row[];
    },
    async execute(sql, values) {
      return { rowCount: (await run(sql, values)).rowCount ?? 0 };
    },
    transaction: (fn) => scopedTransaction(pool, fn),
    async idempotent(request, fn) {
      checkIdempotencyKey(request);
      sweep();
      return idempotentCall(
        pool,
        { tile: binding.tile, scope: request.scope, key: request.key, hash: request.hash },
        fn,
      );
    },
  };
  });
}
