/** A dependency that isn't provisioned locally (another provider, an Identity, a CDN, an external
 * API): calling it, or any of its members, answers "Not implemented: <what>". */
export function unavailable<T extends object>(what: string): T {
  const fail = () => Promise.reject(new NotImplemented(what));
  return new Proxy(fail, {
    get: (_target, property) =>
      typeof property === "string" && property !== "then" ? fail : undefined,
  }) as unknown as T;
}

export type ProbeLog = (entry: Record<string, unknown>) => void;
/** One JSON line per client probe: `ok` once it passes, or the error before startup fails. */
export function createProbeLog(tile: string): ProbeLog {
  return (entry) => console.log(JSON.stringify({ event: "probe", tile, ...entry }));
}
const describe = (error: unknown) =>
  (error instanceof Error ? `${error.name}: ${error.message}` : String(error)).slice(0, 300);
/** Runs one bounded startup check (5 s); a failure is logged and fails startup. */
async function probed(
  log: ProbeLog,
  client: { client: string; kind: string; check: string },
  check: () => Promise<unknown>,
) {
  let timer: ReturnType<typeof setTimeout> | undefined;
  try {
    await Promise.race([
      check(),
      new Promise<never>((_, reject) => {
        timer = setTimeout(() => reject(new Error("Probe deadline (5 s)")), 5000);
      }),
    ]);
  } catch (error) {
    log({ level: "error", ...client, result: "failed", error: describe(error) });
    throw new Error(`Startup probe failed: ${client.kind} ${client.client}`);
  } finally {
    clearTimeout(timer);
  }
  log({ level: "info", ...client, result: "ok" });
}

// @database-start
/** A database through the tile's own runtime login: CONNECT and USAGE on public, and SELECT on
 * what another owner publishes when the tile may only read it. Stubs own no tables: a module's
 * own tables need a migration and grants of their own. Probe: SELECT 1. */
export async function databaseClient(
  scope: ProcessScope,
  log: ProbeLog,
  binding: { tile: string; resource: string },
): Promise<DatabaseReadWriter> {
  const login = localLogins.find(
    (item) => item.resource === binding.resource && item.host === binding.tile,
  );
  if (!login) throw new Error(`No runtime login for ${binding.resource}`);
  const pool = createPostgres({
    hostname: "local-postgres",
    port: 5432,
    login,
    poolSize: 10,
    statementTimeoutMs: 2000,
    connectionTimeoutMs: 2000,
  });
  // An idle connection's error is not fatal: the next query reconnects.
  pool.on("error", () => {});
  scope.own(() => pool.end());
  await probed(log, { client: binding.resource, kind: "database", check: "SELECT 1" }, () =>
    pool.query("SELECT 1"),
  );
  const run = (sql: string, values?: readonly unknown[]) =>
    pool.query(sql, values ? [...values] : undefined);
  return {
    async query<Row = Record<string, unknown>>(sql: string, values?: readonly unknown[]) {
      return (await run(sql, values)).rows as Row[];
    },
    async execute(sql, values) {
      return { rowCount: (await run(sql, values)).rowCount ?? 0 };
    },
  };
}
// @database-end
// @queue-start
const broker = {
  hostname: "local-broker",
  port: 5672,
  username: "runtime",
  passwordSecret: "broker-password",
  heartbeatSeconds: 10,
  confirmTimeoutMs: 5000,
};
/** A work queue or topic a module publishes to, with publisher confirms; each message gets the
 * module's `messageId`, or else a fresh ID, and `key` is not used locally. A lost broker
 * connection fails the process, as a loop's does. Probe: opening the broker and a confirm channel. */
export async function queuePublisher(
  scope: ProcessScope,
  log: ProbeLog,
  binding: { queue: string; mode: "work-queue" | "topic" },
): Promise<QueuePublisher> {
  const topic = binding.mode === "topic";
  let publisher: Awaited<ReturnType<typeof createPublisher>> | undefined;
  await probed(
    log,
    { client: binding.queue, kind: "queue", check: "open the broker and a confirm channel" },
    async () => {
      publisher = await createPublisher(
        broker,
        { exchange: topic ? binding.queue : "", routingKey: topic ? "" : binding.queue },
        { onFatal: scope.fail },
      );
    },
  );
  const opened = publisher;
  if (!opened) throw new Error(`No publisher for ${binding.queue}`);
  scope.own(() => opened.close());
  scope.transport(opened);
  return { publish: (message, options) => opened.publish(message, options?.messageId ?? randomUUID()) };
}
// @queue-end
// @cache-start
/** A cache (Valkey) with its password. While it is unreachable a command fails at once and the
 * client reconnects in the background. Probe: PING. */
export async function cacheClient(
  scope: ProcessScope,
  log: ProbeLog,
  binding: { cache: string },
): Promise<CacheClient> {
  const client = createClient({
    password: readSecret(`cache-${binding.cache}`),
    disableOfflineQueue: true,
    socket: {
      host: `cache-${binding.cache}`,
      port: 6379,
      connectTimeout: 2000,
      reconnectStrategy: (retries: number) => Math.min(100 * 2 ** retries, 2000),
    },
  });
  client.on("error", () => {});
  scope.own(() => {
    if (client.isOpen) client.destroy();
  });
  await probed(log, { client: binding.cache, kind: "cache", check: "PING" }, async () => {
    await client.connect();
    await client.ping();
  });
  return {
    async get(key) {
      return (await client.get(key)) ?? undefined;
    },
    async set(key, value, ttlSeconds) {
      await client.set(key, value, ttlSeconds ? { EX: ttlSeconds } : undefined);
    },
    async delete(key) {
      await client.del(key);
    },
  };
}
// @cache-end
// @objects-start
/** A bucket through the tile's own key (`s3-<tile>`) with its link's read, write or both. Probe:
 * HeadBucket, or for a write-only key opening and aborting a multipart upload. */
export async function objectClient(
  scope: ProcessScope,
  log: ProbeLog,
  binding: { tile: string; bucket: string; access: "read" | "write" | "read-write" },
): Promise<ObjectStore> {
  const client = createObjects({
    endpoint: "http://local-objects:3900",
    region: "garage",
    credentialSecret: `s3-${binding.tile}`,
  });
  scope.own(() => client.destroy());
  const Bucket = binding.bucket;
  const writeOnly = binding.access === "write";
  await probed(
    log,
    {
      client: Bucket,
      kind: "object-store",
      check: writeOnly ? "open and abort a multipart upload" : "HeadBucket",
    },
    async () => {
      if (!writeOnly) return client.send(new HeadBucketCommand({ Bucket }));
      const Key = `.probe/${binding.tile}`;
      const { UploadId } = await client.send(new CreateMultipartUploadCommand({ Bucket, Key }));
      return client.send(new AbortMultipartUploadCommand({ Bucket, Key, UploadId }));
    },
  );
  return {
    async get(key) {
      try {
        const object = await client.send(new GetObjectCommand({ Bucket, Key: key }));
        return object.Body ? await object.Body.transformToByteArray() : new Uint8Array();
      } catch (error) {
        if (error instanceof Error && error.name === "NoSuchKey") return undefined;
        throw error;
      }
    },
    async put(key, body, contentType) {
      await client.send(
        new PutObjectCommand({
          Bucket,
          Key: key,
          Body: body,
          ...(contentType && { ContentType: contentType }),
        }),
      );
    },
  };
}
// @objects-end
// @search-start
/** A search index on its OpenSearch service. No index is created: a module's own mapping is custom
 * work. Probe: cluster health. */
export async function searchClient(
  scope: ProcessScope,
  log: ProbeLog,
  binding: { index: string },
): Promise<SearchIndex> {
  const client = createSearch({
    endpoint: `http://search-${binding.index}:9200`,
    requestTimeoutMs: 5000,
  });
  scope.own(() => client.close());
  await probed(log, { client: binding.index, kind: "search", check: "cluster health" }, () =>
    client.cluster.health(),
  );
  const index = binding.index;
  return {
    async search<Hit = Record<string, unknown>>(query: Record<string, unknown>) {
      const result = await client.search({ index, body: query });
      return result.body.hits.hits.map((hit) => hit._source as Hit);
    },
    async index(id, document) {
      await client.index({ index, id, body: document });
    },
    async remove(id) {
      await client.delete({ index, id });
    },
  };
}
// @search-end
// @http-start
/** Another application tile's process inside the network (`http://app-<id>:3000`). It has no
 * probe and no `depends_on`: that process may start after this one. */
export function httpTarget(base: string): HttpTarget {
  return { request: (path, init) => fetch(new URL(path, base), init) };
}
// @http-end
