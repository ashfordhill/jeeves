    async get(key) {
      assertNetworkAllowed();
      try {
        return await dependency({ scope, definite: (error) => error instanceof Error && error.name === "NoSuchKey", preserveDefinite: true }, async (signal) => {
          const object = await client.send(new GetObjectCommand({ Bucket, Key: key }), { abortSignal: signal });
