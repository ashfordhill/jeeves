/** Private generated bridge. Product code never receives a transaction or lifecycle object.
 * Copies/freeze catch accidental DTO mutation; this is not a hostile-code sandbox. */
export function immutable<T>(value: T): T {
  if (value === undefined || value === null || typeof value !== "object") return value;
  const copy = structuredClone(value);
  const freeze = (item: unknown): void => {
    if (!item || typeof item !== "object" || ArrayBuffer.isView(item)) return;
    for (const child of Object.values(item)) freeze(child);
    Object.freeze(item);
  };
  freeze(copy);
  return copy;
}
const transactional = new Set(["upload.reserve", "upload.complete", "upload.closed", "failed", "job.construct", "publication.construct"]);
export function productHooks<T>(hooks: T): T {
  const wrap = (value: unknown, path: string): unknown => {
    if (typeof value === "function") return (...args: unknown[]) => {
      const bounded = transactional.has(path) ? args.slice(1) : args;
      const result = value(...bounded.map(immutable));
      if (path !== "load" && result && typeof result.then === "function") {
        // Observe an invalid async rejection without allowing its result to become policy.
        void Promise.resolve(result).catch(() => {});
        throw new Error(`Policy hook ${path} must return synchronously`);
      }
      if (path === "eligible" && typeof result !== "boolean") throw new Error("Policy hook eligible must return boolean");
      return result;
    };
    if (value && typeof value === "object") return Object.freeze(Object.fromEntries(
      Object.entries(value).map(([key, child]) => [key, wrap(child, path ? `${path}.${key}` : key)]),
    ));
    return value;
  };
  return wrap(hooks, "") as T;
}
export function productQueries(module: string) {
  return Object.freeze({ async call(_name: string, _input: readonly unknown[]): Promise<never> {
    throw new Error(`Not implemented: registered product queries for ${module}`);
  } });
}

export function bindFavoritesHooks(hooks: { eligible(itemId: string): boolean }) {
  const guarded = productHooks(hooks);
  return { eligible: async (itemId: string) => guarded.eligible(itemId) };
}

/** Finite JSON DTO validation precedes serialization and every credential/network dispatch. */
export function jsonBody(value: unknown): string | undefined {
  return jsonDto(value, 65536, 16384);
}
function jsonDto(value: unknown, maxBytes: number, maxStringBytes: number): string | undefined {
  if (value === undefined) return undefined;
  const ancestors = new Set<object>();
  let nodes = 0;
  let bytes = 0;
  const refuse = () => {
    throw new Error("Invalid JSON DTO");
  };
  const add = (length: number) => {
    bytes += length;
    if (bytes > maxBytes) refuse();
  };
  const string = (text: string, max = maxStringBytes) => {
    if (Buffer.byteLength(text) > max) refuse();
    add(Buffer.byteLength(JSON.stringify(text)));
  };
  const visit = (item: unknown, depth: number): void => {
    if (++nodes > 4096 || depth > 16) refuse();
    if (item === null) {
      add(4);
      return;
    }
    if (typeof item === "string") {
      string(item);
      return;
    }
    if (typeof item === "boolean") {
      add(item ? 4 : 5);
      return;
    }
    if (typeof item === "number" && Number.isFinite(item)) {
      add(String(item).length);
      return;
    }
    if (
      !item ||
      typeof item !== "object" ||
      ancestors.has(item) ||
      Object.getOwnPropertySymbols(item).length
    )
      return refuse();
    ancestors.add(item);
    if (Array.isArray(item)) {
      if (item.length > 1024) refuse();
      add(2 + Math.max(0, item.length - 1));
      for (let i = 0; i < item.length; i++) {
        const property = Object.getOwnPropertyDescriptor(item, String(i));
        if (!property || !("value" in property)) refuse();
        visit(property!.value, depth + 1);
      }
      if (
        Object.keys(item).length !== item.length ||
        Object.getOwnPropertyNames(item).length !== item.length + 1
      )
        refuse();
    } else {
      if (![Object.prototype, null].includes(Object.getPrototypeOf(item))) refuse();
      const keys = Object.keys(item);
      if (keys.length > 128 || Object.getOwnPropertyNames(item).length !== keys.length) refuse();
      add(2 + Math.max(0, keys.length - 1));
      for (const key of keys) {
        const property = Object.getOwnPropertyDescriptor(item, key);
        if (!property || !("value" in property)) refuse();
        string(key, 256);
        add(1);
        visit(property!.value, depth + 1);
      }
    }
    ancestors.delete(item);
  };
  visit(value, 0);
  return JSON.stringify(value);
}

/** One transport-independent JSON value: no shared references, signed zero or object-order variants.
 * Undefined root remains absent; nested undefined/accessors/non-DTOs refuse in jsonBody first. */
export function normalizedJsonDto(value: unknown): unknown {
  return normalize(value, 65536, 16384);
}
/** Only authenticated provider input may exceed the ordinary DTO byte limit. */
export function normalizedStripeWebhookInput(value: unknown): unknown {
  return normalize(value, 262144, 262144);
}
function normalize(value: unknown, maxBytes: number, maxStringBytes: number): unknown {
  const json = jsonDto(value, maxBytes, maxStringBytes);
  if (json === undefined) return undefined;
  const ordered = (item: unknown): unknown => {
    if (Array.isArray(item)) return item.map(ordered);
    if (item && typeof item === "object") return Object.fromEntries(Object.keys(item).sort().map(key => [key, ordered((item as Record<string, unknown>)[key])]));
    return item;
  };
  return immutable(ordered(JSON.parse(json)));
}
