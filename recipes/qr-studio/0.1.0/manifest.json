{
  "schemaVersion": 1,
  "id": "qr-studio",
  "version": "0.1.0",
  "title": "QR Studio",
  "description": "A complete QR link library, saved artwork Studio and owner analytics. Built from versioned Jeeves components.",
  "maturity": "experimental",
  "features": [
    "Accounts and private QR library",
    "Permanent links and redirect tracking",
    "Saved PNG/SVG artwork revisions",
    "Bounded UTC analytics"
  ],
