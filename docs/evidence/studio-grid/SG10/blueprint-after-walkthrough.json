{
  "blueprint": 1,
  "revision": 8,
  "system": {
    "name": "TinyURL",
    "description": "Shortens long URLs and redirects visitors quickly, with asynchronous click analytics."
  },
  "services": [
    {
      "id": "analytics",
      "name": "Analytics worker",
      "description": "Consumes click events and writes hourly aggregates.",
      "definition": {
        "id": "studio-worker",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "worker",
      "settings": {
        "kind": "worker",
        "language": "go",
        "execution": "docker",
        "autoscaleOn": "queue-lag",
        "concurrency": 8,
        "maxReplicas": 6,
        "minReplicas": 1
      },
      "components": [
        {
          "id": "analytics-aggregation",
          "name": "Click aggregation",
          "purpose": "Rolls clicks up per link and hour before writing.",
          "kind": "custom",
          "settings": {
            "kind": "custom"
          },
          "thirdParty": [],
          "requires": []
        },
        {
          "id": "analytics-click-consumer",
          "name": "Click consumer",
          "purpose": "Consumes click batches with bounded retries.",
          "kind": "event-consumer",
          "settings": {
            "kind": "event-consumer",
            "batchSize": 1000,
            "retryLimit": 5,
            "concurrency": 8
          },
          "thirdParty": ["Kafka", "Amazon SQS", "Redis Streams"],
          "requires": [
            {
              "kinds": ["queue"],
              "reason": "An event consumer needs a consume connection from a queue."
            }
          ]
        },
        {
          "id": "analytics-data",
          "name": "Aggregate writer",
          "purpose": "Bulk-inserts hourly aggregates.",
          "kind": "data-access",
          "settings": {
            "kind": "data-access",
            "poolSize": 10,
            "readRouting": "primary",
            "statementTimeoutMs": 30000
          },
          "thirdParty": ["PostgreSQL"],
          "requires": [
            {
              "kinds": ["database"],
              "reason": "Data access needs a database connection."
            }
          ]
        }
      ]
    },
    {
      "id": "redirect",
      "name": "Redirect service",
      "description": "Resolves short codes on the hot path, cache first, and answers with a redirect.",
      "definition": {
        "id": "studio-redirect",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "redirect",
      "settings": {
        "kind": "redirect",
        "exposure": "public",
        "language": "go",
        "execution": "docker",
        "autoscaleOn": "requests-per-second",
        "maxReplicas": 30,
        "minReplicas": 3,
        "concurrencyLimit": 5000,
        "requestTimeoutMs": 250,
        "lookupCacheConnection": "redirect-cache",
        "lookupStoreConnection": "redirect-db"
      },
      "group": "link-platform",
      "components": [
        {
          "id": "redirect-cache-reader",
          "name": "Link cache reader",
          "purpose": "Cache-aside: in-process L1, then Redis, one database load per key at a time.",
          "kind": "cache-reader",
          "settings": {
            "kind": "cache-reader",
            "pattern": "cache-aside",
            "stampede": "single-flight",
            "l1MaxEntries": 100000,
            "l1TtlSeconds": 60,
            "l2TtlSeconds": 86400,
            "negativeTtlSeconds": 30
          },
          "thirdParty": ["Redis", "Memcached"],
          "requires": [
            {
              "kinds": ["cache"],
              "reason": "A cache reader needs a cache connection."
            }
          ]
        },
        {
          "id": "redirect-click-publisher",
          "name": "Click publisher",
          "purpose": "Publishes click events in batches off the request path.",
          "kind": "event-publisher",
          "settings": {
            "kind": "event-publisher",
            "outbox": "disabled",
            "lingerMs": 50,
            "batchSize": 500
          },
          "thirdParty": ["Kafka", "Amazon SQS", "Redis Streams"],
          "requires": [
            {
              "kinds": ["queue"],
              "reason": "An event publisher needs a publish connection to a queue."
            }
          ]
        },
        {
          "id": "redirect-data",
          "name": "Link reader",
          "purpose": "Reads links from a replica on a cache miss.",
          "kind": "data-access",
          "settings": {
            "kind": "data-access",
            "poolSize": 50,
            "readRouting": "replica",
            "statementTimeoutMs": 200
          },
          "thirdParty": ["PostgreSQL"],
          "requires": [
            {
              "kinds": ["database"],
              "reason": "Data access needs a database connection."
            }
          ]
        },
        {
          "id": "redirect-responder",
          "name": "Redirect responder",
          "purpose": "Answers 302 so every click still reaches analytics after the edge expires.",
          "kind": "redirect-responder",
          "settings": {
            "kind": "redirect-responder",
            "status": "302",
            "edgeMaxAgeSeconds": 60
          },
          "thirdParty": ["CDN"],
          "requires": []
        }
      ]
    },
    {
      "id": "shorten-api",
      "name": "Shorten API",
      "description": "Validates destinations, allocates short codes and stores new links.",
      "definition": {
        "id": "studio-service",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "service",
      "settings": {
        "kind": "service",
        "exposure": "public",
        "language": "typescript",
        "execution": "docker",
        "autoscaleOn": "cpu",
        "maxReplicas": 6,
        "minReplicas": 2,
        "concurrencyLimit": 200,
        "requestTimeoutMs": 3000
      },
      "group": "link-platform",
      "components": [
        {
          "id": "shorten-data",
          "name": "Link writer",
          "purpose": "Inserts links on the primary.",
          "kind": "data-access",
          "settings": {
            "kind": "data-access",
            "poolSize": 32,
            "readRouting": "primary",
            "statementTimeoutMs": 2000
          },
          "thirdParty": ["PostgreSQL"],
          "requires": [
            {
              "kinds": ["database"],
              "reason": "Data access needs a database connection."
            }
          ]
        },
        {
          "id": "shorten-id-generator",
          "name": "ID generator",
          "purpose": "Leases blocks of 1,000 IDs from the database and encodes them as base62.",
          "kind": "id-generator",
          "settings": {
            "kind": "id-generator",
            "encoding": "base62",
            "strategy": "range-allocation",
            "blockSize": 1000,
            "minLength": 7
          },
          "thirdParty": ["PostgreSQL", "Redis"],
          "requires": [
            {
              "kinds": ["database"],
              "reason": "Range allocation needs a database connection."
            }
          ]
        },
        {
          "id": "shorten-rate-limiter",
          "name": "Rate limiter",
          "purpose": "Limits link creation per API key with shared Redis counters.",
          "kind": "rate-limiter",
          "settings": {
            "key": "api-key",
            "kind": "rate-limiter",
            "limit": 100,
            "store": "redis",
            "algorithm": "token-bucket",
            "windowSeconds": 60
          },
          "thirdParty": ["Redis"],
          "requires": [
            {
              "kinds": ["cache"],
              "reason": "A Redis-backed rate limiter needs a cache connection."
            }
          ]
        },
        {
          "id": "shorten-reputation-check",
          "name": "Reputation check",
          "purpose": "Rejects malicious destinations; fails fast when the provider is down.",
          "kind": "external-call",
          "settings": {
            "kind": "external-call",
            "circuitBreaker": "enabled"
          },
          "thirdParty": ["Any API"],
          "requires": [
            {
              "kinds": ["external-api", "application", "identity"],
              "reason": "An external call needs a target service or external system."
            }
          ]
        }
      ]
    },
    {
      "id": "web",
      "name": "Web app",
      "description": "Browser client where link creators shorten, list and manage their links.",
      "definition": {
        "id": "studio-browser",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "browser",
      "settings": {
        "kind": "browser",
        "delivery": "standalone",
        "provider": "unspecified"
      },
      "components": []
    }
  ],
  "resources": [
    {
      "id": "analytics-store",
      "name": "Analytics store",
      "description": "ClickHouse column store for click aggregates.",
      "definition": {
        "id": "studio-database",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "database",
      "settings": {
        "kind": "database",
        "engine": "clickhouse",
        "provider": "self-hosted"
      },
      "owner": {
        "id": "analytics",
        "kind": "element"
      }
    },
    {
      "id": "cdn",
      "name": "CDN",
      "description": "Terminates visitor traffic and caches redirects for a short edge max-age.",
      "definition": {
        "id": "studio-cdn",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "cdn",
      "settings": {
        "kind": "cdn",
        "origin": "redirect",
        "provider": "unspecified",
        "cacheRedirects": "enabled"
      }
    },
    {
      "id": "click-events",
      "name": "Click events",
      "description": "Buffers click events between redirects and analytics.",
      "definition": {
        "id": "studio-queue",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "queue",
      "settings": {
        "kind": "queue",
        "mode": "topic",
        "provider": "self-hosted",
        "partitions": 12,
        "retentionSeconds": 604800
      },
      "owner": {
        "id": "redirect",
        "kind": "element"
      }
    },
    {
      "id": "link-cache",
      "name": "Link cache",
      "description": "Redis cache of hot short codes and the shared rate-limit counters.",
      "definition": {
        "id": "studio-cache",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "cache",
      "settings": {
        "kind": "cache",
        "engine": "redis-compatible",
        "eviction": "lru",
        "provider": "self-hosted",
        "topology": "cluster",
        "ttlSeconds": 86400
      },
      "owner": {
        "id": "redirect",
        "kind": "element"
      }
    },
    {
      "id": "links-db",
      "name": "Links database",
      "description": "Authoritative short code to destination mapping, read from replicas.",
      "definition": {
        "id": "studio-database",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "database",
      "settings": {
        "kind": "database",
        "engine": "postgresql",
        "provider": "self-hosted",
        "partitionKey": "short_code",
        "readReplicas": 2
      },
      "owner": {
        "id": "shorten-api",
        "kind": "element"
      }
    },
    {
      "id": "studio-6009f49d-7318-426e-93e0-bda3413afc8b",
      "name": "Search index",
      "definition": {
        "id": "studio-search",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "search",
      "settings": {
        "kind": "search",
        "engine": "unspecified",
        "provider": "unspecified"
      }
    }
  ],
  "externals": [
    {
      "source": "element",
      "id": "reputation",
      "name": "URL reputation API",
      "description": "External check that a destination is not phishing or malware.",
      "definition": {
        "id": "studio-external-api",
        "version": "1.0.0",
        "status": "known"
      },
      "context": "url-reputation",
      "category": "generic",
      "provider": "external"
    }
  ],
  "groups": [
    {
      "id": "link-platform",
      "name": "Link platform",
      "description": "The public link services: creation and the hot redirect path.",
      "members": ["redirect", "shorten-api"]
    }
  ],
