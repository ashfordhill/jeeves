        "provider": "self-hosted",
        "topology": "cluster"
      }
    },
    {
      "id": "links-db",
      "name": "Links database",
      "definition": {
        "id": "studio-database",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "database",
      "settings": {
        "kind": "database",
        "engine": "postgresql",
        "provider": "self-hosted",
        "partitionKey": "short_code",
        "readReplicas": 2
      }
