{
  "blueprint": 1,
  "revision": 11,
  "system": {
    "name": "TinyURL probe",
    "description": ""
  },
  "services": [
    {
      "id": "analytics",
      "name": "Analytics worker",
      "definition": {
        "id": "studio-worker",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "worker",
      "settings": {
        "kind": "worker",
        "language": "unspecified",
        "execution": "docker",
        "concurrency": 8
      },
      "components": [
        {
          "id": "agg",
          "name": "Aggregation",
          "purpose": "Rolls clicks up per link and hour.",
          "kind": "custom",
          "settings": {
            "kind": "custom"
          },
          "thirdParty": [],
          "requires": []
        },
        {
          "id": "cons",
          "name": "Click consumer",
          "kind": "event-consumer",
          "settings": {
            "kind": "event-consumer",
            "retryLimit": 5
          },
          "thirdParty": ["Kafka", "Amazon SQS", "Redis Streams"],
          "requires": [
            {
              "kinds": ["queue"],
              "reason": "An event consumer needs a consume connection from a queue."
            }
          ]
        }
      ]
    },
    {
      "id": "edge-gateway",
      "name": "Edge gateway",
      "definition": {
        "id": "studio-gateway",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "gateway",
      "settings": {
        "kind": "gateway",
        "routing": "path-prefix",
        "exposure": "public",
        "language": "unspecified",
        "provider": "envoy",
        "execution": "docker",
        "autoscaleOn": "requests-per-second",
        "maxReplicas": 8,
        "minReplicas": 2,
        "requestTimeoutMs": 1000
      },
      "components": []
    },
    {
      "id": "redirect",
      "name": "Redirect service",
      "definition": {
        "id": "studio-service",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "service",
      "settings": {
        "kind": "service",
        "exposure": "public",
        "language": "unspecified",
        "execution": "docker",
        "concurrencyLimit": 5000
      },
      "components": [
        {
          "id": "cr",
          "name": "Cache reader",
          "kind": "cache-reader",
          "settings": {
            "kind": "cache-reader",
            "pattern": "cache-aside",
            "stampede": "single-flight",
            "l1MaxEntries": 10000,
            "l1TtlSeconds": 30
          },
          "thirdParty": ["Redis", "Memcached"],
          "requires": [
            {
              "kinds": ["cache"],
              "reason": "A cache reader needs a cache connection."
            }
          ]
        },
        {
          "id": "da",
          "name": "Data access",
          "kind": "data-access",
          "settings": {
            "kind": "data-access",
            "readRouting": "replica"
          },
          "thirdParty": ["PostgreSQL"],
          "requires": [
            {
              "kinds": ["database"],
              "reason": "Data access needs a database connection."
            }
          ]
        },
        {
          "id": "pub",
          "name": "Click publisher",
          "kind": "event-publisher",
          "settings": {
            "kind": "event-publisher",
            "outbox": "disabled",
            "lingerMs": 20,
            "batchSize": 500
          },
          "thirdParty": ["Kafka", "Amazon SQS", "Redis Streams"],
          "requires": [
            {
              "kinds": ["queue"],
              "reason": "An event publisher needs a publish connection to a queue."
            }
          ]
        },
        {
          "id": "resp",
          "name": "Redirect responder",
          "kind": "redirect-responder",
          "settings": {
            "kind": "redirect-responder",
            "status": "302",
            "edgeMaxAgeSeconds": 60
          },
          "thirdParty": ["CDN"],
          "requires": []
        }
      ]
    },
    {
      "id": "shorten-api",
      "name": "Shorten API",
      "definition": {
        "id": "studio-service",
        "version": "1.0.0",
        "status": "known"
      },
      "kind": "service",
      "settings": {
        "kind": "service",
        "exposure": "internal",
        "language": "unspecified",
        "execution": "docker",
        "requestTimeoutMs": 2000
      },
      "components": [
        {
          "id": "idgen",
          "name": "ID generator",
          "kind": "id-generator",
          "settings": {
            "kind": "id-generator",
            "encoding": "base62",
            "strategy": "range-allocation",
            "blockSize": 1000
          },
          "thirdParty": ["PostgreSQL", "Redis"],
          "requires": [
            {
              "kinds": ["database"],
              "reason": "Range allocation needs a database connection."
            }
          ]
        },
        {
          "id": "rep-call",
          "name": "Reputation check",
          "kind": "external-call",
          "settings": {
            "kind": "external-call",
            "circuitBreaker": "enabled"
          },
          "thirdParty": ["Any API"],
          "requires": [
            {
              "kinds": ["external-api", "application", "identity"],
              "reason": "An external call needs a target service or external system."
            }
          ]
        },
        {
          "id": "rl",
          "name": "Rate limiter",
          "kind": "rate-limiter",
          "settings": {
            "key": "ip",
            "kind": "rate-limiter",
            "limit": 100,
            "store": "memory",
            "algorithm": "token-bucket",
            "windowSeconds": 60
          },
          "thirdParty": ["Redis"],
          "requires": []
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "clicks",
