      "components": [
        {
          "id": "session-api-sign-in-flow",
          "host": "session-api",
          "name": "Sign-in flow",
          "description": "OIDC authorization code with PKCE, state and nonce; creates, refreshes and revokes cookie sessions (Secure, HttpOnly). Keeps the guest claim proof flow in the same tab.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "session-api-api-forwarding",
          "host": "session-api",
          "name": "API forwarding",
          "description": "Checks the session cookie and CSRF on mutations, then forwards the bearer token (none on guest create) to Link, Account and Billing APIs. Refreshes tokens with Identity.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "link-api-sign-in",
          "host": "link-api",
          "name": "Sign-in",
          "description": "Optional: guest create sends no token and is anonymous; an invalid or expired token is 401. Owner, claim and operator routes still check the verified subject.",
          "settings": {
            "kind": "auth-guard",
            "credential": "jwt",
            "signIn": "optional"
          }
        },
        {
          "id": "link-api-link-operations",
          "host": "link-api",
          "name": "Link operations",
          "description": "Create (guest or owned) with CSPRNG slugs, idempotency keys and admission; claim with one-time proof; If-Match edits; tombstone deletes. Reputation check and entitlement grant first.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "link-api-abuse-and-moderation",
          "host": "link-api",
          "name": "Abuse and moderation",
          "description": "Bounded public abuse reports (202, no disposition shown) and block or unblock under a separate operator permission. A report alone never disables a link.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "redirect-service-resolve-and-redirect",
          "host": "redirect-service",
          "name": "Resolve and redirect",
          "description": "Host + slug via Hot routes, else the Links public view; state and expiry; publish the click and await its ACK; recheck; then 302 with no-store. Otherwise 404/410/403, or 503 with no Location.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "account-api-sign-in",
          "host": "account-api",
          "name": "Sign-in",
          "description": "Required: every route needs a valid token. Each query is scoped to the verified subject, cursors included.",
          "settings": {
            "kind": "auth-guard",
            "credential": "jwt",
            "signIn": "required"
          }
        },
        {
          "id": "account-api-my-links",
          "host": "account-api",
          "name": "My links",
          "description": "Cursor pages (at most 50, by created_at and id) of the caller's own links from the Links owner view.",
          "settings": {
            "kind": "data-access",
            "readRouting": "primary"
          }
        },
        {
          "id": "account-api-link-analytics",
          "host": "account-api",
          "name": "Link analytics",
          "description": "Owner-only counts, ranges, freshness and bounded CSV export. Checks ownership in the Links owner view and the tier's lookback and export allowance with Billing API.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "billing-api-sign-in",
          "host": "billing-api",
          "name": "Sign-in",
          "description": "Optional, so Stripe reaches the webhook without a token. Customer routes still require a signed-in owner; the webhook is authorized by its Stripe signature instead.",
          "settings": {
            "kind": "auth-guard",
            "credential": "jwt",
            "signIn": "optional"
          }
        },
        {
          "id": "billing-api-customer-billing",
          "host": "billing-api",
          "name": "Customer billing",
          "description": "Signed-in owner only: plan status, hosted Checkout and portal sessions from allowlisted prices, allowed return URLs and idempotency keys. CSRF is checked by Session API.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "billing-api-payment-events",
          "host": "billing-api",
          "name": "Payment events",
          "description": "No session: verifies the Stripe signature over the raw body bytes, stores the event in the inbox before 2xx, then reconciles subscriptions from Stripe under a lease.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "billing-api-entitlements",
          "host": "billing-api",
          "name": "Entitlements",
          "description": "Entitlement grants valid for at most 60 seconds, for Link API and Account API only. Fails closed for paid-gated operations when no valid grant exists.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "analytics-worker-click-aggregator",
          "host": "analytics-worker",
          "name": "Click aggregator",
          "description": "Validates and deduplicates each click event within a bounded horizon, updates aggregates and acknowledges after commit. Poison events go to quarantine, never dropped.",
          "settings": {
            "kind": "custom"
          }
        }
      ],
