    "system": {
      "name": "QRWTY",
      "description": "Public short links and QR codes. Guests create links without signing in; accounts own, edit and analyse theirs; individual free and paid plans. A redirect is sent only after its click is durably acknowledged."
    },
    "nodes": [],
    "relationships": []
  },
  "elements": [
    {
      "id": "session-api",
      "name": "Session API",
      "classification": {
        "kind": "Application"
      },
      "description": "Same-origin browser facade: OIDC code + PKCE sign-in, cookie sessions and CSRF. Forwards a valid bearer token (none on guest create) to the Link, Account and Billing APIs; never invents an identity header."
    },
    {
      "id": "identity",
      "name": "Identity",
      "classification": {
        "kind": "Application"
      },
      "description": "Verified account identity over OIDC. Local Keycloak while testing; the managed issuer is a deployment compatibility decision."
    },
    {
      "id": "sessions",
      "name": "Sessions",
      "classification": {
        "kind": "Data store"
      },
      "description": "Encrypted tokens, session expiry and revocation state. A separate restricted PostgreSQL logical database, written only by Session API and never queried by the Redirect service."
    },
    {
      "id": "link-api",
      "name": "Link API",
      "classification": {
        "kind": "Application"
      },
      "description": "Guest create, claim with one-time proof, owned edits and deletes, abuse reports and operator decisions. Sole writer of Links; asks Billing API for entitlement grants on owned operations."
    },
    {
      "id": "account-api",
      "name": "Account API",
      "classification": {
        "kind": "Application"
      },
      "description": "Signed-in reads: the caller's own links and their analytics. Reads the Links owner view and Analytics, checks entitlements with Billing API, and forwards no writes."
    },
    {
      "id": "billing-api",
      "name": "Billing API",
      "classification": {
        "kind": "Application"
      },
      "description": "Hosted Checkout and portal, a signature-verified Stripe webhook inbox, subscription reconciliation and entitlement grants. Sole writer of Billing."
    },
    {
      "id": "links",
      "name": "Links",
      "classification": {
        "kind": "Data store"
      },
      "description": "Durable routes, ownership, claim and idempotency data and tombstones. PostgreSQL; the public route view and the account owner view have separate grants."
    },
    {
      "id": "admission-cache",
      "name": "Admission cache",
      "classification": {
        "kind": "Data store"
      },
      "description": "Approximate distributed abuse and admission counters (Valkey). Durable hard account limits stay in Links transactions."
    },
    {
      "id": "reputation-api",
      "name": "Reputation API",
      "classification": {
        "kind": "External system"
      },
      "description": "Destination reputation check before a link is created. Unavailable means a retryable 503 on create; existing redirects continue."
    },
    {
      "id": "redirect-service",
      "name": "Redirect service",
      "classification": {
        "kind": "Application"
      },
      "description": "Resolves host and slug, checks state and expiry, awaits the durable click acknowledgment, then answers 302. No sign-in or payment dependency."
    },
    {
      "id": "hot-routes",
      "name": "Hot routes",
      "classification": {
        "kind": "Data store"
      },
      "description": "Short-lived route metadata with a bounded freshness deadline (Valkey). Replaceable, never the source of truth."
    },
    {
      "id": "click-events",
      "name": "Click events",
      "classification": {
        "kind": "Data store"
      },
      "description": "Click events, durably acknowledged before each redirect. Production transport is GCP Pub/Sub, pending G12; the local export uses the installed broker. The archive subscription is deployment."
    },
    {
      "id": "analytics-worker",
      "name": "Analytics worker",
      "classification": {
        "kind": "Application"
      },
      "description": "Validates, deduplicates and aggregates click events, expires bounded data and acknowledges only after its transaction commits. Sole writer of Analytics."
    },
    {
      "id": "analytics",
      "name": "Analytics",
      "classification": {
        "kind": "Data store"
      },
      "description": "Click aggregates plus bounded deduplication data. A separate PostgreSQL logical database, read by Account API."
    },
    {
      "id": "billing",
      "name": "Billing",
      "classification": {
        "kind": "Data store"
      },
      "description": "Customer mappings, webhook inbox, subscription and entitlement revisions, reconciliation jobs and action idempotency. Restricted PostgreSQL logical database; no card data."
    },
    {
      "id": "stripe-api",
      "name": "Stripe API",
      "classification": {
        "kind": "External system"
      },
      "description": "Hosted payments and subscriptions (test mode). Its signed webhook reaches Billing API through the Create, manage & pay entry, not a line out of this tile."
    }
  ],
