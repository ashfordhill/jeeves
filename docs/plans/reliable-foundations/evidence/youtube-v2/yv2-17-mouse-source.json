            "via": "upload-originals"
          }
        },
        {
          "id": "job-publisher-queue",
          "from": "upload-jobs",
          "to": {
            "kind": "element",
            "id": "upload-queue",
            "via": "upload-publish"
          }
        },
        {
          "id": "job-consumer-queue",
          "from": "transcoder-consumer",
          "to": {
            "kind": "element",
            "id": "upload-queue",
            "via": "jobs-transcoder"
          }
        },
        {
          "id": "encoder-originals",
          "from": "transcoder-encoder",
          "to": {
            "kind": "element",
            "id": "originals",
            "via": "transcoder-read"
          }
        },
        {
          "id": "packager-transcoded",
          "from": "transcoder-packager",
          "to": {
            "kind": "element",
            "id": "transcoded",
            "via": "transcoder-write"
          }
        },
        {
          "id": "thumbnails-transcoded",
          "from": "transcoder-thumbnails",
          "to": {
            "kind": "element",
            "id": "transcoded",
            "via": "transcoder-write"
          }
        },
        {
          "id": "done-events",
          "from": "transcoder-done",
          "to": {
            "kind": "element",
            "id": "completion-events",
            "via": "transcoder-publish"
          }
        },
        {
          "id": "handler-consumer-events",
          "from": "handler-consumer",
          "to": {
            "kind": "element",
