      "components": [
        {
          "id": "watch-cache-reader",
          "host": "watch",
          "name": "Details cache",
          "description": "Caches only positive ready-public metadata for one hour; single-flight fill, primary fallback and separately fresh counts.",
          "settings": {
            "kind": "cache-reader",
            "pattern": "cache-aside",
            "l2TtlSeconds": 3601,
            "stampede": "single-flight"
          }
        },
        {
          "id": "watch-details",
          "host": "watch",
          "name": "Details reader",
          "description": "Reads only ready-public metadata from the primary public view.",
          "settings": {
            "kind": "data-access",
            "poolSize": 50,
            "readRouting": "primary",
            "statementTimeoutMs": 500
          }
        },
        {
          "id": "watch-counts",
          "host": "watch",
          "name": "View count reader",
          "description": "Reads a video's view count.",
          "settings": {
            "kind": "data-access",
            "poolSize": 20,
            "readRouting": "primary",
            "statementTimeoutMs": 500
          }
        },
        {
          "id": "watch-views",
          "host": "watch",
          "name": "View publisher",
          "description": "Immediately confirms one ready-video played event; no SQL outbox or buffering.",
          "settings": {
            "kind": "event-publisher",
            "batchSize": 1,
            "lingerMs": 0,
            "outbox": "disabled"
          }
        },
        {
          "id": "counter-consumer",
          "host": "view-counter",
          "name": "View consumer",
          "description": "Consumes one event per callback with bounded retries.",
          "settings": {
            "kind": "event-consumer",
            "concurrency": 8,
            "batchSize": 1,
            "retryLimit": 5
          }
        },
        {
          "id": "counter-sum",
          "host": "view-counter",
          "name": "Receipt and increment",
          "description": "Deduplicates each event receipt and increments by one in the same transaction.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "counter-writer",
          "host": "view-counter",
          "name": "Count writer",
          "description": "Writes private receipts/totals as counts_writer; exposes only public totals to Watch.",
          "settings": {
            "kind": "data-access",
            "poolSize": 10,
            "readRouting": "primary",
            "statementTimeoutMs": 2000
          }
        },
        {
          "id": "search-query",
          "host": "search",
          "name": "Video search",
          "description": "Queries the index by title, description and channel, a page at a time.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "upload-auth",
          "host": "upload",
          "name": "Creator check",
          "description": "Accepts only signed-in creators, by Identity's token.",
          "settings": {
            "kind": "auth-guard",
            "credential": "jwt"
          }
        },
        {
          "id": "upload-multipart",
          "host": "upload",
          "name": "Multipart uploads",
          "description": "Starts a multipart upload, signs a URL for each part, lists the parts that arrived so the creator can resume, and completes it.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "upload-jobs",
          "host": "upload",
          "name": "Job outbox publisher",
          "description": "Relays the stable processing job committed with pending state; confirms before marking sent.",
          "settings": {
            "kind": "event-publisher",
            "outbox": "enabled"
          }
        },
        {
          "id": "transcoder-consumer",
          "host": "transcoder",
          "name": "Job consumer",
          "description": "Takes one upload job at a time with bounded retries.",
          "settings": {
            "kind": "event-consumer",
            "concurrency": 1,
            "retryLimit": 3
          }
        },
        {
          "id": "transcoder-encoder",
          "host": "transcoder",
          "name": "Segmenter and encoder",
          "description": "Checks original size/hash then runs fixed CPU H.264/AAC 360p and 720p HLS encoding; no speculative task DAG.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "transcoder-packager",
          "host": "transcoder",
          "name": "Packager",
          "description": "Stores the segments with an HLS playlist per rendition and one master playlist.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "transcoder-thumbnails",
          "host": "transcoder",
          "name": "Thumbnailer",
          "description": "Picks frames and stores them as the video's thumbnails, at full size.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "transcoder-done",
          "host": "transcoder",
          "name": "Processing result publisher",
          "description": "Confirms bounded started/succeeded/failed results with stable job/attempt/type event identities; no SQL outbox.",
          "settings": {
            "kind": "event-publisher",
            "outbox": "disabled"
          }
        },
        {
          "id": "handler-consumer",
          "host": "completion-handler",
          "name": "Processing consumer",
          "description": "Consumes processing results; inbox receipt, conditional transition and publication intent commit before ack.",
          "settings": {
            "kind": "event-consumer",
            "concurrency": 4,
            "retryLimit": 10
          }
        },
        {
          "id": "handler-writer",
          "host": "completion-handler",
          "name": "Lifecycle writer",
          "description": "Reads and conditionally transitions private Video state; writes inbox and committed-ready publication outbox atomically.",
          "settings": {
            "kind": "data-access",
            "poolSize": 10,
            "readRouting": "primary",
            "statementTimeoutMs": 2000
          }
        },
        {
          "id": "indexer-consumer",
          "host": "search-indexer",
          "name": "Publication consumer",
          "description": "Consumes committed VideoPublished events only, with bounded retries.",
          "settings": {
            "kind": "event-consumer",
            "concurrency": 4,
            "batchSize": 1,
            "retryLimit": 5
          }
        },
        {
          "id": "indexer-writer",
          "host": "search-indexer",
          "name": "Index writer",
          "description": "Adds the playable video's title, description and channel to the search index.",
          "settings": {
            "kind": "custom"
          }
        },
        {
          "id": "upload-state-writer",
          "host": "upload",
          "name": "Upload state writer",
          "description": "Video runtime metadata_upload credential; allocates private upload state and commits verified pending plus job outbox. No owner password.",
          "settings": {
            "kind": "data-access",
            "poolSize": 10,
            "readRouting": "primary",
            "statementTimeoutMs": 2000
          }
        },
        {
          "id": "handler-publications",
          "host": "completion-handler",
          "name": "Publication outbox publisher",
          "description": "Relays only publication-events rows from committed ready state; confirms before marking sent, duplicate delivery permitted.",
          "settings": {
            "kind": "event-publisher",
            "outbox": "enabled"
          }
        }
      ],
      "componentConnections": [
        {
          "id": "details-cache-redis",
          "from": "watch-cache-reader",
