    "system": {
      "name": "TinyURL foundation",
      "description": "One Links owner: authenticated Create commits immutable destinations to PostgreSQL; public Follow resolves from a positive cache or the authoritative primary. Optional expiry. Excludes analytics, destination changes, disable management, reputation, quotas and custom slugs."
    },
