  "elements": [
    {
      "id": "create-api",
      "name": "Create link",
      "classification": {
        "kind": "Application"
      },
      "description": "Authenticated create; durable commit and retained-result reconciliation."
    },
    {
      "id": "resolve-api",
      "name": "Resolve link",
      "classification": {
        "kind": "Application"
      },
      "description": "Public lookup; primary fallback, expiry checks and no-store redirects."
    },
    {
      "id": "links-db",
      "name": "Links database",
      "classification": {
        "kind": "Data store"
      },
      "description": "Links owns the authoritative immutable records and retained create results."
    },
    {
      "id": "links-cache",
      "name": "Links cache",
      "classification": {
        "kind": "Data store"
      },
      "description": "Links-owned positive projection; 300s cap clamped to remaining expiry. No negative entries."
    }
