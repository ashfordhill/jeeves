@@ -0,0 +1,41 @@
+"""Attach the existing application files to fresh CLI exports; never edit scaffolds."""
+
+import hashlib
+import json
+import pathlib
+import shutil
+
+root = pathlib.Path(__file__).resolve().parents[5]
+scratch = pathlib.Path('/tmp/jeeves-wd12')
+results = []
+for name, fixture in [('link', 'rg-link-flow'), ('catalog', 'rg-catalog-flow')]:
+    application = scratch / f'{name}-export'
+    source = root / 'field-projects/generator-system/fixtures' / fixture
+    manifest = json.loads((application / '.jeeves/manifest.json').read_text())
+    scaffolds = {row['path']: row['sha256'] for row in manifest['files']
+                 if row['ownership'] == 'generated-scaffold'}
+    for attachment in json.loads((source / 'attachments.json').read_text()):
+        target = application / attachment['destination']
+        assert attachment['destination'] not in scaffolds
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source / attachment['source'], target)
+    if name == 'catalog':
+        target = application / 'src/modules/projector/apply-catalog.ts'
+        shutil.copyfile(root / 'field-projects/generator-system/fixtures/wd-drill-no-effect/apply-catalog.ts', target)
+    for path, digest in scaffolds.items():
+        assert hashlib.sha256((application / path).read_bytes()).hexdigest() == digest
+    contract = json.loads((application / 'deploy/contract.json').read_text())
+    normalized = json.loads((application / '.jeeves/normalized.json').read_text())
+    results.append({
+        'fixture': fixture,
+        'files': len(manifest['files']),
+        'scaffoldsUnchanged': len(scaffolds),
+        'applicationVariant': 'no-effect complete callback' if name == 'catalog' else 'original',
+        'deploymentProcessKeys': sorted({k for p in contract['processes'] for k in p}),
+        'deploymentStoreKeys': sorted({k for s in contract['stores'] for k in s}),
+        'stores': [{'id': s['id'], 'kind': s['kind']} for s in contract['stores']],
+        'workerHealth': [{'id': p['id'], 'health': p.get('health')} for p in contract['processes'] if p['kind'] == 'worker'],
+        'processes': normalized.get('processes'),
+    })
+(root / 'docs/plans/wires-and-deployment/evidence/wd12/export-audit.json').write_text(json.dumps(results, indent=2) + '\n')
+print('Both fresh CLI exports attached; every generated scaffold hash unchanged.')
