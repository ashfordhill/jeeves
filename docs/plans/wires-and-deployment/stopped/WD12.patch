+import { stripTypeScriptTypes } from "node:module";
+import { afterEach, expect, it } from "vitest";
+import { consumerReceiptMigration } from "./client-wiring.ts";
+import { databases, fixture, operation, withOperation } from "./local-operation.test.helpers.ts";
+import { operationImports } from "./operation.test.helpers.ts";
+
+const exported = "/tmp/jeeves-wd12/catalog-export";
+const urls = new Map<string, string>();
+const data = (source: string) =>
+  `data:text/javascript;base64,${Buffer.from(source).toString("base64")}`;
+function load(name: string): string {
+  const old = urls.get(name);
+  if (old) return old;
+  const source = operationImports(
+    stripTypeScriptTypes(readFileSync(`${exported}/src/runtime/${name}.ts`, "utf8")),
+  ).replace(/from "\.\/(.+)\.ts"/g, (_match, child: string) => `from "${load(child)}"`);
+  const url = data(source);
+  urls.set(name, url);
+  return url;
+}
+const runtime = await import(load("receipt-consumer"));
+const contract = data(
+  stripTypeScriptTypes(readFileSync(`${exported}/src/contracts/catalog.ts`, "utf8")),
+);
+const variant = await import(
+  data(
+    stripTypeScriptTypes(readFileSync(`${exported}/src/modules/projector/apply-catalog.ts`, "utf8"))
+      .replace('from "../../contracts/catalog.ts"', `from "${contract}"`)
+      .replace('from "../../extension-api/index.ts"', `from "${load("receipt-consumer")}"`),
+  )
+);
+afterEach(async () => {
+  await Promise.all(databases.splice(0).map((db) => db.close()));
+});
+
+it("WD12 feasibility: accepted duplicate receipt/progress can accompany zero product effects", async () => {
+  const f = await fixture();
+  await f.pg.exec(`${consumerReceiptMigration.sql}
+    GRANT SELECT,INSERT,UPDATE,DELETE ON jeeves.consumer_receipts,
+      jeeves.consumer_receipts_maintenance,jeeves.consumer_receipts_workers TO runtime;`);
+  await f.pg.exec(`CREATE SCHEMA p_caller_owner;
+    ${readFileSync(`${exported}/infra/postgres/caller-db/products/migrations/p_caller_owner/0001-initial.sql`, "utf8")}
+    GRANT USAGE ON SCHEMA p_caller_owner TO product;
+    GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA p_caller_owner TO product;`);
+  runtime.validateReceiptConsumerBinding(variant.receiptConsumer, ["callerDb"], true);
+  const engine = runtime.bindReceiptConsumer(
+    f.dependencies.db,
+    runtime.receiptConsumerDefinition(variant.receiptConsumer, "callerDb", true),
+    {
+      namespace: "wd12-no-effect",
+      consumerId: "apply-catalog",
+      pool: f.pool,
+      productRole: "product",
+      commands: f.commands,
+    },
+  );
+  const invoke = async (input: unknown) => {
+    const execution = operation({ maximumMs: 10000 });
+    try {
+      return await withOperation(execution.context, () =>
+        engine.run({
+          messageId: "wd12-duplicate",
+          body: Buffer.from(JSON.stringify(input)),
+        }),
+      );
+    } finally {
+      execution.close();
+    }
+  };
+  await engine.ready();
+  await expect(invoke({})).rejects.toMatchObject({ code: "MALFORMED_MESSAGE" });
+  const payload = { id: "video-one", title: "Catalog video" };
+  await invoke(payload);
+  await invoke(payload);
+  const receipts = (
+    await f.pg.query("SELECT event_id,result FROM jeeves.consumer_receipts ORDER BY event_id")
+  ).rows;
+  const progress = (
+    await f.pg.query(
+      "SELECT consumer_id,last_progress_at IS NOT NULL AS progressed,state FROM jeeves.consumer_receipts_workers",
+    )
+  ).rows;
+  const product = (
+    await f.pg.query(
+      "SELECT count(*)::int AS rows,coalesce(sum(effects),0)::int AS effects FROM p_caller_owner.deliveries",
+    )
+  ).rows;
+  expect(receipts).toEqual([{ event_id: "wd12-duplicate", result: { value: true } }]);
+  expect(progress).toEqual([{ consumer_id: "apply-catalog", progressed: true, state: "running" }]);
+  expect(product).toEqual([{ rows: 0, effects: 0 }]);
+  await writeFile(
+    "docs/plans/wires-and-deployment/evidence/wd12/counterexample.json",
+    `${JSON.stringify(
+      {
+        runtime:
+          "fresh public catalog export; original scaffolds; existing PGlite/scoped SQL helper",
+        variant: "supported application-owned complete callback returns without a product command",
+        unknownGenericPayload: "MALFORMED_MESSAGE",
+        applicationOwnedPayload: payload,
+        deliveries: 2,
+        receipts,
+        progress,
+        product,
+        limitation:
+          "Offline direct receipt invocation; no broker, native stop/start or drill run claimed",
+      },
+      null,
+      2,
+    )}\n`,
+  );
+});
