{
  "compilerOptions": {
    "target": "ES2023", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": [], "strict": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "rootDir": "browser", "outDir": "dist-public", "rewriteRelativeImportExtensions": true
  },
  "include": ["browser/**/*.ts"]
}
