        "components": [
          {
            "id": "watch-cache-reader",
            "host": "watch",
            "name": "Details cache",
            "description": "Cache-aside: looks a video up in the Metadata cache; on a miss reads a replica and fills the cache for an hour.",
            "settings": {
              "kind": "cache-reader",
              "pattern": "cache-aside",
              "l2TtlSeconds": 3600,
              "stampede": "single-flight"
            }
          },
          {
            "id": "watch-details",
            "host": "watch",
            "name": "Details reader",
            "description": "Reads a video's title, description, channel and playlist from a replica.",
            "settings": {
              "kind": "data-access",
              "poolSize": 50,
              "readRouting": "replica",
              "statementTimeoutMs": 500
            }
          },
          {
            "id": "watch-counts",
            "host": "watch",
            "name": "View count reader",
            "description": "Reads a video's view count.",
            "settings": {
              "kind": "data-access",
              "poolSize": 20,
              "readRouting": "primary",
              "statementTimeoutMs": 500
            }
          },
          {
            "id": "watch-views",
            "host": "watch",
            "name": "View publisher",
            "description": "Publishes each view the player reports, in batches.",
            "settings": {
              "kind": "event-publisher",
              "batchSize": 500,
              "lingerMs": 50,
              "outbox": "disabled"
            }
          },
          {
            "id": "counter-consumer",
            "host": "view-counter",
            "name": "View consumer",
            "description": "Consumes views in batches with bounded retries.",
            "settings": {
              "kind": "event-consumer",
              "concurrency": 8,
              "batchSize": 1000,
              "retryLimit": 5
            }
          },
          {
            "id": "counter-sum",
            "host": "view-counter",
            "name": "View summer",
            "description": "Sums views per video for a few seconds before writing.",
            "settings": {
              "kind": "custom"
            }
          },
          {
            "id": "counter-writer",
            "host": "view-counter",
            "name": "Count writer",
            "description": "Adds each video's summed views to its count.",
            "settings": {
              "kind": "data-access",
              "poolSize": 10,
              "readRouting": "primary",
              "statementTimeoutMs": 2000
            }
          },
          {
            "id": "search-query",
            "host": "search",
            "name": "Video search",
            "description": "Queries the index by title, description and channel, a page at a time.",
            "settings": {
              "kind": "custom"
            }
          },
          {
            "id": "upload-auth",
            "host": "upload",
            "name": "Creator check",
            "description": "Accepts only signed-in creators, by Identity's token.",
            "settings": {
              "kind": "auth-guard",
              "credential": "jwt"
            }
          },
          {
            "id": "upload-multipart",
            "host": "upload",
            "name": "Multipart uploads",
            "description": "Starts a multipart upload, signs a URL for each part, lists the parts that arrived so the creator can resume, and completes it.",
            "settings": {
              "kind": "custom"
            }
          },
          {
            "id": "upload-jobs",
            "host": "upload",
            "name": "Job publisher",
            "description": "Publishes an upload job once the upload completes, with the video's ID, channel, title and description.",
            "settings": {
              "kind": "event-publisher",
              "outbox": "disabled"
            }
          },
          {
            "id": "transcoder-consumer",
            "host": "transcoder",
            "name": "Job consumer",
            "description": "Takes one upload job at a time with bounded retries.",
            "settings": {
              "kind": "event-consumer",
              "concurrency": 1,
              "retryLimit": 3
            }
          },
          {
            "id": "transcoder-encoder",
            "host": "transcoder",
            "name": "Segmenter and encoder",
            "description": "Reads the original and encodes it, in segments of a few seconds, at each resolution and bitrate (ffmpeg); Xu's task DAG runs here.",
            "settings": {
              "kind": "custom"
            }
          },
          {
            "id": "transcoder-packager",
            "host": "transcoder",
            "name": "Packager",
            "description": "Stores the segments with an HLS playlist per rendition and one master playlist.",
            "settings": {
              "kind": "custom"
            }
          },
          {
            "id": "transcoder-thumbnails",
            "host": "transcoder",
            "name": "Thumbnailer",
            "description": "Picks frames and stores them as the video's thumbnails, at full size.",
            "settings": {
              "kind": "custom"
            }
          },
          {
            "id": "transcoder-done",
            "host": "transcoder",
            "name": "Completion publisher",
            "description": "Announces the playable video with the job's title and description, its duration, playlist and thumbnails.",
            "settings": {
              "kind": "event-publisher",
              "outbox": "disabled"
            }
          },
          {
            "id": "handler-consumer",
            "host": "completion-handler",
            "name": "Completion consumer",
            "description": "Consumes completed videos with bounded retries.",
            "settings": {
              "kind": "event-consumer",
              "concurrency": 4,
              "retryLimit": 10
            }
          },
          {
            "id": "handler-writer",
            "host": "completion-handler",
            "name": "Video writer",
            "description": "Records the playable video once, by its ID: title, description, channel, duration, playlist and thumbnails.",
            "settings": {
              "kind": "data-access",
              "poolSize": 10,
              "readRouting": "primary",
              "statementTimeoutMs": 2000
            }
          },
          {
            "id": "indexer-consumer",
            "host": "search-indexer",
            "name": "Completion consumer",
            "description": "Consumes completed videos with bounded retries.",
            "settings": {
              "kind": "event-consumer",
              "concurrency": 4,
              "batchSize": 100,
              "retryLimit": 5
            }
          },
          {
            "id": "indexer-writer",
            "host": "search-indexer",
            "name": "Index writer",
            "description": "Adds the playable video's title, description and channel to the search index.",
            "settings": {
              "kind": "custom"
            }
          }
        ],
        "componentConnections": [
          {
            "id": "details-cache-redis",
            "from": "watch-cache-reader",
            "to": {
              "kind": "element",
              "id": "metadata-cache",
