              "via": "counter-write"
            }
          },
          {
            "id": "video-search-index",
            "from": "search-query",
            "to": {
              "kind": "element",
              "id": "search-index",
              "via": "search-read"
            }
          },
          {
            "id": "creator-check-multipart",
            "from": "upload-auth",
            "to": {
              "kind": "component",
              "id": "upload-multipart"
            },
            "label": "Allows creator"
          },
          {
            "id": "multipart-originals",
            "from": "upload-multipart",
            "to": {
              "kind": "element",
              "id": "originals",
              "via": "upload-originals"
            }
          },
          {
            "id": "multipart-jobs",
            "from": "upload-multipart",
            "to": {
              "kind": "component",
              "id": "upload-jobs"
            },
            "label": "On completion"
          },
          {
            "id": "job-publisher-queue",
            "from": "upload-jobs",
            "to": {
              "kind": "element",
              "id": "upload-queue",
              "via": "upload-publish"
            }
          },
          {
            "id": "job-consumer-queue",
            "from": "transcoder-consumer",
            "to": {
              "kind": "element",
              "id": "upload-queue",
              "via": "jobs-transcoder"
            }
          },
          {
            "id": "job-consumer-encoder",
            "from": "transcoder-consumer",
            "to": {
              "kind": "component",
              "id": "transcoder-encoder"
            },
            "label": "Hands job"
          },
          {
            "id": "encoder-originals",
            "from": "transcoder-encoder",
            "to": {
              "kind": "element",
              "id": "originals",
              "via": "transcoder-read"
            }
          },
          {
            "id": "encoder-packager",
            "from": "transcoder-encoder",
            "to": {
              "kind": "component",
              "id": "transcoder-packager"
            },
            "label": "Hands segments"
          },
          {
            "id": "packager-transcoded",
            "from": "transcoder-packager",
            "to": {
              "kind": "element",
              "id": "transcoded",
              "via": "transcoder-write"
            }
          },
          {
            "id": "encoder-thumbnails",
            "from": "transcoder-encoder",
            "to": {
              "kind": "component",
              "id": "transcoder-thumbnails"
            },
            "label": "Hands frames"
          },
          {
            "id": "thumbnails-transcoded",
            "from": "transcoder-thumbnails",
            "to": {
              "kind": "element",
