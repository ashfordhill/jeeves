{
  "name": "jeeves",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose -f jeeves/compose.yaml up -d --wait",
    "db:down": "docker compose -f jeeves/compose.yaml down",
    "dev": "pnpm db:up && pnpm --parallel --filter @jeeves/server --filter @jeeves/web dev",
    "lint": "biome check --config-path=tooling/biome.config.json .",
    "format": "biome check --config-path=tooling/biome.config.json --write .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run --config tooling/vitest.config.ts",
    "test:e2e": "pnpm db:up && playwright test -c jeeves/playwright.config.ts",
    "test:e2e:docker": "pnpm db:up && jeeves/scripts/e2e-docker.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval:chat": "pnpm --filter @jeeves/server exec tsx src/eval/runner.ts",
    "benchmark:source": "pnpm --filter @jeeves/generator benchmark:source",
    "test:generated": "pnpm --filter @jeeves/generator test:generated"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
