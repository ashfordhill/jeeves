{
  "schemaVersion": 1,
  "revision": 1,
  "elements": [
    {
      "id": "api",
      "name": "API",
      "template": { "id": "http-service", "version": "0.1.0" },
      "config": { "port": "eighty", "colour": "blue" },
      "attachments": [
        { "id": "api-server", "template": { "id": "rest-api-server", "version": "0.1.0" } }
      ]
    },
    { "id": "cache", "name": "Cache", "template": { "id": "redis", "version": "0.1.0" } },
    {
      "id": "web",
      "name": "Web",
      "template": { "id": "web-app", "version": "0.1.0" },
      "config": { "title": "Web" },
      "attachments": [
        { "id": "web-server", "template": { "id": "rest-api-server", "version": "0.1.0" } }
      ]
    }
  ],
  "connections": [
    {
      "id": "web-uses-api",
      "kind": "uses-database",
      "from": { "element": "web" },
      "to": { "element": "api" }
    },
    {
      "id": "api-to-ghost",
      "kind": "depends-on",
      "from": { "element": "api" },
      "to": { "element": "ghost" }
    }
  ]
}
