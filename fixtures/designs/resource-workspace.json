{
  "schemaVersion": 2,
  "revision": 0,
  "elements": [
    {
      "id": "inventory",
      "name": "Inventory API",
      "template": {
        "id": "http-service",
        "version": "0.2.0"
      },
      "config": {},
      "notes": "",
      "attachments": [
        {
          "id": "inventory-api",
          "template": {
            "id": "rest-api-server",
            "version": "0.1.0"
          },
          "config": {
            "auth": "session",
            "basePath": "/api",
            "model": {
              "storeConnection": "inventory-store",
              "resources": [
                {
                  "id": "warehouse",
                  "name": "warehouse",
                  "access": "owner",
                  "fields": [
                    {
                      "id": "name",
                      "name": "name",
                      "type": "text",
                      "required": true,
                      "maxLength": 120
                    },
                    {
                      "id": "website",
                      "name": "website",
                      "type": "http-url",
                      "required": false
                    }
                  ],
                  "belongsTo": [],
                  "operations": ["create", "read", "list", "update"]
                },
                {
                  "id": "stock-item",
                  "name": "stockItem",
                  "access": "owner",
                  "fields": [
                    {
                      "id": "title",
                      "name": "title",
                      "type": "text",
                      "required": true,
                      "maxLength": 120
                    },
                    {
                      "id": "quantity",
                      "name": "quantity",
                      "type": "integer",
                      "required": true,
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "id": "state",
                      "name": "state",
                      "type": "enum",
                      "required": true,
                      "values": ["available", "reserved"]
                    },
                    {
                      "id": "notes",
                      "name": "notes",
                      "type": "text",
                      "required": false,
                      "maxLength": 1000
                    },
                    {
                      "id": "recorded-at",
                      "name": "recordedAt",
                      "type": "timestamp",
                      "generated": "created-at"
                    }
                  ],
                  "belongsTo": [
                    {
                      "id": "warehouse",
                      "resource": "warehouse",
                      "required": true
                    }
                  ],
                  "operations": ["create", "read", "list", "update"]
                }
              ],
              "acceptanceCases": [],
              "extensions": []
            }
          },
          "notes": ""
        }
      ]
    },
    {
      "id": "inventory-db",
      "name": "Inventory database",
      "template": {
        "id": "postgres",
        "version": "0.1.0"
      },
      "config": {},
      "notes": "",
      "attachments": []
    },
    {
      "id": "inventory-web",
      "name": "Inventory workspace",
      "template": {
        "id": "web-app",
        "version": "0.1.0"
      },
      "config": {
        "title": "Fieldwork"
      },
      "notes": "",
      "attachments": [
        {
          "id": "inventory-client",
          "template": {
            "id": "rest-api-client",
            "version": "0.1.0"
          },
          "config": {},
          "notes": ""
        }
      ]
    }
  ],
  "connections": [
    {
      "id": "inventory-store",
      "kind": "uses-database",
      "from": {
        "element": "inventory"
      },
      "to": {
        "element": "inventory-db"
      },
      "config": {}
    },
    {
      "id": "inventory-call",
      "kind": "calls",
      "from": {
        "element": "inventory-web"
      },
      "to": {
        "element": "inventory"
      },
      "config": {
        "fromCapability": "inventory-client",
        "toCapability": "inventory-api"
      }
    }
  ],
  "annotations": []
}
