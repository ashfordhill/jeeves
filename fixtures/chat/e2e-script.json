{
  "turns": [
    {
      "match": "Plan an app like bit.ly",
      "steps": [
        {
          "text": "I’ll use the planning library to sketch the architecture.",
          "toolCalls": [
            {
              "name": "listPlannedCapabilities",
              "arguments": {}
            },
            {
              "name": "getDesign",
              "arguments": {}
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "describePlannedCapability",
              "arguments": {
                "id": "browser-client"
              }
            },
            {
              "name": "describePlannedCapability",
              "arguments": {
                "id": "application-api"
              }
            },
            {
              "name": "describePlannedCapability",
              "arguments": {
                "id": "relational-store"
              }
            },
            {
              "name": "describePlannedCapability",
              "arguments": {
                "id": "domain-module"
              }
            },
            {
              "name": "describePlannedCapability",
              "arguments": {
                "id": "authorization-module"
              }
            },
            {
              "name": "describePlannedCapability",
              "arguments": {
                "id": "analytics-module"
              }
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "applyOperations",
              "arguments": {
                "ops": [
                  {
                    "op": "addElement",
                    "element": {
                      "id": "short-web",
                      "name": "Link workspace",
                      "template": null,
                      "planned": "browser-client",
                      "description": "Owners create links and review activity.",
                      "technology": "React",
                      "config": {
                        "access": "Sign-in required"
                      }
                    }
                  },
                  {
                    "op": "addElement",
                    "element": {
                      "id": "short-api",
                      "name": "Short links API",
                      "template": null,
                      "planned": "application-api",
                      "description": "Manages short links, redirects and owner access.",
                      "technology": "Node.js / Fastify",
                      "config": {
                        "tenancy": "Owner scoped"
                      }
                    }
                  },
                  {
                    "op": "addElement",
                    "element": {
                      "id": "short-db",
                      "name": "Link records",
                      "template": null,
                      "planned": "relational-store",
                      "description": "Persists links, ownership and click events.",
                      "technology": "PostgreSQL",
                      "config": {}
                    }
                  },
                  {
                    "op": "connect",
                    "connection": {
                      "id": "workspace-api",
                      "kind": "calls",
                      "from": {
                        "element": "short-web"
                      },
                      "to": {
                        "element": "short-api"
                      },
                      "planned": {
                        "label": "Creates links and reads activity",
                        "protocol": "HTTPS/JSON",
                        "interaction": "Request / response",
                        "security": "User identity"
                      }
                    }
                  },
                  {
                    "op": "connect",
                    "connection": {
                      "id": "api-records",
                      "kind": "uses-database",
                      "from": {
                        "element": "short-api"
                      },
                      "to": {
                        "element": "short-db"
                      },
                      "planned": {
                        "label": "Reads and writes links and click events",
                        "protocol": "SQL",
                        "interaction": "Request / response",
                        "security": "User identity"
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "applyOperations",
              "arguments": {
                "ops": [
                  {
                    "op": "setArchitecture",
                    "architecture": {
                      "system": {
                        "name": "Short links",
                        "description": "Owners share stable short links and review click activity."
                      },
                      "nodes": [
                        {
                          "id": "link-owner",
                          "kind": "person",
                          "name": "Link owner",
                          "description": "Creates and manages their own short links."
                        },
                        {
                          "id": "link-visitor",
                          "kind": "person",
                          "name": "Link visitor",
                          "description": "Opens a shared short link."
                        },
                        {
                          "id": "link-destination",
                          "kind": "external-system",
                          "name": "Destination website",
                          "description": "Receives the visitor after a redirect."
                        }
                      ],
                      "relationships": [
                        {
                          "id": "owner-workspace",
                          "from": "link-owner",
                          "to": "system",
                          "description": "Creates links and reviews activity",
                          "container": "short-web"
                        },
                        {
                          "id": "visitor-redirect",
                          "from": "link-visitor",
                          "to": "system",
                          "description": "Opens a short link",
                          "container": "short-api"
                        },
                        {
                          "id": "visitor-destination",
                          "from": "link-visitor",
                          "to": "link-destination",
                          "description": "Follows the redirect to the destination"
                        }
                      ],
                      "components": [
                        {
                          "id": "link-management",
                          "element": "short-api",
                          "name": "Link management",
                          "responsibility": "Creates owner-scoped short links and resolves redirect destinations.",
                          "technology": "TypeScript",
                          "capability": "domain-module",
                          "config": {
                            "owns": "Short links",
                            "operations": "Create, edit, resolve",
                            "access": "Authenticated owner"
                          },
                          "usesConnections": ["api-records"]
                        },
                        {
                          "id": "link-access",
                          "element": "short-api",
                          "name": "Owner access",
                          "responsibility": "Authorizes changes to the authenticated owner’s links.",
                          "technology": "TypeScript",
                          "capability": "authorization-module",
                          "config": {
                            "policy": "Owner based"
                          }
                        },
                        {
                          "id": "link-activity",
                          "element": "short-api",
                          "name": "Click activity",
                          "responsibility": "Records click events and aggregates activity for the owner.",
                          "technology": "SQL",
                          "capability": "analytics-module",
                          "config": {
                            "aggregation": "On demand",
                            "dimensions": "link, UTC day"
                          },
                          "usesConnections": ["api-records"]
                        }
                      ],
                      "componentRelationships": [
                        {
                          "id": "management-access",
                          "from": "link-management",
                          "to": "link-access",
                          "description": "Checks ownership before changing links",
                          "protocol": "In-process",
                          "interaction": "Request / response"
                        },
                        {
                          "id": "management-activity",
                          "from": "link-management",
                          "to": "link-activity",
                          "description": "Records a click before returning the redirect",
                          "protocol": "In-process",
                          "interaction": "Request / response"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "name": "validateDesign",
              "arguments": {}
            }
          ]
        },
        {
          "text": "I planned a short-link workspace, API and database, with owners and visitors at C1 and link management, owner access and click activity at C3. These capabilities are design intent only; runtime generation is blocked."
        }
      ]
    },
    {
      "match": "review subtype of links",
      "steps": [
        {
          "toolCalls": [
            {
              "name": "reviewSubtype",
              "arguments": {
                "id": "links",
                "template": {
                  "id": "web-app",
                  "version": "0.1.0"
                }
              }
            }
          ]
        },
        {
          "text": "Review the listed discards before changing the subtype."
        }
      ]
    },
    {
      "match": "Refine the seed plan",
      "steps": [
        {
          "toolCalls": [
            {
              "name": "submitPlan",
              "arguments": {
                "summary": "Split the Links service into redirects and click counting.",
                "tasks": [
                  {
                    "element": "links",
                    "attachment": "links-api",
                    "title": "Create and fetch short links",
                    "description": "POST /links creates a short link from a URL; GET /links/:code returns it with its click count.",
                    "acceptance": [
                      "POST /api/links with a valid URL returns 201 and a code",
                      "GET /api/links/:code returns the URL and its click count"
                    ]
                  },
                  {
                    "element": "links",
                    "title": "Redirect short codes",
                    "description": "GET /:code answers 302 to the stored URL.",
                    "acceptance": [
                      "GET /:code returns 302 to the URL",
                      "An unknown code returns 404"
                    ]
                  },
                  {
                    "element": "links",
                    "title": "Count clicks",
                    "description": "Each redirect adds one to the link's click count.",
                    "acceptance": ["Two redirects make the click count 2"]
                  },
                  {
                    "element": "web",
                    "title": "Shorten form and recent links",
                    "description": "One page: paste a URL, get a short link, see recent links with click counts.",
                    "acceptance": [
                      "Submitting a URL shows its short link",
                      "Recent links show their click counts"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "match": "no accounts",
      "steps": [
        {
          "text": "Got it: no accounts, so links are public."
        }
      ]
    },
    {
      "match": "link shortener",
      "steps": [
        {
          "text": "Let me look at the templates.",
          "toolCalls": [
            {
              "name": "listTemplates",
              "arguments": {}
            }
          ]
        },
        {
          "toolCalls": [
            {
              "name": "applyOperations",
              "arguments": {
                "ops": [
                  {
                    "op": "addElement",
                    "element": {
                      "id": "links",
                      "name": "Links service",
                      "template": {
                        "id": "http-service",
                        "version": "0.1.0"
                      },
                      "config": {
                        "port": 8080
                      },
                      "attachments": [
                        {
                          "id": "links-api",
                          "template": {
                            "id": "rest-api-server",
                            "version": "0.1.0"
                          },
                          "config": {
                            "basePath": "/api"
                          },
                          "notes": "POST /links creates a short link from a URL. GET /links/:code returns it with its click count."
                        }
                      ],
                      "notes": "Create short links; redirect GET /:code with 302; count clicks."
                    }
                  },
                  {
                    "op": "addElement",
                    "element": {
                      "id": "links-db",
                      "name": "Links DB",
                      "template": {
                        "id": "postgres",
                        "version": "0.1.0"
                      },
                      "config": {}
                    }
                  },
                  {
                    "op": "addElement",
                    "element": {
                      "id": "web",
                      "name": "Web app",
                      "template": {
                        "id": "web-app",
                        "version": "0.1.0"
                      },
                      "config": {
                        "title": "Shorty"
                      },
                      "attachments": [
                        {
                          "id": "web-links-client",
                          "template": {
                            "id": "rest-api-client",
                            "version": "0.1.0"
                          },
                          "config": {}
                        }
                      ],
                      "notes": "One page: paste a URL, get a short link, see recent links with click counts."
                    }
                  },
                  {
                    "op": "connect",
                    "connection": {
                      "id": "links-uses-db",
                      "kind": "uses-database",
                      "from": {
                        "element": "links"
                      },
                      "to": {
                        "element": "links-db"
                      }
                    }
                  },
                  {
                    "op": "connect",
                    "connection": {
                      "id": "web-calls-links",
                      "kind": "calls",
                      "from": {
                        "element": "web",
                        "attachment": "web-links-client"
                      },
                      "to": {
                        "element": "links",
                        "attachment": "links-api"
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "text": "I drew a link shortener: a links service with a REST API and its Postgres database, and a web app that calls the API."
        }
      ]
    },
    {
      "match": "accounts",
      "steps": [
        {
          "text": "One question before I change anything.",
          "toolCalls": [
            {
              "name": "askUser",
              "arguments": {
                "question": "Should people sign in?",
                "choices": ["No accounts", "Email login"]
              }
            }
          ]
        }
      ]
    },
    {
      "match": "my brief",
      "steps": [
        {
          "text": "I read your brief."
        }
      ]
    },
    {
      "match": "sms",
      "steps": [
        {
          "toolCalls": [
            {
              "name": "applyOperations",
              "arguments": {
                "ops": [
                  {
                    "op": "addElement",
                    "element": {
                      "id": "sms",
                      "name": "SMS gateway",
                      "template": null,
                      "notes": "Send a text when a link passes 1000 clicks."
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "text": "No template sends SMS yet, so I added an element that needs a template."
        }
      ]
    }
  ]
}
