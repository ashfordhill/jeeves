{
  "version": 1,
  "title": "Fieldwork",
  "tagline": "A place for your inventory",
  "preset": "midnight",
  "pageSize": 10,
  "collections": [
    {
      "id": "warehouse",
      "name": "warehouse",
      "label": "Warehouses",
      "description": "Keep your places and inventory organized.",
      "fields": [
        {
          "id": "name",
          "name": "name",
          "type": "text",
          "required": true,
          "maxLength": 120,
          "label": "Name"
        },
        {
          "id": "website",
          "name": "website",
          "type": "http-url",
          "required": false,
          "label": "Website"
        }
      ],
      "relationships": [],
      "operations": ["create", "read", "list", "update"],
      "primaryField": "name",
      "columns": ["name", "website", "createdAt"],
      "singularLabel": "Warehouse"
    },
    {
      "id": "stock-item",
      "name": "stockItem",
      "label": "Stock items",
      "description": "Keep your places and inventory organized.",
      "fields": [
        {
          "id": "title",
          "name": "title",
          "type": "text",
          "required": true,
          "maxLength": 120,
          "label": "Title"
        },
        {
          "id": "quantity",
          "name": "quantity",
          "type": "integer",
          "required": true,
          "minimum": 0,
          "maximum": 1000000,
          "label": "Quantity"
        },
        {
          "id": "state",
          "name": "state",
          "type": "enum",
          "required": true,
          "values": ["available", "reserved"],
          "label": "Status"
        },
        {
          "id": "notes",
          "name": "notes",
          "type": "text",
          "required": false,
          "maxLength": 1000,
          "label": "Notes"
        },
        {
          "id": "recorded-at",
          "name": "recordedAt",
          "type": "timestamp",
          "generated": "created-at",
          "label": "Recorded at"
        }
      ],
      "relationships": [
        {
          "id": "warehouse",
          "name": "warehouseId",
          "label": "Warehouse",
          "target": "warehouse"
        }
      ],
      "operations": ["create", "read", "list", "update"],
      "primaryField": "title",
      "columns": ["title", "quantity", "state"],
      "singularLabel": "Stock item"
    }
  ]
}
