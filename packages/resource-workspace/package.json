{
  "name": "@jeeves/resource-workspace",
  "version": "0.1.0",
  "description": "Finite account and owner-resource workspace for deterministic Jeeves applications.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./definition": "./src/definition.ts",
    "./client": "./src/client.ts"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./styles.css": "./src/styles.css",
      "./definition": "./dist/definition.js",
      "./client": "./dist/client.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@jeeves/product-ui": "0.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@jeeves/product-ui": "workspace:0.3.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@jeeves/template-kit": "workspace:*"
  }
}
